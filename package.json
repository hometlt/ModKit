{
  "name": "@modkit/workspace-root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Modkit core workspace: protocol-neutral host, SDK, VFS and applications",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.tooling.json",
    "ts-strict:check": "node scripts/migration/check-ts-strict.mjs",
    "surfaces:check": "node scripts/migration/check-surfaces.mjs --scope m1-fixtures && node scripts/migration/check-surfaces.mjs --scope m7-foundation",
    "algorithms:check": "node scripts/migration/check-algorithms.mjs",
    "containers:check": "node scripts/check-containers.mjs --root extensions",
    "mk2-copy:check": "node scripts/migration/check-mk2-copy.mjs --family sc2 --scope m1-libs",
    "m1:check": "pnpm typecheck && pnpm ts-strict:check && pnpm test:migration-infra && pnpm test:legacy-kit && pnpm surfaces:check && pnpm migration:check && pnpm mk2-copy:check && pnpm check:legacy && pnpm check:imports && pnpm algorithms:check",
    "test:legacy-kit": "node --test packages/codec-kit/test/*.test.mjs",
    "test:migration-infra": "node --test scripts/migration/test/*.test.mjs",
    "port:brief": "node scripts/migration/scaffold-port-brief.mjs",
    "port:harness": "node scripts/migration/scaffold-parity-harness.mjs",
    "evidence:apply": "node scripts/migration/apply-port-evidence.mjs",
    "port:closure": "node scripts/migration/check-feature-ledger.mjs --closure sc2",
    "test": "pnpm test:full",
    "test:quick": "pnpm --filter @modkit/extension-manager test && vitest run --config vitest.quick.config.ts",
    "test:owner": "pnpm --filter @modkit/extension-manager test && vitest run --config vitest.owner.config.ts",
    "test:real": "vitest run --config vitest.real.config.ts",
    "test:full": "pnpm test:owner && pnpm test:real",
    "test:fast": "pnpm test:quick",
    "check:fast": "pnpm typecheck && pnpm test:fast",
    "skills:check": "node --test skills/inspect-sc2-resolved-data/test/skill.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "localization:emit": "pnpm --filter @modkit/ui localization:emit",
    "localization:check": "pnpm --filter @modkit/ui localization:check",
    "check:legacy": "node scripts/check-legacy.mjs",
    "check:imports": "node scripts/check-app-imports.mjs",
    "check:extensions": "node scripts/check-extension-inventory.mjs",
    "composition:check": "node scripts/check-external-composition.mjs",
    "licenses:check": "node scripts/check-license-policy.mjs",
    "convert:mk2": "node scripts/convert-mk2.mjs",
    "check:mk2": "node scripts/check-owner-receipts.mjs",
    "ports:check": "node scripts/check-mk2-ports.mjs",
    "migration:emit": "node scripts/migration/emit-inventory.mjs && node scripts/migration/emit-vscode-workflow-ledger.mjs && node scripts/migration/emit-parity-matrix.mjs && node scripts/migration/emit-surface-matrix.mjs",
    "migration:check": "node scripts/migration/emit-inventory.mjs --check && node scripts/migration/emit-surface-matrix.mjs --check && node scripts/migration/emit-vscode-workflow-ledger.mjs --check && node scripts/migration/check-package-owners.mjs && node scripts/check-owner-receipts.mjs && node scripts/migration/emit-status.mjs --check && node scripts/migration/emit-parity-matrix.mjs --check && node scripts/parity/check-receipt.mjs && node scripts/migration/check-registry.mjs && node scripts/migration/emit-codec-map.mjs --check && node scripts/migration/check-feature-ledger.mjs",
    "migration:check:history": "node scripts/migration/check-registry.mjs",
    "migration:report": "node scripts/migration/emit-status.mjs",
    "priority:emit": "node scripts/migration/emit-priority-scope.mjs",
    "priority:check": "node scripts/migration/emit-priority-scope.mjs --check",
    "profiles:check": "node scripts/migration/check-profiles.mjs",
    "owner-receipts:check": "node scripts/check-owner-receipts.mjs",
    "parity:legacy": "node scripts/migration/check-parity-legacy.mjs",
    "parity:owner:check": "node scripts/parity/check-receipt.mjs",
    "parity": "node scripts/parity/check.mjs",
    "catalogs:emit": "node scripts/emit-app-catalogs.mjs && node scripts/emit-web-catalog.mjs && node scripts/emit-vscode-catalog.mjs",
    "catalogs:check": "node scripts/emit-app-catalogs.mjs --check",
    "check": "pnpm build && pnpm ts-strict:check && pnpm test:migration-infra && pnpm test:legacy-kit && pnpm surfaces:check && pnpm mk2-copy:check && pnpm algorithms:check && pnpm bench:universal:gate && pnpm lint && pnpm format:check && pnpm test && pnpm evidence:check && pnpm specs:check && pnpm schemas:check && pnpm manifests:check && pnpm tokens:check && pnpm themes:check && pnpm icons:check && pnpm facilities:check && pnpm apps:check && pnpm check:legacy && pnpm check:imports && pnpm check:extensions && pnpm check:mk2 && pnpm ports:check && pnpm migration:check && pnpm priority:check --phase block-21 && pnpm profiles:check && pnpm bundle:graph:check && pnpm release:check && pnpm docs:conformance && pnpm skills:check && pnpm parity:legacy",
    "schemas:emit": "node scripts/emit-schemas.mjs",
    "schemas:check": "node scripts/emit-schemas.mjs --check",
    "specs:pin": "node scripts/specs-pin.mjs --emit",
    "specs:check": "node scripts/specs-pin.mjs --check",
    "facilities:emit": "node scripts/emit-host-facilities.mjs",
    "facilities:check": "node scripts/emit-host-facilities.mjs --check",
    "apps:check": "node scripts/check-apps.mjs",
    "debug:app": "node scripts/debug/app-runner.mjs",
    "debug:automation": "node scripts/debug/app-runner.mjs --app automation --stay-open",
    "debug:server": "node scripts/debug/app-runner.mjs --app server --stay-open",
    "debug:web:composition": "node scripts/debug/app-runner.mjs --app web --stay-open",
    "debug:electron:adapter": "node scripts/debug/app-runner.mjs --app electron --stay-open",
    "debug:vscode:adapter": "node scripts/debug/app-runner.mjs --app vscode --stay-open",
    "debug:cli": "node apps/cli/dist/main.js",
    "debug:mcp": "node apps/mcp/dist/main.js",
    "debug:lsp": "node apps/lsp/dist/main.js",
    "debug:pwa": "node scripts/debug/pwa-server.mjs",
    "mcp:start": "node apps/mcp/dist/main.js",
    "lsp:start": "node apps/lsp/dist/main.js",
    "manifests:check": "pnpm --filter @modkit/ui manifests:check",
    "bench": "node scripts/bench.mjs",
    "bench:gate": "node scripts/bench.mjs --gate",
    "bench:universal": "node --expose-gc scripts/bench/universal-data.mjs",
    "bench:universal:gate": "node --expose-gc scripts/bench/universal-data.mjs --gate",
    "bundle": "node scripts/bundle.mjs",
    "bundle:check": "node scripts/bundle.mjs --check",
    "bundle:graph": "node scripts/bundle-graph.mjs",
    "bundle:graph:check": "node scripts/bundle-graph.mjs --check",
    "release:emit": "node scripts/release/build-rc.mjs --emit",
    "release:check": "node scripts/release/build-rc.mjs --check",
    "release:rc": "node scripts/release/build-rc.mjs",
    "release:verify": "node scripts/release/build-rc.mjs --verify",
    "release:install": "node scripts/release/build-rc.mjs --install",
    "release:rollback": "node scripts/release/build-rc.mjs --rollback",
    "docs:conformance": "node scripts/docs-conformance.mjs",
    "evidence:emit": "node scripts/migration/emit-evidence.mjs",
    "evidence:check": "node scripts/migration/emit-evidence.mjs --check",
    "scaffold:extension": "node scripts/scaffold-extension.mjs",
    "build": "pnpm localization:check && pnpm catalogs:check && pnpm typecheck && pnpm catalogs:check:web && pnpm catalogs:check:vscode && pnpm bundle",
    "tokens:check": "pnpm --filter @modkit/ui tokens:check",
    "themes:check": "node scripts/check-themes.mjs",
    "icons:emit": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check",
    "presentation:check": "node scripts/check-extension-presentation.mjs",
    "catalogs:check:web": "node scripts/emit-web-catalog.mjs --check",
    "catalogs:check:vscode": "node scripts/emit-vscode-catalog.mjs --check"
  },
  "devDependencies": {
    "@modkit/code": "workspace:*",
    "@modkit/core": "workspace:*",
    "@modkit/extension-manager": "workspace:*",
    "@modkit/host": "workspace:*",
    "@modkit/scene": "workspace:*",
    "@modkit/sdk": "workspace:*",
    "@modkit/testkit": "workspace:*",
    "@modkit/ui": "workspace:*",
    "@modkit/uv": "workspace:*",
    "@modkit/vfs": "workspace:*",
    "@types/node": "^22.5.0",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  }
}
