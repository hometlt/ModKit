{
  "name": "@modkitx-x3/workspace-root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "MK3 clean-core lab (BRIEF-12); not a release; owner decision pending",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.tooling.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:legacy": "node scripts/check-legacy.mjs",
    "check:imports": "node scripts/check-app-imports.mjs",
    "check:extensions": "node scripts/check-extension-inventory.mjs",
    "convert:mk2": "node scripts/convert-mk2.mjs",
    "check:mk2": "node scripts/convert-mk2.mjs --check",
    "catalogs:emit": "node scripts/emit-app-catalogs.mjs",
    "catalogs:check": "node scripts/emit-app-catalogs.mjs --check",
    "check": "pnpm build && pnpm bench:universal:gate && pnpm lint && pnpm format:check && pnpm test && pnpm schemas:check && pnpm manifests:check && pnpm tokens:check && pnpm icons:check && pnpm facilities:check && pnpm apps:check && pnpm check:legacy && pnpm check:imports && pnpm check:extensions && pnpm check:mk2",
    "schemas:emit": "node scripts/emit-schemas.mjs",
    "schemas:check": "node scripts/emit-schemas.mjs --check",
    "facilities:emit": "node scripts/emit-host-facilities.mjs",
    "facilities:check": "node scripts/emit-host-facilities.mjs --check",
    "apps:check": "node scripts/check-apps.mjs",
    "debug:app": "node scripts/debug/app-runner.mjs",
    "debug:pwa": "node scripts/debug/pwa-server.mjs",
    "manifests:check": "pnpm --filter @modkitx-x3/ui manifests:check",
    "bench": "node scripts/bench.mjs",
    "bench:gate": "node scripts/bench.mjs --gate",
    "bench:universal": "node --expose-gc scripts/bench/universal-data.mjs",
    "bench:universal:gate": "node --expose-gc scripts/bench/universal-data.mjs --gate",
    "bundle": "node scripts/bundle.mjs",
    "bundle:check": "node scripts/bundle.mjs --check",
    "build": "pnpm catalogs:check && pnpm typecheck && pnpm bundle",
    "tokens:check": "pnpm --filter @modkitx-x3/ui tokens:check",
    "icons:emit": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/generate-icons.mjs --check"
  },
  "devDependencies": {
    "@modkitx-x3/core": "workspace:*",
    "@modkitx-x3/host": "workspace:*",
    "@modkitx-x3/sdk": "workspace:*",
    "@modkitx-x3/testkit": "workspace:*",
    "@modkitx-x3/ui": "workspace:*",
    "@modkitx-x3/vfs": "workspace:*",
    "@types/node": "^22.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.3.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  }
}
