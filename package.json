{
  "name": "@modkitx-x3/workspace-root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "MK3 clean-core lab (BRIEF-12); not a release; owner decision pending",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b && tsc -p tsconfig.tooling.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:legacy": "node scripts/check-legacy.mjs",
    "check": "pnpm build && pnpm lint && pnpm format:check && pnpm test && pnpm schemas:check && pnpm check:legacy",
    "schemas:emit": "node scripts/emit-schemas.mjs",
    "schemas:check": "node scripts/emit-schemas.mjs --check",
    "bench": "node scripts/bench.mjs",
    "bench:gate": "node scripts/bench.mjs --gate",
    "bundle": "node scripts/bundle.mjs",
    "bundle:check": "node scripts/bundle.mjs --check",
    "build": "pnpm typecheck && pnpm bundle"
  },
  "devDependencies": {
    "@modkitx-x3/core": "workspace:*",
    "@modkitx-x3/host": "workspace:*",
    "@modkitx-x3/sdk": "workspace:*",
    "@modkitx-x3/testkit": "workspace:*",
    "@modkitx-x3/vfs": "workspace:*",
    "@types/node": "^22.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vitest": "^2.0.5"
  }
}
