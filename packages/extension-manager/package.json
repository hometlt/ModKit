{
  "name": "@modkit/extension-manager",
  "version": "0.1.0",
  "description": "Protocol-neutral extension discovery, profiles, locks and VFS materialization for Modkit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.12.1",
  "bin": {
    "modkit-extensions": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./schemas/workspace": "./schemas/modkit.workspace.schema.json",
    "./schemas/repository": "./schemas/modkit.repository.schema.json",
    "./schemas/lock": "./schemas/modkit.extensions.lock.schema.json",
    "./schemas/composition": "./schemas/modkit.composition.schema.json",
    "./schemas/registry": "./schemas/modkit.registry.schema.json",
    "./schemas/game-support-plan": "./schemas/modkit.game-support-plan.schema.json",
    "./schemas/vendor-subject": "./schemas/modkit.vendor-subject.v1.schema.json",
    "./schemas/game-subject": "./schemas/modkit.game-subject.v1.schema.json"
  },
  "files": [
    "README.md",
    "schemas",
    "dist"
  ],
  "scripts": {
    "pack:standalone": "node ../../scripts/pack-first-party.mjs --package .",
    "test": "node --test",
    "check": "pnpm run typecheck && pnpm test",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modkit/codec-kit": "workspace:*",
    "@modkit/sdk": "workspace:*",
    "@modkit/vfs": "workspace:*"
  }
}
