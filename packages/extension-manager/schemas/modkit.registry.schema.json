{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modkit.dev/schemas/modkit.registry.schema.json",
  "title": "Modkit extension registry catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "generatedAt", "packages"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "registryId": { "$ref": "#/$defs/coordinate" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "coordinate": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*/[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "keyId": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "contentEncoding": "base64" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "uri", "trust"],
      "properties": {
        "kind": { "enum": ["repository", "bundle"] },
        "uri": { "type": "string", "minLength": 1 },
        "integrity": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "trust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["local-user", "signed"] },
            "signature": { "$ref": "#/$defs/signature" }
          }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "source", "extensions"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
        },
        "channel": { "enum": ["stable", "preview", "development"] },
        "source": { "$ref": "#/$defs/source" },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/coordinate" }
        },
        "hostApi": { "type": "string", "minLength": 1 },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "publisher", "displayName", "summary", "versions"],
      "properties": {
        "id": { "$ref": "#/$defs/coordinate" },
        "publisher": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "homepage": { "type": "string", "format": "uri" },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/version" }
        }
      }
    }
  }
}
