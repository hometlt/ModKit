{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modkit.dev/schemas/modkit.workspace.schema.json",
  "title": "Modkit extension workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "activeProfile": { "type": "string", "minLength": 1 },
    "lockFile": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "uri"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "uri": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "minLength": 1 },
          "descriptor": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sources": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "extensions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "locked": { "type": "boolean" }
        }
      }
    },
    "legacyPaths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prefix", "source"],
        "properties": {
          "prefix": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "source": { "type": "string", "minLength": 1 },
          "strip": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
