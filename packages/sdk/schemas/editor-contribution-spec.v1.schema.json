{
  "$id": "https://schemas.modkitx.org/x3/editor-contribution-spec.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "consumesDataSources": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "contract": {
                "enum": [
                  "common.view/text-data-source",
                  "common.view/byte-range-source",
                  "common.view/tree-data-source",
                  "common.view/table-data-source",
                  "common.view/transport-source",
                  "common.view/namespace-entry-source",
                  "common.view/raster-image-source",
                  "common.view/vector-scene-source",
                  "common.view/audio-media-source",
                  "common.view/video-media-source",
                  "common.view/model-scene-source",
                  "common.view/model-resource-refs-source",
                  "common.view/model-skeleton-source",
                  "common.view/model-animation-source",
                  "common.view/model-collision-source",
                  "common.view/model-material-source",
                  "common.view/model-socket-source",
                  "common.view/relation-graph-source",
                  "common.view/subject-facts-source",
                  "common.view/slide-deck-source"
                ]
              },
              "major": {
                "const": 1
              }
            },
            "required": [
              "contract",
              "major"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "contract": {
                "not": {
                  "enum": [
                    "common.view/text-data-source",
                    "common.view/byte-range-source",
                    "common.view/tree-data-source",
                    "common.view/table-data-source",
                    "common.view/transport-source",
                    "common.view/namespace-entry-source",
                    "common.view/raster-image-source",
                    "common.view/vector-scene-source",
                    "common.view/audio-media-source",
                    "common.view/video-media-source",
                    "common.view/model-scene-source",
                    "common.view/model-resource-refs-source",
                    "common.view/model-skeleton-source",
                    "common.view/model-animation-source",
                    "common.view/model-collision-source",
                    "common.view/model-material-source",
                    "common.view/model-socket-source",
                    "common.view/relation-graph-source",
                    "common.view/subject-facts-source",
                    "common.view/slide-deck-source"
                  ]
                },
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\/[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
                "type": "string"
              },
              "major": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "opaque": {
                "const": true
              }
            },
            "required": [
              "contract",
              "major",
              "opaque"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "hosts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "priority": {
      "type": "number"
    },
    "requiresOperations": {
      "items": {
        "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*|[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\/[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\.[a-z0-9]+(?:-[a-z0-9]+)*)$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "requiresTransactions": {
      "type": "boolean"
    },
    "scaleLimits": {
      "additionalProperties": false,
      "properties": {
        "maximumRows": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        "maximumSourceBytes": {
          "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]))$",
          "type": "string"
        },
        "maximumSubjects": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "selectionKinds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "semanticLocationKinds": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "sessionModel": {
      "enum": [
        "single-subject",
        "multi-subject",
        "workspace"
      ]
    },
    "writer": {
      "additionalProperties": false,
      "properties": {
        "formatId": {
          "minLength": 1,
          "type": "string"
        },
        "minimumRoundTrip": {
          "enum": [
            "byte-identical",
            "semantic",
            "lossy",
            "none"
          ]
        },
        "mutationMode": {
          "enum": [
            "export-only",
            "mutate"
          ]
        },
        "representationId": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "formatId",
        "representationId",
        "mutationMode",
        "minimumRoundTrip"
      ],
      "type": "object"
    }
  },
  "required": [
    "sessionModel",
    "selectionKinds",
    "semanticLocationKinds",
    "requiresTransactions",
    "requiresOperations",
    "consumesDataSources",
    "writer",
    "priority"
  ],
  "type": "object"
}
