{
  "$id": "https://schemas.modkit.org/x3/extension-manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contentSources": {
      "pattern": "^(?:\\./)?(?![A-Za-z]:)(?!\\\\)(?!.*\\\\)(?!.*\\u0000)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
      "type": "string"
    },
    "contributionManifests": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "credentials": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "audience": {
            "items": {
              "maxLength": 512,
              "pattern": "^https?://[^\\s]+$",
              "type": "string"
            },
            "maxItems": 16,
            "type": "array"
          },
          "environment": {
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$",
            "type": "string"
          },
          "header": {
            "pattern": "^[A-Za-z0-9-]{1,64}$",
            "type": "string"
          },
          "id": {
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "api-key",
              "oauth2-pkce",
              "provider-session",
              "symmetric-key"
            ]
          },
          "label": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "oauth": {
            "additionalProperties": false,
            "properties": {
              "authorizationEndpoint": {
                "maxLength": 512,
                "pattern": "^https?://[^\\s]+$",
                "type": "string"
              },
              "clientId": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "clientIdSetting": {
                "pattern": "^[A-Za-z0-9._-]{1,64}$",
                "type": "string"
              },
              "loopbackPort": {
                "maximum": 65535,
                "minimum": 1024,
                "type": "integer"
              },
              "revocationEndpoint": {
                "maxLength": 512,
                "pattern": "^https?://[^\\s]+$",
                "type": "string"
              },
              "tokenEndpoint": {
                "maxLength": 512,
                "pattern": "^https?://[^\\s]+$",
                "type": "string"
              }
            },
            "required": [
              "authorizationEndpoint",
              "tokenEndpoint"
            ],
            "type": "object"
          },
          "scoped": {
            "type": "boolean"
          },
          "scopes": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 32,
            "type": "array"
          }
        },
        "required": [
          "id",
          "kind",
          "label"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "type": "array"
    },
    "dependsOn": {
      "items": {
        "$id": "https://schemas.modkit.org/x3/extension-requirement.v1.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "extension": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\/[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
            "type": "string"
          },
          "mode": {
            "enum": [
              "required",
              "default",
              "suggested",
              "integrates"
            ]
          },
          "range": {
            "pattern": "^(?:\\*|x|(?:=?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)|(?:(?:0|[1-9]\\d*)\\.(?:x|\\*)|(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:x|\\*))|\\^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*))?|[<>]=?(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)){0,2})(?: (?:=?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)|(?:(?:0|[1-9]\\d*)\\.(?:x|\\*)|(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:x|\\*))|\\^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*))?|[<>]=?(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)){0,2}))*)$",
            "type": "string"
          },
          "scope": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "contribution",
                  "offer",
                  "operation",
                  "intent",
                  "variant",
                  "profile",
                  "projection",
                  "slot"
                ]
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "type": "object"
          }
        },
        "required": [
          "extension",
          "mode",
          "scope"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
      "type": "string"
    },
    "languageFiles": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "dialect": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "type": "string"
          },
          "extension": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "type": "string"
          },
          "languageId": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
            "type": "string"
          }
        },
        "required": [
          "extension",
          "languageId"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "type": "array"
    },
    "license": {
      "minLength": 1,
      "type": "string"
    },
    "presentation": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "displayName": {
          "minLength": 1,
          "type": "string"
        },
        "games": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "displayName": {
                "minLength": 1,
                "type": "string"
              },
              "id": {
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\/[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
                "type": "string"
              }
            },
            "required": [
              "id",
              "displayName"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "icon": {
          "additionalProperties": false,
          "properties": {
            "displayName": {
              "minLength": 1,
              "type": "string"
            },
            "mediaType": {
              "minLength": 1,
              "type": "string"
            },
            "path": {
              "pattern": "^(?:\\./)?(?![A-Za-z]:)(?!\\\\)(?!.*\\\\)(?!.*\\u0000)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        },
        "licenseFiles": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "displayName": {
                "minLength": 1,
                "type": "string"
              },
              "mediaType": {
                "minLength": 1,
                "type": "string"
              },
              "path": {
                "pattern": "^(?:\\./)?(?![A-Za-z]:)(?!\\\\)(?!.*\\\\)(?!.*\\u0000)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
                "type": "string"
              }
            },
            "required": [
              "path"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "source": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "root"
                },
                "root": {
                  "pattern": "^(?:\\./)?(?![A-Za-z]:)(?!\\\\)(?!.*\\\\)(?!.*\\u0000)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "root"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "url"
                },
                "url": {
                  "pattern": "^https?://[^\\s]+$",
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "url"
              ],
              "type": "object"
            }
          ]
        },
        "vendor": {
          "additionalProperties": false,
          "properties": {
            "displayName": {
              "minLength": 1,
              "type": "string"
            },
            "id": {
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
              "type": "string"
            }
          },
          "required": [
            "id",
            "displayName"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "publisher": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "publisher",
    "id",
    "version",
    "license",
    "contributionManifests"
  ],
  "type": "object"
}
