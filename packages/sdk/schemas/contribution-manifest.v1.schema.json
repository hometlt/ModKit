{
  "$id": "https://schemas.modkitx.org/x3/contribution-manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\/[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
          "type": "string"
        },
        "major": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "major"
      ],
      "type": "object"
    },
    "dependsOn": {
      "items": {
        "$id": "https://schemas.modkitx.org/x3/scoped-contract-requirement.v1.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "contract": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\/[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
            "type": "string"
          },
          "major": {
            "maximum": 9007199254740991,
            "minimum": 0,
            "type": "integer"
          },
          "mode": {
            "enum": [
              "required",
              "default",
              "suggested",
              "integrates"
            ]
          },
          "range": {
            "pattern": "^(?:\\*|x|(?:=?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)|(?:(?:0|[1-9]\\d*)\\.(?:x|\\*)|(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:x|\\*))|\\^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*))?|[<>]=?(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)){0,2})(?: (?:=?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)|(?:(?:0|[1-9]\\d*)\\.(?:x|\\*)|(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:x|\\*))|\\^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*))?|[<>]=?(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)){0,2}))*)$",
            "type": "string"
          },
          "scope": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "enum": [
                  "contribution",
                  "offer",
                  "operation",
                  "intent",
                  "variant",
                  "profile",
                  "projection",
                  "slot"
                ]
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "type": "object"
          }
        },
        "required": [
          "contract",
          "major",
          "mode",
          "scope"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "displayName": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\/[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
      "type": "string"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "runtimeVariants": {
      "items": {
        "$id": "https://schemas.modkitx.org/x3/runtime-variant-declaration.v1.schema.json",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "entrypoint": {
            "pattern": "^(?![a-zA-Z][a-zA-Z0-9+.-]*:)(?!/)(?!\\\\)(?:(?!\\.\\.(?:/|$))[^\\\\/\\u0000-\\u001f]+/)*(?!\\.\\.$)[^\\\\/\\u0000-\\u001f]+$",
            "type": "string"
          },
          "executionProfile": {
            "enum": [
              "browser-sandbox",
              "worker-brokered",
              "process-brokered",
              "wasm-brokered",
              "trusted-in-process",
              "remote-provider"
            ]
          },
          "requestedPermissionClasses": {
            "items": {
              "enum": [
                "read-source",
                "write-source",
                "filesystem-read",
                "filesystem-write",
                "network",
                "process-launch",
                "native-code",
                "credentials",
                "clipboard",
                "persistent-storage"
              ]
            },
            "type": "array"
          },
          "target": {
            "additionalProperties": false,
            "properties": {
              "architectures": {
                "items": {
                  "enum": [
                    "any",
                    "x86",
                    "x64",
                    "arm32",
                    "arm64",
                    "wasm32"
                  ]
                },
                "minItems": 1,
                "type": "array"
              },
              "environments": {
                "items": {
                  "enum": [
                    "browser-main",
                    "browser-worker",
                    "node",
                    "node-worker",
                    "wasm",
                    "native",
                    "external-tool"
                  ]
                },
                "minItems": 1,
                "type": "array"
              },
              "externalTools": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "operatingSystems": {
                "items": {
                  "enum": [
                    "any",
                    "windows",
                    "linux",
                    "darwin",
                    "android",
                    "ios"
                  ]
                },
                "minItems": 1,
                "type": "array"
              },
              "requiredHostCapabilities": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              },
              "requiredWebApis": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "variantId": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "variantId",
          "entrypoint",
          "target",
          "executionProfile",
          "requestedPermissionClasses"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schemaVersion": {
      "const": 1
    },
    "spec": {
      "title": "JsonValue"
    },
    "status": {
      "enum": [
        "supported",
        "partial",
        "unsupported",
        "experimental"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "contract",
    "id",
    "displayName",
    "spec"
  ],
  "type": "object"
}
