{
  "$id": "https://schemas.modkitx.org/x3/writer-requirement.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "formatId": {
      "minLength": 1,
      "type": "string"
    },
    "minimumRoundTrip": {
      "enum": [
        "byte-identical",
        "semantic",
        "lossy",
        "none"
      ]
    },
    "mutationMode": {
      "enum": [
        "export-only",
        "mutate"
      ]
    },
    "representationId": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "formatId",
    "representationId",
    "mutationMode",
    "minimumRoundTrip"
  ],
  "type": "object"
}
