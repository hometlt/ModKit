{
  "$id": "https://schemas.modkitx.org/x3/viewer-contribution-spec.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "applicability": {
      "additionalProperties": false,
      "properties": {
        "interpretation": {
          "enum": [
            "none",
            "codec",
            "any"
          ]
        },
        "longestLineBytes": {
          "additionalProperties": false,
          "properties": {
            "maximum": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            "whenUnknown": {
              "enum": [
                "eligible",
                "ineligible"
              ]
            }
          },
          "required": [
            "maximum",
            "whenUnknown"
          ],
          "type": "object"
        },
        "sourceBytes": {
          "additionalProperties": false,
          "properties": {
            "maximum": {
              "pattern": "^(?:0|[1-9][0-9]{0,18}|(?:18446744073709551615|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]))$",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "conflicts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "consumesDataSources": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "contract": {
                "enum": [
                  "common.view/text-data-source",
                  "common.view/byte-range-source",
                  "common.view/tree-data-source",
                  "common.view/table-data-source",
                  "common.view/transport-source",
                  "common.view/namespace-entry-source"
                ]
              },
              "major": {
                "const": 1
              }
            },
            "required": [
              "contract",
              "major"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "contract": {
                "not": {
                  "enum": [
                    "common.view/text-data-source",
                    "common.view/byte-range-source",
                    "common.view/tree-data-source",
                    "common.view/table-data-source",
                    "common.view/transport-source",
                    "common.view/namespace-entry-source"
                  ]
                },
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\/[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
                "type": "string"
              },
              "major": {
                "maximum": 9007199254740991,
                "minimum": 0,
                "type": "integer"
              },
              "opaque": {
                "const": true
              }
            },
            "required": [
              "contract",
              "major",
              "opaque"
            ],
            "type": "object"
          }
        ]
      },
      "type": "array"
    },
    "hosts": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "kind": {
      "enum": [
        "stage",
        "tree",
        "panel",
        "toolbar",
        "transport",
        "status",
        "fallback"
      ]
    },
    "priority": {
      "type": "number"
    },
    "requiresOperations": {
      "items": {
        "pattern": "^(?:[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*|[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\/[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*\\.[a-z0-9]+(?:-[a-z0-9]+)*)$",
        "type": "string"
      },
      "type": "array"
    },
    "requiresTraits": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "definitionRange": {
            "pattern": "^(?:\\*|x|(?:=?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)|(?:(?:0|[1-9]\\d*)\\.(?:x|\\*)|(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:x|\\*))|\\^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*))?|[<>]=?(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)){0,2})(?: (?:=?(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)|(?:(?:0|[1-9]\\d*)\\.(?:x|\\*)|(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:x|\\*))|\\^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*))?|[<>]=?(?:0|[1-9]\\d*)(?:\\.(?:0|[1-9]\\d*)){0,2}))*)$",
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
            "type": "string"
          },
          "states": {
            "items": {
              "enum": [
                "available",
                "partial",
                "disabled",
                "dependency-required"
              ]
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "singletonGroup": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "kind",
    "consumesDataSources",
    "priority"
  ],
  "type": "object"
}
