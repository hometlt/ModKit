{
  "name": "@modkitx-x3/sdk",
  "version": "0.1.0",
  "description": "MK3 clean-core lab: extension/contribution envelope, schemas, subjects (BRIEF-12; not a release)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest/validators.generated": {
      "types": "./dist/manifest/validators.generated.d.ts",
      "default": "./dist/manifest/validators.generated.js"
    },
    "./subjects": {
      "types": "./dist/subjects/index.d.ts",
      "default": "./dist/subjects/index.js"
    },
    "./authoring": {
      "types": "./dist/authoring/index.d.ts",
      "default": "./dist/authoring/index.js"
    },
    "./formats": {
      "types": "./dist/formats/index.d.ts",
      "default": "./dist/formats/index.js"
    },
    "./data-sources": {
      "types": "./dist/data-sources.d.ts",
      "default": "./dist/data-sources.js"
    },
    "./service-contracts": {
      "types": "./dist/service-contracts.d.ts",
      "default": "./dist/service-contracts.js"
    },
    "./language": {
      "types": "./dist/language/index.d.ts",
      "default": "./dist/language/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge/index.d.ts",
      "default": "./dist/knowledge/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "default": "./dist/templates/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./games": {
      "types": "./dist/games/index.d.ts",
      "default": "./dist/games/index.js"
    },
    "./mods": {
      "types": "./dist/mods/index.d.ts",
      "default": "./dist/mods/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./maps": {
      "types": "./dist/maps/index.d.ts",
      "default": "./dist/maps/index.js"
    },
    "./text-data": {
      "types": "./dist/text-data/index.d.ts",
      "default": "./dist/text-data/index.js"
    },
    "./editing": {
      "types": "./dist/editing.d.ts",
      "default": "./dist/editing.js"
    },
    "./ui-contracts": {
      "types": "./dist/ui-contracts/index.d.ts",
      "default": "./dist/ui-contracts/index.js"
    },
    "./schemas/*.schema.json": "./schemas/*.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "dependencies": {
    "@modkitx-x3/core": "workspace:*",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "json-schema-to-ts": "^3.1.1"
  }
}
