{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "modkit/world-uvw",
  "displayName": "Universal Verse World 1.0",
  "limitations": [
    "UVW 1.0 admits heightfield spaces only; connections and non-heightfield topologies remain reserved and fail explicitly.",
    "map.export-native resolves common.map/native-encoder by formatId; the UVW codec selects and checks the encoder and writes no game's map itself."
  ],
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./dist/world/codec.js",
      "target": {
        "environments": ["node"]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source", "write-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./dist/world/codec.js",
      "target": {
        "environments": ["browser-worker", "node-worker"]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source", "write-source"]
    }
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "uvw",
        "label": "Universal Verse World 1.0",
        "mediaType": "application/vnd.modkit.uvw+json; profile=uvw-1.0"
      }
    ],
    "roles": ["semantic"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "extensions": ["uvw", "uvw.json"],
      "mediaTypes": ["application/vnd.modkit.uvw+json; profile=uvw-1.0"]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 65536
        },
        {
          "from": "end",
          "length": 4096
        }
      ],
      "maxBytes": 69632
    },
    "representations": [
      {
        "id": "uvw-world",
        "contract": "common.view/world-scene-source",
        "major": 1,
        "stage": "runtime",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/world-scene-source",
        "major": 1
      },
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      },
      {
        "contract": "common.view/text-data-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      },
      {
        "id": "map.export-uvw",
        "handlerId": "export-canonical-uvw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      },
      {
        "id": "edit.field",
        "handlerId": "set-uvw-field",
        "mutatesSource": true,
        "requiredPermissions": ["read-source", "write-source"],
        "outputKinds": ["edit-plan"]
      },
      {
        "id": "edit.structure",
        "handlerId": "edit-uvw-document",
        "mutatesSource": true,
        "requiredPermissions": ["read-source", "write-source"],
        "outputKinds": ["edit-plan"]
      },
      {
        "id": "map.export-native",
        "handlerId": "export-uvw-native",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes", "json"]
      },
      {
        "id": "map.layers",
        "handlerId": "map-layers",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "map.layer-read",
        "handlerId": "map-layer-read",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "map.layer-write",
        "handlerId": "map-layer-write",
        "mutatesSource": true,
        "requiredPermissions": ["read-source", "write-source"],
        "outputKinds": ["edit-plan"]
      }
    ],
    "fidelityEvidence": [
      {
        "formatId": "uvw",
        "representationId": "uvw-world",
        "claim": {
          "roundTrip": "semantic",
          "preservesUnknownData": true,
          "notes": [
            "Writes serialize the whole document in canonical order; everything outside the edit survives (packages/host/test/uvw-edits.test.ts).",
            "The profile admits no unknown property: a document carrying one does not open as UVW, so no write can drop it."
          ]
        },
        "evidenceId": "uvw-canonical-edit-v1",
        "corpusId": "modkit/packages/host/test/uvw-edits.test.ts",
        "corpusDigest": "none:proof-suite",
        "conformanceProfile": "modkit/codec-contribution-v1",
        "optionsFingerprint": "options:none",
        "inputClass": "uvw-profile-1.0",
        "provenAt": "2026-09-26T00:00:00Z"
      }
    ],
    "traitDeclarations": [
      {
        "id": "structure.hierarchy",
        "representation": "runtime",
        "presence": "will-expose"
      }
    ],
    "implementationTier": {
      "claimed": 2
    },
    "budgets": {
      "maxInputBytes": "67108864",
      "maxDepth": 64,
      "maxNodes": 1000000,
      "maxScalarBytes": 134217728,
      "maxDiagnostics": 1000
    }
  }
}
