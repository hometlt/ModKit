{
  "schemaVersion": 1,
  "contract": {
    "id": "org.modkitx/codec-contribution",
    "major": 1
  },
  "id": "org.example/companion-optional",
  "displayName": "Companion sibling fixture (optional)",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./optional.mjs",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "spec": {
    "formatRefs": [
      { "formatId": "companion-optional", "label": "Companion sibling fixture (optional)" }
    ],
    "roles": ["semantic"],
    "sourceTopology": "bundle",
    "artifactStages": ["authored"],
    "openIntents": ["probe", "inspect", "full"],
    "match": { "extensions": ["vxl"] },
    "probe": {
      "kind": "bytes",
      "ranges": [{ "from": "start", "length": 16 }],
      "maxBytes": 16
    },
    "companions": [
      {
        "id": "motion",
        "role": "animation",
        "required": false,
        "patterns": ["*.hva"],
        "searchScopes": ["sibling-directory"]
      }
    ],
    "representations": [
      {
        "id": "companion-optional",
        "contract": "org.example/companion-optional",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [{ "contract": "common.view/byte-range-source", "major": 1 }],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      }
    ],
    "traitDeclarations": [
      { "id": "model.geometry", "representation": "source", "presence": "will-expose" },
      { "id": "model.animations", "representation": "source", "presence": "may-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "4096",
      "maxDepth": 8,
      "maxNodes": 64,
      "maxScalarBytes": 4096,
      "maxDiagnostics": 16
    }
  }
}
