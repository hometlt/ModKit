    "publishesDataSources": [{ "contract": "common.view/byte-range-source", "major": 1 }],
    "operations": [],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1024",
      "maxDepth": 8,
      "maxNodes": 8,
      "maxScalarBytes": 1024,
      "maxDiagnostics": 8
    }
  }
