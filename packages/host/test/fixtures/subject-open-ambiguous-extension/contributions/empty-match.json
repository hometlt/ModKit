    "roles": ["semantic"],
    "sourceTopology": "single",
    "artifactStages": ["authored"],
    "openIntents": ["probe", "full"],
    "match": {},
    "probe": {
      "kind": "bytes",
      "ranges": [{ "from": "start", "length": 4 }],
      "maxBytes": 4
