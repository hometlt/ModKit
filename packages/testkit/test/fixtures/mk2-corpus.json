      "contributionId": "org.modkitx/webp",
      "corpus": "real",
      "sample": "-references/website/crossover/uploads/kane.webp",
      "minimumConfidence": 0.9,
      "dataSource": "tree",
      "note": "RIFF/WEBP container: simple, no native decoder, VP8/VP8L/VP8X chunk walk"
    },
