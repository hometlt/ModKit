{
  "name": "@modkitx-x3/vfs",
  "version": "0.1.0",
  "description": "MK3 clean-core lab: portable VFS contracts with explicitly loaded providers (not a release)",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers/file": {
      "types": "./dist/providers/file/index.d.ts",
      "default": "./dist/providers/file/index.js"
    },
    "./providers/memory": {
      "types": "./dist/providers/memory/index.d.ts",
      "default": "./dist/providers/memory/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modkitx-x3/core": "workspace:*"
  }
}
