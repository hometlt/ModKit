    },
    "./ui-monaco": {
      "types": "./generated/ui-monaco.d.mts",
      "default": "./generated/ui-monaco.mjs"
    },
    "./vector": {
      "types": "./generated/vector.d.mts",
      "default": "./generated/vector.mjs"
    },
    "./video": {
      "types": "./generated/video.d.mts",
      "default": "./generated/video.mjs"
