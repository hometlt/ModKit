      "default": "./generated/archives.mjs"
    },
    "./audio": {
      "types": "./generated/audio.d.mts",
      "default": "./generated/audio.mjs"
    },
    "./documents": {
      "types": "./generated/documents.d.mts",
      "default": "./generated/documents.mjs"
    },
    "./images": {
      "types": "./generated/images.d.mts",
      "default": "./generated/images.mjs"
    },
    "./models": {
      "types": "./generated/models.d.mts",
      "default": "./generated/models.mjs"
    },
    "./text-delimited": {
      "types": "./generated/text-delimited.d.mts",
      "default": "./generated/text-delimited.mjs"
    },
    "./text-ini": {
      "types": "./generated/text-ini.d.mts",
