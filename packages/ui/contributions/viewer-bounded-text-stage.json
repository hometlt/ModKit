{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/viewer-contribution", "major": 1 },
  "id": "org.modkitx.ui/bounded-text-stage",
  "displayName": "bounded text stage",
  "runtimeVariants": [
    {
      "variantId": "browser",
      "entrypoint": "./dist/code/index.js",
      "target": { "environments": ["browser-main"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": []
    }
  ],
  "spec": {
    "kind": "stage",
    "requiresTraits": [{ "id": "content.text", "states": ["available"] }],
    "consumesDataSources": [{ "contract": "common.view/text-data-source", "major": 1 }],
    "applicability": {
      "interpretation": "any",
      "sourceBytes": { "maximum": "16777216" },
      "longestLineBytes": { "maximum": 1048576, "whenUnknown": "ineligible" }
    },
    "priority": 220,
    "singletonGroup": "center-stage"
  }
}
