{
  "name": "@modkit/ui",
  "version": "0.1.0",
  "description": "Format-neutral MK3 browser viewers over typed data-source leases.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./content-sources": {
      "types": "./dist/content-sources/index.d.ts",
      "default": "./dist/content-sources/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./viewer": {
      "types": "./dist/viewer/index.d.ts",
      "default": "./dist/viewer/index.js"
    },
    "./world": {
      "types": "./dist/world/index.d.ts",
      "default": "./dist/world/index.js"
    },
    "./composition": {
      "types": "./dist/composition/index.d.ts",
      "default": "./dist/composition/index.js"
    },
    "./localization": {
      "types": "./dist/localization/index.d.ts",
      "default": "./dist/localization/index.js"
    },
    "./code": {
      "types": "./dist/code/index.d.ts",
      "default": "./dist/code/index.js"
    },
    "./text-virtual": {
      "types": "./dist/text-virtual/index.d.ts",
      "default": "./dist/text-virtual/index.js"
    },
    "./hex": {
      "types": "./dist/hex/index.d.ts",
      "default": "./dist/hex/index.js"
    },
    "./tree": {
      "types": "./dist/tree/index.d.ts",
      "default": "./dist/tree/index.js"
    },
    "./table": {
      "types": "./dist/table/index.d.ts",
      "default": "./dist/table/index.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport/index.js"
    },
    "./namespace": {
      "types": "./dist/namespace/index.d.ts",
      "default": "./dist/namespace/index.js"
    },
    "./panels": {
      "types": "./dist/panels/index.d.ts",
      "default": "./dist/panels/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./package.json": "./package.json",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "default": "./dist/tokens/index.js"
    },
    "./styles/modkit-ui.css": "./styles/modkit-ui.css",
    "./search": {
      "types": "./dist/search/matcher.d.ts",
      "default": "./dist/search/matcher.js"
    },
    "./primitives": {
      "types": "./dist/primitives/search-field.d.ts",
      "default": "./dist/primitives/search-field.js"
    },
    "./metadata": {
      "types": "./dist/metadata/index.d.ts",
      "default": "./dist/metadata/index.js"
    },
    "./image": {
      "types": "./dist/image/index.d.ts",
      "default": "./dist/image/index.js"
    },
    "./audio": {
      "types": "./dist/audio/index.d.ts",
      "default": "./dist/audio/index.js"
    },
    "./vector": {
      "types": "./dist/vector/index.d.ts",
      "default": "./dist/vector/index.js"
    },
    "./archive": {
      "types": "./dist/archive/index.d.ts",
      "default": "./dist/archive/index.js"
    },
    "./video": {
      "types": "./dist/video/index.d.ts",
      "default": "./dist/video/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./shell": {
      "types": "./dist/shell/chrome.d.ts",
      "default": "./dist/shell/chrome.js"
    },
    "./media-shell": {
      "types": "./dist/media-shell/index.d.ts",
      "default": "./dist/media-shell/index.js"
    },
    "./filter": {
      "types": "./dist/filter/index.d.ts",
      "default": "./dist/filter/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./image-editing": {
      "types": "./dist/image-editing/index.d.ts",
      "default": "./dist/image-editing/index.js"
    },
    "./card": {
      "types": "./dist/card/index.d.ts",
      "default": "./dist/card/index.js"
    },
    "./calculations": {
      "types": "./dist/calculations/index.d.ts",
      "default": "./dist/calculations/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "default": "./dist/graph/index.js"
    },
    "./map-layers": {
      "types": "./dist/map-layers/index.d.ts",
      "default": "./dist/map-layers/index.js"
    },
    "./export": {
      "types": "./dist/export/index.d.ts",
      "default": "./dist/export/index.js"
    },
    "./template": {
      "types": "./dist/template/index.d.ts",
      "default": "./dist/template/index.js"
    },
    "./workbench": {
      "types": "./dist/workbench/index.d.ts",
      "default": "./dist/workbench/index.js"
    },
    "./settings": {
      "types": "./dist/settings/index.d.ts",
      "default": "./dist/settings/index.js"
    },
    "./explorer": {
      "types": "./dist/explorer/index.d.ts",
      "default": "./dist/explorer/index.js"
    },
    "./hex-editor": {
      "types": "./dist/hex-editor/index.d.ts",
      "default": "./dist/hex-editor/index.js"
    },
    "./field-editor": {
      "types": "./dist/field-editor/index.d.ts",
      "default": "./dist/field-editor/index.js"
    },
    "./selector": {
      "types": "./dist/selector/index.d.ts",
      "default": "./dist/selector/index.js"
    },
    "./media": {
      "types": "./dist/media/encoded.d.ts",
      "default": "./dist/media/encoded.js"
    },
    "./toolbar": {
      "types": "./dist/toolbar/index.d.ts",
      "default": "./dist/toolbar/index.js"
    }
  },
  "files": [
    "assets",
    "contributions",
    "dist",
    "generated",
    "styles"
  ],
  "scripts": {
    "localization:emit": "node scripts/generate-localization-fallbacks.mjs",
    "localization:check": "node scripts/generate-localization-fallbacks.mjs --check",
    "manifests:emit": "node scripts/generate-manifests.mjs",
    "manifests:check": "node scripts/generate-manifests.mjs --check",
    "tokens:emit": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@modkit/codec-kit": "workspace:*",
    "@modkit/scene": "workspace:*",
    "@modkit/core": "workspace:*",
    "@modkit/sdk": "workspace:*"
  },
  "sideEffects": false
}
