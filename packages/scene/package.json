{
  "name": "@modkit/scene",
  "version": "1.0.0",
  "description": "Built-in Modkit scene rendering and 3D relation-graph module.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./model/matrix": {
      "types": "./dist/model/billboard-math.d.ts",
      "default": "./dist/model/billboard-math.js"
    },
    "./world": {
      "types": "./dist/world/index.d.ts",
      "default": "./dist/world/index.js"
    },
    "./materials": {
      "types": "./dist/materials/index.d.ts",
      "default": "./dist/materials/index.js"
    },
    "./materials/webgl": {
      "types": "./dist/materials/webgl.d.ts",
      "default": "./dist/materials/webgl.js"
    },
    "./uvm": {
      "types": "./dist/uvm/index.d.ts",
      "default": "./dist/uvm/index.js"
    },
    "./relations/contracts": {
      "types": "./dist/relations/contracts.d.ts",
      "default": "./dist/relations/contracts.js"
    },
    "./render/browser": {
      "types": "./dist/render/browser.d.ts",
      "default": "./dist/render/browser.js"
    },
    "./render/headless": {
      "types": "./dist/render/headless.d.ts",
      "default": "./dist/render/headless.js"
    },
    "./output/png": {
      "types": "./dist/output/png.d.ts",
      "default": "./dist/output/png.js"
    },
    "./relations": {
      "types": "./dist/relations/index.d.ts",
      "default": "./dist/relations/index.js"
    },
    "./relations/three": {
      "types": "./dist/relations/three-graph-renderer.d.ts",
      "default": "./dist/relations/three-graph-renderer.js"
    },
    "./package.json": "./package.json",
    "./uvm/rig-bounds": {
      "types": "./dist/uvm/rig-bounds.d.ts",
      "default": "./dist/uvm/rig-bounds.js"
    },
    "./uvm/rig-model": {
      "types": "./dist/uvm/rig-model.d.ts",
      "default": "./dist/uvm/rig-model.js"
    },
    "./uvm/static-model": {
      "types": "./dist/uvm/static-model.d.ts",
      "default": "./dist/uvm/static-model.js"
