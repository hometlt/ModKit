      "types": "./dist/uvm/model.d.ts",
      "default": "./dist/uvm/model.js"
    },
    "./uvm/frame": {
      "types": "./dist/uvm/frame.d.ts",
      "default": "./dist/uvm/frame.js"
    },
    "./uvm/sockets": {
      "types": "./dist/uvm/sockets.d.ts",
      "default": "./dist/uvm/sockets.js"
    },
    "./uvm/facets": {
      "types": "./dist/uvm/facets.d.ts",
      "default": "./dist/uvm/facets.js"
    },
    "./uvm/collisions": {
      "types": "./dist/uvm/collisions.d.ts",
      "default": "./dist/uvm/collisions.js"
    },
    "./uvm/collision-overlay": {
      "types": "./dist/uvm/collision-overlay.d.ts",
      "default": "./dist/uvm/collision-overlay.js"
    },
    "./uvm/inspection": {
      "types": "./dist/uvm/inspection.d.ts",
      "default": "./dist/uvm/inspection.js"
    },
    "./uvm/cameras": {
      "types": "./dist/uvm/cameras.d.ts",
      "default": "./dist/uvm/cameras.js"
    },
    "./uvm/billboards": {
      "types": "./dist/uvm/billboards.d.ts",
      "default": "./dist/uvm/billboards.js"
    },
    "./uvm/model-states": {
      "types": "./dist/uvm/model-states.d.ts",
      "default": "./dist/uvm/model-states.js"
    },
    "./uvm/shadow-meshes": {
      "types": "./dist/uvm/shadow-meshes.d.ts",
      "default": "./dist/uvm/shadow-meshes.js"
    },
    "./uvm/ordered-euler-chains": {
      "types": "./dist/uvm/ordered-euler-chains.d.ts",
      "default": "./dist/uvm/ordered-euler-chains.js"
    },
    "./uvm/render": {
      "types": "./dist/uvm/render.d.ts",
      "default": "./dist/uvm/render.js"
    },
    "./uvm/images": {
      "types": "./dist/uvm/images.d.ts",
      "default": "./dist/uvm/images.js"
    },
    "./uvm/normals": {
      "types": "./dist/uvm/normals.d.ts",
      "default": "./dist/uvm/normals.js"
    }
  },
  "files": [
    "contributions",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "node --import ./scripts/test-typescript.mjs --test test/*.test.js",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@modkit/core": "workspace:*",
    "@modkit/host": "workspace:*",
    "@modkit/sdk": "workspace:*",
    "three": "^0.180.0",
    "@modkit/codec-kit": "workspace:*",
    "@modkit/uv": "workspace:*"
  },
  "sideEffects": false
}
