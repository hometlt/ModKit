{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/plain-text",
  "displayName": "Plain text",
  "runtimeVariants": [
    {
      "variantId": "browser-main",
      "entrypoint": "./src/entrypoint.js",
      "target": { "environments": ["browser-main"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "browser-worker",
      "entrypoint": "./src/entrypoint.js",
      "target": { "environments": ["browser-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "node",
      "entrypoint": "./src/entrypoint.js",
      "target": { "environments": ["node"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "node-worker",
      "entrypoint": "./src/entrypoint.js",
      "target": { "environments": ["node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "spec": {
    "formatRefs": [{ "formatId": "plain-text", "label": "Plain text", "mediaType": "text/plain" }],
    "roles": ["semantic"],
    "sourceTopology": "single",
    "artifactStages": ["authored"],
    "openIntents": ["probe", "inspect", "full", "stream", "export"],
    "match": { "extensions": ["txt", "log", "md", "text"], "mediaTypes": ["text/plain"] },
    "probe": {
      "kind": "bytes",
      "ranges": [{ "from": "start", "length": 4096 }],
      "maxBytes": 4096
    },
    "representations": [
      {
        "id": "source-text",
        "contract": "org.modkitx/plain-text-representation",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/text-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "asset.search",
        "handlerId": "search",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "traitDeclarations": [
      { "id": "content.text", "representation": "source", "presence": "will-expose" },
      { "id": "content.binary", "representation": "source", "presence": "will-expose" },
      { "id": "content.metadata", "representation": "source", "presence": "will-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "268435456",
      "maxDepth": 4,
      "maxNodes": 1000000,
      "maxScalarBytes": 16777216,
      "maxDiagnostics": 1000
    }
  }
}
