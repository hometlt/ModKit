  "configuration": {
    "title": "Modkit MK3",
    "properties": {
      "modkit.extensions": {
        "type": "array",
        "default": [],
        "markdownDescription": "Extension directories to load beside the ones that ship with this build. Each item is either a path, or an object with `path`, an optional `id` the directory is expected to declare, and an optional `enabled` flag. Directories named here are loaded as installed artifacts and never run in the extension host process.",
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          ]
        }
      },
      "modkit.disabledContributions": {
        "type": "array",
        "default": [],
        "markdownDescription": "Contribution ids to switch off, one level below `modkit.extensions`: an extension may ship several codecs and you may want only some of them. A disabled contribution stays in the inventory and loses activation, so a file only it could read opens as raw bytes with the diagnostic `x3.host/contribution-disabled` — and the switch is still there to turn it back on. Takes effect when the window reloads.",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "customEditors": [
    {
      "viewType": "modkit.genericAssetPreview",
      "displayName": "Modkit Asset Preview",
      "selector": [
        {
          "filenamePattern": "*"
        }
      ],
      "priority": "option"
    }
  ],
  "languages": [
    {
      "id": "galaxy",
      "aliases": ["SC2 Galaxy Script", "galaxy"],
      "extensions": [".galaxy"]
    },
    {
      "id": "ini",
      "aliases": ["SC2 Hotkeys", "ini"],
      "extensions": [".SC2Hotkeys", ".sc2hotkeys"]
    },
    {
      "id": "sc2layout",
      "aliases": ["SC2 Layout", "sc2layout"],
      "extensions": [".SC2Layout", ".sc2layout"]
    },
    {
      "id": "sc2strings",
      "aliases": ["SC2 Localized Strings", "sc2strings"],
      "filenamePatterns": ["**/LocalizedData/**/*.txt", "**/localizeddata/**/*.txt"]
    },
    {
      "id": "sc2style",
      "aliases": ["SC2 Style", "sc2style"],
      "extensions": [".SC2Style", ".sc2style"]
    },
    {
      "id": "xml",
      "aliases": ["SC2 XML", "xml"],
      "extensions": [".SC2Lighting", ".sc2lighting"],
      "filenames": ["Attributes", "Objects", "Regions"]
    }
  ],
  "viewsContainers": {
    "activitybar": [
      {
        "id": "modkit",
        "title": "Modkit",
        "icon": "media/icon-128.png"
      }
    ]
  },
  "views": {
    "modkit": [
      {
        "id": "modkit.host",
        "name": "Host"
      },
      {
        "id": "modkit.extensions",
        "name": "Extensions"
      }
    ]
  },
  "fileSystemSchemes": ["modkit-container"]
}
