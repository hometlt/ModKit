{
  "schemaVersion": 1,
  "contract": { "id": "modkit/codec-contribution", "major": 1 },
  "id": "modkit/audio-mp3",
  "displayName": "MP3 audio",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/mp3/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source", "write-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/mp3/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source", "write-source"]
    }
  ],
  "spec": {
    "formatRefs": [{ "formatId": "mp3", "label": "MP3 audio", "mediaType": "audio/mpeg" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled"],
    "openIntents": ["probe", "inspect", "full", "stream", "export"],
    "match": { "extensions": ["mp3"], "mediaTypes": ["audio/mpeg"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 8192 }], "maxBytes": 8192 },
    "representations": [
      {
        "id": "audio-stream-metadata",
        "contract": "common.audio/stream-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/audio-media-source", "major": 1 },
      { "contract": "common.view/transport-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      },
      {
        "id": "media.play-pause",
        "handlerId": "transport-play-pause",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "media.seek",
        "handlerId": "transport-seek",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "media.set-rate",
        "handlerId": "transport-set-rate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "media.select-track",
        "handlerId": "transport-select-track",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "edit.field",
        "handlerId": "set-text-frame",
        "mutatesSource": true,
        "requiredPermissions": ["read-source", "write-source"],
        "inputSchema": {
          "$ref": "modkit://audio-mp3/edit-field.v1",
          "document": {
            "schemaVersion": 1,
            "forms": [
              {
                "id": "mp3-set-text-frame",
                "label": "Set an ID3v2 text frame",
                "summary": "Sets or replaces one ID3v2 text frame, creating the tag when absent; audio bytes stay in place.",
                "binding": { "groupId": "id3" },
                "fields": [
                  {
                    "key": "key",
                    "label": "Frame",
                    "type": { "kind": "text", "pattern": "^T[A-Z0-9]{3}$", "maxLength": 4 },
                    "inputPath": ["key"],
                    "required": true,
                    "initial": "TIT2",
                    "source": "entry-key",
                    "description": "A four-character ID3v2 text frame id"
                  },
                  {
                    "key": "value",
                    "label": "Text",
                    "type": { "kind": "text" },
                    "inputPath": ["value"],
                    "initial": "set from the Modkit inspector",
                    "source": "entry-value"
                  }
                ]
              }
            ]
          }
        },
        "outputKinds": ["edit-plan"]
      }
    ],
    "traitDeclarations": [
      { "id": "audio.streams", "representation": "source", "presence": "will-expose" },
      { "id": "media.duration", "representation": "source", "presence": "will-expose" },
      { "id": "media.seekable", "representation": "source", "presence": "will-expose" },
      { "id": "content.binary", "representation": "source", "presence": "will-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
