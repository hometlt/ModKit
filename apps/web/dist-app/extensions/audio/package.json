{
  "name": "modkit-extension-x3-audio",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Isolated MK3 audio codecs.",
  "exports": {
    ".": "./src/index.js",
    "./formats/mp3/codec": "./src/formats/mp3/codec.js",
    "./formats/ogg/codec": "./src/formats/ogg/codec.js",
    "./formats/*/codec": "./src/formats/*/codec.js",
    "./package.json": "./package.json"
  },
  "files": [
    "contributions",
    "src",
    "README.md"
  ],
  "modkit": {
    "schemaVersion": 1,
    "publisher": "org.modkitx",
    "id": "audio",
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "dependencies": {
    "@modkitx-x3/codec-kit": "workspace:*"
  },
  "peerDependencies": {
    "@modkitx-x3/host": "workspace:*",
    "@modkitx-x3/sdk": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@modkitx-x3/host": {
      "optional": true
    },
    "@modkitx-x3/sdk": {
      "optional": true
    }
  }
}
