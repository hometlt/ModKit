{
  "schemaVersion": 1,
  "contract": { "id": "modkit/codec-contribution", "major": 1 },
  "id": "modkit/video-mp4",
  "displayName": "MPEG-4 media",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/mp4/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/mp4/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "spec": {
    "formatRefs": [{ "formatId": "mp4", "label": "MPEG-4 media", "mediaType": "video/mp4" }],
    "roles": ["media", "container"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "stream", "thumbnail", "full", "export"],
    "match": {
      "extensions": ["mp4", "m4v", "mov"],
      "mediaTypes": ["video/mp4", "video/quicktime"]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "video-container",
        "contract": "common.video/container-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/video-media-source", "major": 1 },
      { "contract": "common.view/transport-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      },
      {
        "id": "media.play-pause",
        "handlerId": "transport-play-pause",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "media.seek",
        "handlerId": "transport-seek",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "media.set-rate",
        "handlerId": "transport-set-rate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "media.select-track",
        "handlerId": "transport-select-track",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      }
    ],
    "traitDeclarations": [
      { "id": "video.streams", "representation": "source", "presence": "will-expose" },
      { "id": "video.tracks", "representation": "source", "presence": "will-expose" },
      { "id": "media.duration", "representation": "source", "presence": "may-expose" },
      { "id": "media.seekable", "representation": "source", "presence": "will-expose" },
      { "id": "content.binary", "representation": "source", "presence": "will-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "8589934592",
      "maxDepth": 64,
      "maxNodes": 1000000,
      "maxScalarBytes": 268435456,
      "maxDiagnostics": 1000
    }
  }
}
