{
  "schemaVersion": 1,
  "contract": {
    "id": "org.modkitx/codec-contribution",
    "major": 1
  },
  "id": "org.modkitx/text-xml",
  "displayName": "XML text data",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/xml/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/xml/codec.js",
      "target": {
        "environments": ["browser-worker", "node-worker"]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "xml",
        "label": "XML",
        "mediaType": "application/xml"
      }
    ],
    "roles": ["semantic"],
    "sourceTopology": "single",
    "artifactStages": ["authored"],
    "openIntents": ["probe", "inspect", "full", "stream", "export"],
    "match": {
      "extensions": ["xml"],
      "mediaTypes": ["application/xml"]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 8192
        }
      ],
      "maxBytes": 8192
    },
    "requires": [
      {
        "contract": "common.text-data/xml-syntax",
        "major": 1,
        "range": "^1.0.0"
      }
    ],
    "representations": [
      {
        "id": "syntax-document",
        "contract": "common.text-data/xml-document",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/text-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "asset.search",
        "handlerId": "search",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      },
      {
        "id": "data.parse",
        "handlerId": "parse",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "data.serialize",
        "handlerId": "serialize",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "traitDeclarations": [
      {
        "id": "structure.hierarchy",
        "representation": "source",
        "presence": "will-expose"
      },
      {
        "id": "content.text",
        "representation": "source",
        "presence": "will-expose"
      },
      {
        "id": "content.binary",
        "representation": "source",
        "presence": "will-expose"
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 256,
      "maxNodes": 1000000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 10000
    }
  }
}
