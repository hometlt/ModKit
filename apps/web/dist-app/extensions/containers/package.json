{
  "name": "modkit-extension-x3-containers",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Product-owned multi-file container codecs for MK3.",
  "exports": {
    "./linked": "./src/linked.js",
    "./package.json": "./package.json"
  },
  "files": [
    "contributions",
    "src",
    "README.md"
  ],
  "modkit": {
    "schemaVersion": 1,
    "publisher": "org.modkitx",
    "id": "containers",
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "dependencies": {
    "@modkitx-x3/codec-kit": "workspace:*"
  },
  "peerDependencies": {
    "@modkitx-x3/host": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@modkitx-x3/host": {
      "optional": true
    }
  }
}
