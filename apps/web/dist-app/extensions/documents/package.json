{
  "name": "modkit-extension-documents",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Isolated MK3 document codecs.",
  "exports": {
    ".": "./src/index.js",
    "./linked": "./src/linked.js",
    "./formats/markdown/codec": "./src/markdown/codec.js",
    "./formats/odg/codec": "./src/odg/codec.js",
    "./odp/codec": "./src/odp/codec.js",
    "./ods/codec": "./src/ods/codec.js",
    "./odt/codec": "./src/odt/codec.js",
    "./rtf/codec": "./src/rtf/codec.js",
    "./formats/*/codec": "./src/*/codec.js",
    "./package.json": "./package.json"
  },
  "files": [
    "contributions",
    "src",
    "README.md"
  ],
  "modkit": {
    "schemaVersion": 1,
    "publisher": "modkit",
    "id": "documents",
    "presentation": {
      "displayName": "Modkit Documents",
      "description": "Isolated MK3 document codecs.",
      "vendor": {
        "id": "modkit",
        "displayName": "Modkit"
      }
    },
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "dependencies": {
    "@modkit/codec-kit": "workspace:*"
  },
  "peerDependencies": {
    "@modkit/host": "workspace:*",
    "@modkit/sdk": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@modkit/host": {
      "optional": true
    },
    "@modkit/sdk": {
      "optional": true
    }
  }
}
