{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "modkit/archive-zip",
  "displayName": "ZIP archive",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/zip/codec.js",
      "target": {
        "environments": ["node"]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source", "write-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/zip/codec.js",
      "target": {
        "environments": ["browser-worker", "node-worker"]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source", "write-source"]
    }
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "zip",
        "label": "ZIP archive",
        "mediaType": "application/zip"
      }
    ],
    "roles": ["container"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "extensions": ["zip"],
      "mediaTypes": ["application/zip"],
      "signatures": [
        {
          "from": "start",
          "offset": 0,
          "bytesHex": "504b0304"
        },
        {
          "from": "end",
          "offset": 22,
          "bytesHex": "504b0506"
        }
      ]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 4
        }
      ],
      "maxBytes": 4
    },
    "representations": [
      {
        "id": "archive-namespace",
        "contract": "common.archive/zip-namespace",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/namespace-entry-source",
        "major": 1
      },
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      },
      {
        "id": "container.extract",
        "handlerId": "extract-entry",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      },
      {
        "id": "edit.structure",
        "handlerId": "edit-structure",
        "mutatesSource": true,
        "requiredPermissions": ["read-source", "write-source"],
        "inputSchema": {
          "$ref": "modkit://archive-zip/edit-structure.v1",
          "document": {
            "schemaVersion": 1,
            "forms": [
              {
                "id": "zip-add-entry",
                "label": "Add an entry to the archive",
                "summary": "Adds one stored entry and repacks; kept entries retain their bytes.",
                "fields": [
                  {
                    "key": "path",
                    "label": "Entry path",
                    "type": {
                      "kind": "path"
                    },
                    "inputPath": ["add", 0, "path"],
                    "required": true,
                    "initial": "added/hello.txt"
                  },
                  {
                    "key": "content",
                    "label": "Contents",
                    "type": {
                      "kind": "text"
                    },
                    "inputPath": ["add", 0, "bytes"],
                    "initial": "added from the Modkit inspector",
                    "encoding": "utf8-base64"
                  }
                ]
              },
              {
                "id": "zip-remove-entry",
                "label": "Remove an entry from the archive",
                "summary": "Removes one entry and repacks; other entries retain their bytes.",
                "fields": [
                  {
                    "key": "path",
                    "label": "Entry path",
                    "type": {
                      "kind": "path"
                    },
                    "inputPath": ["remove", 0],
                    "required": true,
                    "initial": "readme.txt"
                  }
                ]
              },
              {
                "id": "zip-rename-entry",
                "label": "Rename an entry in the archive",
                "summary": "Renames one entry without touching its payload or compression.",
                "fields": [
                  {
                    "key": "from",
                    "label": "From",
                    "type": {
                      "kind": "path"
                    },
                    "inputPath": ["rename", 0, "from"],
                    "required": true,
                    "initial": "readme.txt"
                  },
                  {
                    "key": "to",
                    "label": "To",
                    "type": {
                      "kind": "path"
                    },
                    "inputPath": ["rename", 0, "to"],
                    "required": true,
                    "initial": "docs/readme.txt"
                  }
                ]
              }
            ]
          }
        },
        "outputKinds": ["edit-plan"]
      },
      {
        "id": "edit.content",
        "handlerId": "edit-content",
        "mutatesSource": true,
        "requiredPermissions": ["read-source", "write-source"],
        "inputSchema": {
          "$ref": "modkit://archive-zip/edit-content.v1",
          "document": {
            "schemaVersion": 1,
            "forms": [
              {
                "id": "zip-replace-entry",
                "label": "Replace an entry's contents",
                "summary": "Replaces one file entry's payload; nothing else moves.",
                "fields": [
                  {
                    "key": "path",
                    "label": "Entry path",
                    "type": {
                      "kind": "path"
                    },
                    "inputPath": ["path"],
                    "required": true,
                    "initial": "readme.txt"
                  },
                  {
                    "key": "content",
                    "label": "Contents",
                    "type": {
                      "kind": "text"
                    },
                    "inputPath": ["bytes"],
                    "initial": "replaced from the Modkit inspector",
                    "encoding": "utf8-base64"
                  }
                ]
              }
            ]
          }
        },
        "outputKinds": ["edit-plan"]
      },
      {
        "id": "container.pack",
        "handlerId": "container-pack",
        "mutatesSource": true,
        "requiredPermissions": ["read-source", "write-source"],
        "outputKinds": ["edit-plan"]
      }
    ],
    "traitDeclarations": [
      {
        "id": "container.entries",
        "representation": "source",
        "presence": "will-expose"
      },
      {
        "id": "container.directories",
        "representation": "source",
        "presence": "will-expose"
      },
      {
        "id": "container.compression",
        "representation": "source",
        "presence": "will-expose"
      },
      {
        "id": "content.binary",
        "representation": "source",
        "presence": "will-expose"
      }
    ],
    "fidelityEvidence": [
      {
        "formatId": "zip",
        "representationId": "archive-namespace",
        "claim": {
          "roundTrip": "semantic",
          "preservesUnknownData": true
        },
        "evidenceId": "zip-verbatim-reassembly-v1",
        "corpusId": "modkit/packages/host/test/archive-edits.test.ts",
        "corpusDigest": "none:proof-suite",
        "conformanceProfile": "modkit/codec-contribution-v1",
        "optionsFingerprint": "options:stored-additions",
        "inputClass": "zip-classic",
        "provenAt": "2026-08-19T00:00:00Z"
      },
      {
        "formatId": "zip",
        "representationId": "archive-namespace",
        "claim": {
          "roundTrip": "semantic",
          "preservesUnknownData": false
        },
        "evidenceId": "zip-verbatim-reassembly-non-canonical-v1",
        "corpusId": "modkit/packages/host/test/archive-edits.test.ts",
        "corpusDigest": "none:proof-suite",
        "conformanceProfile": "modkit/codec-contribution-v1",
        "optionsFingerprint": "options:stored-additions",
        "inputClass": "zip-non-canonical-layout",
        "provenAt": "2026-08-19T00:00:00Z"
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 128,
      "maxNodes": 1000000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 10000
    }
  }
}
