{
  "name": "modkit-extension-models",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Isolated MK3 model codecs.",
  "exports": {
    ".": "./src/index.js",
    "./linked": "./src/linked.js",
    "./formats/obj/codec": "./src/obj/codec.js",
    "./formats/gltf/codec": "./src/gltf/codec.js",
    "./formats/*/codec": "./src/*/codec.js",
    "./package.json": "./package.json"
  },
  "files": [
    "contributions",
    "src",
    "README.md"
  ],
  "modkit": {
    "schemaVersion": 1,
    "publisher": "modkit",
    "id": "models",
    "presentation": {
      "displayName": "Modkit Models",
      "description": "Isolated MK3 model codecs.",
      "vendor": {
        "id": "modkit",
        "displayName": "Modkit"
      }
    },
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "dependencies": {
    "@modkit/codec-kit": "workspace:*"
  },
  "peerDependencies": {
    "@modkit/host": "workspace:*",
    "@modkit/sdk": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@modkit/host": {
      "optional": true
    },
    "@modkit/sdk": {
      "optional": true
    }
  }
}
