  "configuration": {
    "title": "%configuration.title%",
    "properties": {
      "modkit.extensions": {
        "type": "array",
        "default": [],
        "markdownDescription": "%configuration.extensions.description%",
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          ]
        }
      },
      "modkit.extensionRegistry": {
        "type": "string",
        "default": "",
        "markdownDescription": "%configuration.extensionRegistry.description%"
      },
      "modkit.contentSourceConfig": {
        "type": "string",
        "default": "",
        "markdownDescription": "%configuration.contentSourceConfig.description%"
      },
      "modkit.baseMods": {
        "type": "object",
        "default": {},
        "scope": "resource",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "markdownDescription": "%configuration.baseMods.description%"
      },
      "modkit.launch.warnIfRunning": {
        "type": "boolean",
        "default": true,
        "markdownDescription": "%configuration.launch.warnIfRunning.description%"
      },
      "modkit.installationSearchFolders": {
        "type": "array",
        "items": { "type": "string" },
        "default": [
          "Program Files",
          "Program Files (x86)",
          "Games",
          "Apps",
          "Applications",
          "%LOCALAPPDATA%\\Programs"
        ],
        "scope": "machine",
        "markdownDescription": "%configuration.installationSearchFolders.description%"
      },
      "modkit.showHiddenEntries": {
        "type": "boolean",
        "default": false,
        "markdownDescription": "%configuration.showHiddenEntries.description%"
      },
      "modkit.askExportLocation": {
        "type": "boolean",
        "default": true,
        "markdownDescription": "%configuration.askExportLocation.description%"
      },
      "modkit.documentUpdateDelay": {
        "type": "integer",
        "default": 150,
        "minimum": 0,
        "maximum": 5000,
        "markdownDescription": "%configuration.documentUpdateDelay.description%"
      },
      "modkit.documentDiagnosticsDelay": {
        "type": "integer",
        "default": 2500,
        "minimum": 0,
        "maximum": 60000,
        "markdownDescription": "%configuration.documentDiagnosticsDelay.description%"
      },
      "modkit.extensionPackages": {
        "type": "string",
        "default": "",
        "scope": "machine",
        "markdownDescription": "%configuration.extensionPackages.description%"
      },
      "modkit.maxGraphHops": {
        "type": "integer",
        "default": 2,
        "minimum": 1,
        "maximum": 4,
        "markdownDescription": "%configuration.maxGraphHops.description%"
      },
      "modkit.launch.testMap": {
        "type": "string",
        "default": "",
        "scope": "resource",
        "markdownDescription": "%configuration.launch.testMap.description%"
      },
      "modkit.launch.documentsDirectory": {
        "type": "string",
        "default": "",
        "markdownDescription": "%configuration.launch.documentsDirectory.description%"
      },
      "modkit.disabledContributions": {
        "type": "array",
        "default": [],
        "markdownDescription": "%configuration.disabledContributions.description%",
        "items": {
          "type": "string"
        }
      },
      "modkit.disabledExtensions": {
        "type": "array",
        "default": [],
        "markdownDescription": "%configuration.disabledExtensions.description%",
        "items": {
          "type": "string"
        }
      },
      "modkit.nonDefaultContributions": {
        "type": "array",
        "default": [],
        "markdownDescription": "%configuration.nonDefaultContributions.description%",
        "items": {
          "type": "string"
        }
      },
      "modkit.defaultEditorForTextFormats": {
        "type": "boolean",
        "default": false,
        "markdownDescription": "%configuration.defaultEditorForTextFormats.description%"
      },
      "modkit.managedEditorAssociations": {
        "type": "array",
        "default": [],
        "markdownDescription": "%configuration.managedEditorAssociations.description%",
        "items": {
          "type": "string"
        }
      },
      "modkit.contributionSettings": {
        "type": "object",
        "default": {},
        "additionalProperties": {
          "type": "object"
        },
        "markdownDescription": "%configuration.contributionSettings.description%"
      },
      "modkit.indexCaches": {
        "type": "object",
        "default": {},
        "additionalProperties": {
          "type": "object",
          "properties": {
            "names": {
              "type": "boolean"
            },
            "content": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "markdownDescription": "%configuration.indexCaches.description%"
      },
      "modkit.locale": {
        "type": "string",
        "default": "",
        "markdownDescription": "%configuration.locale.description%"
      }
    }
  },
  "customEditors": [
