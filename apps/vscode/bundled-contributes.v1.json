{
  "schemaVersion": 1,
  "commands": [
    {
      "command": "modkit.verifyDocument",
      "title": "%command.verifyDocument%",
      "icon": "$(check)",
      "enablement": "modkit.canVerifyDocument"
    },
    {
      "command": "modkit.contentSources",
      "title": "%command.contentSources%",
      "icon": "$(remote-explorer)"
    },
    {
      "command": "modkit.addExtensionFolder",
      "title": "%command.addExtensionFolder%"
    },
    {
      "command": "modkit.extensions.disable",
      "title": "%command.disableExtension%"
    },
    {
      "command": "modkit.extensions.disableContribution",
      "title": "%command.disableCodec%",
      "icon": "$(circle-slash)"
    },
    {
      "command": "modkit.extensions.disableAllCodecs",
      "title": "%command.disableAllCodecs%",
      "icon": "$(circle-slash)"
    },
    {
      "command": "modkit.extensions.enable",
      "title": "%command.enableExtension%"
    },
    {
      "command": "modkit.extensions.enableContribution",
      "title": "%command.enableCodec%",
      "icon": "$(check)"
    },
    {
      "command": "modkit.extensions.enableAllCodecs",
      "title": "%command.enableAllCodecs%",
      "icon": "$(check)"
    },
    {
      "command": "modkit.extensions.install",
      "title": "%command.installExtension%"
    },
    {
      "command": "modkit.extensions.installAll",
      "title": "%command.installAllExtensions%",
      "icon": "$(cloud-download)"
    },
    {
      "command": "modkit.extensions.installGameSupport",
      "title": "%command.installGameSupport%",
      "icon": "$(cloud-download)"
    },
    {
      "command": "modkit.extensions.completeGameSupport",
      "title": "%command.completeGameSupport%",
      "icon": "$(tools)"
    },
    {
      "command": "modkit.extensions.openContribution",
      "title": "%command.openContributionCard%"
    },
    {
      "command": "modkit.extensions.openExtension",
      "title": "%command.openExtensionCard%"
    },
    {
      "command": "modkit.extensions.refresh",
      "title": "%command.refreshExtensionCatalog%"
    },
    {
      "command": "modkit.extensions.remove",
      "title": "%command.removeExtension%",
      "icon": "$(trash)"
    },
    {
      "command": "modkit.extensions.removeGameSupport",
      "title": "%command.removeGameSupport%",
      "icon": "$(trash)"
    },
    {
      "command": "modkit.extensions.removeVendorSupport",
      "title": "%command.removeVendorSupport%",
      "icon": "$(trash)"
    },
    {
      "command": "modkit.extensions.update",
      "title": "%command.updateExtension%",
      "icon": "$(sync)"
    },
    {
      "command": "modkit.explainResolution",
      "title": "%command.explainResolution%"
    },
    {
      "command": "modkit.exportDiagnostics",
      "title": "%command.exportDiagnostics%"
    },
    {
      "command": "modkit.game.launchActiveMap",
      "title": "%command.launchActiveMap%"
    },
    {
      "command": "modkit.materializeContainerEntry",
      "title": "%command.materializeContainerMember%"
    },
    {
      "command": "modkit.navigateResource",
      "title": "%command.navigateResource%"
    },
    {
      "command": "modkit.openWith",
      "title": "%command.openActiveFile%"
    },
    {
      "command": "modkit.showHostProfile",
      "title": "%command.openWorkbench%"
    },
    {
      "command": "modkit.browseContainer",
      "title": "%command.browseContainer%"
    },
    {
      "command": "modkit.openArchiveEntry",
      "title": "%command.openContainerMember%"
    },
    {
      "command": "modkit.refreshContainer",
      "title": "%command.refreshContainer%"
    },
    {
      "command": "modkit.refreshRelations",
      "title": "%command.refreshRelations%"
    },
    {
      "command": "modkit.runCommand",
      "title": "%command.runCommand%"
    },
    {
      "command": "modkit.runtime.control",
      "title": "%command.controlRuntime%"
    },
    {
      "command": "modkit.searchContainer",
      "title": "%command.searchContainer%"
    },
    {
      "command": "modkit.selectGameInstallation",
      "title": "%command.selectGameInstallation%",
      "icon": "$(folder-library)"
    },
    {
      "command": "modkit.sources.openInstallation",
      "title": "%command.openGameInstallation%",
      "icon": "$(plug)"
    },
    {
      "command": "modkit.sources.revealLocal",
      "title": "%command.revealLocalSource%",
      "icon": "$(folder)"
    },
    {
      "command": "modkit.showDiagnostics",
      "title": "%command.showDiagnostics%"
    },
    {
      "command": "modkit.unloadSource",
      "title": "%command.unloadContentSource%",
      "icon": "$(trash)"
    },
    {
      "command": "modkit.sources.open",
      "title": "%command.openContentSource%",
      "icon": "$(plug)"
    },
    {
      "command": "modkit.sources.refresh",
      "title": "%command.refreshSources%",
      "icon": "$(refresh)"
    },
    {
      "command": "modkit.resources.refresh",
      "title": "%command.refreshResources%",
      "icon": "$(refresh)"
    },
    {
      "command": "modkit.resources.search",
      "title": "%command.searchResources%",
      "icon": "$(search)"
    },
    {
      "command": "modkit.resources.open",
      "title": "%command.openResourceNode%",
      "icon": "$(go-to-file)"
    },
    {
      "command": "modkit.setCodecDefaultEditor",
      "title": "%command.setCodecDefaultEditor%"
    },
    {
      "command": "modkit.syncEditorAssociations",
      "title": "%command.syncEditorAssociations%"
    },
    {
      "command": "modkit.sources.unmount",
      "title": "%command.unmountContentSource%",
      "icon": "$(debug-disconnect)"
    },
    {
      "command": "modkit.resources.toggleChain",
      "title": "%command.toggleResourceChain%",
      "icon": "$(layers)"
    },
    {
      "command": "modkit.sources.signIn",
      "title": "%command.signInBattleNet%",
      "icon": "$(sign-in)"
    },
    {
      "command": "modkit.sources.signOut",
      "title": "%command.signOutBattleNet%",
      "icon": "$(sign-out)"
    },
    {
      "command": "modkit.sources.addPublic",
      "title": "%command.addPublicSource%",
      "icon": "$(add)"
    },
    {
      "command": "modkit.sources.download",
      "title": "%command.downloadSource%",
      "icon": "$(cloud-download)"
    },
    {
      "command": "modkit.sources.clearCache",
      "title": "%command.clearSourceCache%",
      "icon": "$(trash)"
    },
    {
      "command": "modkit.sources.detach",
      "title": "%command.detachSource%",
      "icon": "$(close)"
    },
    {
      "command": "modkit.sources.disconnect",
      "title": "%command.sources.disconnect.title%",
      "icon": "$(debug-disconnect)"
    }
  ],
  "configuration": {
    "title": "%configuration.title%",
    "properties": {
      "modkit.extensions": {
        "type": "array",
        "default": [],
        "markdownDescription": "%configuration.extensions.description%",
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          ]
        }
      },
      "modkit.extensionRegistry": {
        "type": "string",
        "default": "",
        "markdownDescription": "%configuration.extensionRegistry.description%"
      },
      "modkit.contentSourceConfig": {
        "type": "string",
        "default": "",
        "markdownDescription": "%configuration.contentSourceConfig.description%"
      },
      "modkit.disabledContributions": {
        "type": "array",
        "default": [],
        "markdownDescription": "%configuration.disabledContributions.description%",
        "items": {
          "type": "string"
        }
      },
      "modkit.disabledExtensions": {
        "type": "array",
        "default": [],
        "markdownDescription": "%configuration.disabledExtensions.description%",
        "items": {
          "type": "string"
        }
      },
      "modkit.nonDefaultContributions": {
        "type": "array",
        "default": [],
        "markdownDescription": "%configuration.nonDefaultContributions.description%",
        "items": {
          "type": "string"
        }
      },
      "modkit.defaultEditorForTextFormats": {
        "type": "boolean",
        "default": false,
        "markdownDescription": "%configuration.defaultEditorForTextFormats.description%"
      },
      "modkit.managedEditorAssociations": {
        "type": "array",
        "default": [],
        "markdownDescription": "%configuration.managedEditorAssociations.description%",
        "items": {
          "type": "string"
        }
      },
      "modkit.sources.reconnectOnStartup": {
        "type": "boolean",
        "default": false,
        "markdownDescription": "%configuration.reconnectOnStartup.description%"
      }
    }
  },
  "customEditors": [
    {
      "viewType": "modkit.genericAssetPreview",
      "displayName": "%customEditor.assetPreview%",
      "selector": [
        {
          "filenamePattern": "*"
        }
      ],
      "priority": "option"
    },
    {
      "viewType": "modkit.hexViewer",
      "displayName": "%customEditor.hexViewer%",
      "selector": [
        {
          "filenamePattern": "*"
        }
      ],
      "priority": "option"
    },
    {
      "viewType": "modkit.imageViewer",
      "displayName": "%customEditor.imageViewer%",
      "selector": [
        {
          "filenamePattern": "*"
        }
      ],
      "priority": "option"
    },
    {
      "viewType": "modkit.archiveViewer",
      "displayName": "%customEditor.archiveViewer%",
      "selector": [
        {
          "filenamePattern": "*"
        }
      ],
      "priority": "option"
    }
  ],
  "grammars": [
    {
      "language": "sc2-data",
      "scopeName": "text.xml.sc2-data",
      "path": "./media/sc2-data.tmLanguage.json"
    }
  ],
  "languages": [
    {
      "id": "galaxy",
      "aliases": [
        "Galaxy"
      ],
      "extensions": [
        ".galaxy"
      ]
    },
    {
      "id": "sc2-bank",
      "aliases": [
        "StarCraft II Bank"
      ],
      "extensions": [
        ".SC2Bank",
        ".sc2bank"
      ]
    },
    {
      "id": "sc2-cutscene",
      "aliases": [
        "StarCraft II Cutscene"
      ],
      "extensions": [
        ".SC2Cutscene",
        ".sc2cutscene"
      ]
    },
    {
      "id": "sc2-data",
      "aliases": [
        "StarCraft II GameData"
      ],
      "filenamePatterns": [
        "**/[Gg]ame[Dd]ata/*.[xX][mM][lL]"
      ],
      "configuration": "./media/sc2-data-language-configuration.json"
    },
    {
      "id": "sc2-layout",
      "aliases": [
        "StarCraft II Layout"
      ],
      "extensions": [
        ".SC2Layout",
        ".sc2layout"
      ]
    },
    {
      "id": "sc2-strings",
      "aliases": [
        "StarCraft II Strings"
      ],
      "filenamePatterns": [
        "**/[Ll]ocalized[Dd]ata/*.[tT][xX][tT]"
      ]
    },
    {
      "id": "sc2-style",
      "aliases": [
        "StarCraft II Style"
      ],
      "extensions": [
        ".SC2Style",
        ".sc2style"
      ]
    },
    {
      "id": "sc2-triggers",
      "aliases": [
        "StarCraft II Triggers"
      ],
      "extensions": [
        ".SC2Lib",
        ".SC2Triggers",
        ".TriggerLib",
        ".sc2lib",
        ".triggers",
        ".triggerlib"
      ]
    },
    {
      "id": "sc2-wizard",
      "aliases": [
        "StarCraft II Wizard"
      ],
      "extensions": [
        ".BlizWiz",
        ".blizwiz"
      ]
    },
    {
      "id": "storm-cutscene",
      "aliases": [
        "Storm Cutscene"
      ],
      "extensions": [
        ".StormCutscene",
        ".stormcutscene"
      ]
    }
  ],
  "viewsContainers": {
    "activitybar": [
      {
        "id": "modkit",
        "title": "%viewContainer.modkit%",
        "icon": "media/icon-128.png"
      }
    ]
  },
  "views": {
    "modkit": [
      {
        "id": "modkit.gallery",
        "name": "%view.gallery%",
        "type": "webview"
      },
      {
        "id": "modkit.sources",
        "name": "%view.sources%"
      },
      {
        "id": "modkit.resources",
        "name": "%view.resources%"
      },
      {
        "id": "modkit.extensions",
        "name": "%view.extensions%"
      }
    ]
  },
  "menus": {
    "editor/title": [
      {
        "command": "modkit.verifyDocument",
        "when": "modkit.canVerifyDocument",
        "group": "navigation@4"
      }
    ],
    "explorer/context": [
      {
        "command": "modkit.sources.revealLocal",
        "when": "resourceScheme == modkit-source || resourceScheme == modkit-container",
        "group": "navigation@20"
      },
      {
        "command": "modkit.sources.download",
        "when": "resourceScheme == modkit-source",
        "group": "navigation@21"
      },
      {
        "command": "modkit.sources.clearCache",
        "when": "resourceScheme == modkit-source",
        "group": "navigation@22"
      },
      {
        "command": "modkit.sources.detach",
        "when": "resourceScheme == modkit-source",
        "group": "navigation@23"
      }
    ],
    "view/title": [
      {
        "command": "modkit.contentSources",
        "when": "view == modkit.sources",
        "group": "navigation@1"
      },
      {
        "command": "modkit.selectGameInstallation",
        "when": "view == modkit.sources",
        "group": "navigation@2"
      },
      {
        "command": "modkit.sources.refresh",
        "when": "view == modkit.sources",
        "group": "navigation@3"
      },
      {
        "command": "modkit.resources.search",
        "when": "view == modkit.resources",
        "group": "navigation@1"
      },
      {
        "command": "modkit.resources.refresh",
        "when": "view == modkit.resources",
        "group": "navigation@2"
      },
      {
        "command": "modkit.resources.toggleChain",
        "when": "view == modkit.resources",
        "group": "navigation@0"
      }
    ],
    "view/item/context": [
      {
        "command": "modkit.sources.open",
        "when": "view == modkit.sources && viewItem =~ /^modkitSource\\.(?:providerRoot|publicRoot|localRoot)$/",
        "group": "inline@1"
      },
      {
        "command": "modkit.sources.revealLocal",
        "when": "view == modkit.sources && viewItem =~ /^modkitSource\\.localRoot(?:\\.(?:mounted|mounting))?$/",
        "group": "inline@2"
      },
      {
        "command": "modkit.sources.openInstallation",
        "when": "view == modkit.sources && viewItem == modkitSource.installation",
        "group": "inline@1"
      },
      {
        "command": "modkit.sources.revealLocal",
        "when": "view == modkit.sources && viewItem =~ /^modkitSource\\.installation(?:\\.(?:mounted|mounting))?$/",
        "group": "inline@2"
      },
      {
        "command": "modkit.unloadSource",
        "when": "view == modkit.sources && viewItem =~ /^modkitSource\\.installation(?:\\.(?:mounted|mounting))?$/",
        "group": "inline@3"
      },
      {
        "command": "modkit.resources.open",
        "when": "view == modkit.resources && viewItem == modkitResource.openable",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.enableContribution",
        "when": "view == modkit.extensions && viewItem == modkitContribution.codec.disabled",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.disableContribution",
        "when": "view == modkit.extensions && viewItem == modkitContribution.codec.enabled",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.disableAllCodecs",
        "when": "view == modkit.extensions && viewItem =~ /^modkitExtension\\.installed\\..*\\.codecs\\.enabled$/",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.enableAllCodecs",
        "when": "view == modkit.extensions && viewItem =~ /^modkitExtension\\.installed\\..*\\.codecs\\.disabled$/",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.installAll",
        "when": "view == modkit.extensions && viewItem == modkitExtensionGroup.available",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.installGameSupport",
        "when": "view == modkit.extensions && viewItem == modkitExtensionComponent.game.available",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.completeGameSupport",
        "when": "view == modkit.extensions && viewItem == modkitExtensionComponent.game.partial",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.removeGameSupport",
        "when": "view == modkit.extensions && viewItem == modkitExtensionComponent.game.installed.mutable",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.removeVendorSupport",
        "when": "view == modkit.extensions && viewItem == modkitExtensionVendor.installed.mutable",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.install",
        "when": "view == modkit.extensions && viewItem == modkitExtension.available",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.update",
        "when": "view == modkit.extensions && viewItem =~ /^modkitExtension\\.installed\\.mutable\\.update(?:\\.|$)/",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.remove",
        "when": "view == modkit.extensions && viewItem =~ /^modkitExtension\\.installed\\.mutable(?:\\.update)?(?:\\.codecs\\.(?:enabled|disabled))?$/",
        "group": "inline@2"
      },
      {
        "command": "modkit.sources.unmount",
        "when": "view == modkit.sources && viewItem =~ /^modkitSource\\.(?:providerRoot|publicRoot|localRoot|installation)\\.(?:mounted|mounting)$/",
        "group": "inline@4"
      },
      {
        "command": "modkit.sources.signIn",
        "when": "view == modkit.sources && viewItem =~ /^modkitSource\\.(?:provider|connections)$/",
        "group": "inline@1"
      },
      {
        "command": "modkit.sources.signOut",
        "when": "view == modkit.sources && viewItem == modkitSource.connection",
        "group": "inline@1"
      },
      {
        "command": "modkit.sources.clearCache",
        "when": "view == modkit.sources && viewItem == modkitSource.publication.cached",
        "group": "inline@1"
      },
      {
        "command": "modkit.sources.download",
        "when": "view == modkit.sources && viewItem == modkitSource.publication.notCached",
        "group": "inline@1"
      },
      {
        "command": "modkit.sources.revealLocal",
        "when": "view == modkit.sources && viewItem == modkitSource.publication.cached",
        "group": "inline@2"
      },
      {
        "command": "modkit.sources.detach",
        "when": "view == modkit.sources && viewItem =~ /^modkitSource\\.publication\\./",
        "group": "inline@3"
      },
      {
        "command": "modkit.sources.signIn",
        "when": "view == modkit.sources && viewItem == modkitSource.connection.offline",
        "group": "inline@1"
      },
      {
        "command": "modkit.sources.refresh",
        "when": "view == modkit.sources && viewItem =~ /^modkitSource\\.(?:providerRoot|publicRoot)(\\.|$)/",
        "group": "inline@2"
      },
      {
        "command": "modkit.sources.disconnect",
        "when": "view == modkit.sources && viewItem =~ /^modkitSource\\.providerRoot(\\.|$)/",
        "group": "inline@3"
      },
      {
        "command": "modkit.sources.addPublic",
        "when": "view == modkit.sources && viewItem =~ /^modkitSource\\.publicRoot(\\.|$)/",
        "group": "inline@0"
      }
    ]
  },
  "fileSystemSchemes": [
    "modkit-container",
    "modkit-source"
  ]
}
