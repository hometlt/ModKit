  "configuration": {
    "title": "Modkit MK3",
    "properties": {
      "modkit.disabledContributions": {
        "default": [],
        "items": {
          "type": "string"
        },
        "markdownDescription": "Contribution ids to switch off, one level below `modkit.extensions`: an extension may ship several codecs and you may want only some of them. A disabled contribution stays in the inventory and loses activation, so a file only it could read opens as raw bytes with the diagnostic `x3.host/contribution-disabled` — and the switch is still there to turn it back on. Takes effect when the window reloads.",
        "type": "array"
      },
      "modkit.extensionRegistry": {
        "default": "",
        "markdownDescription": "Catalog file or HTTPS URL used by the extension manager. Opening the Extensions view reads only its local cache; the registry is contacted only by `Modkit: Refresh Extension Catalog`. `MODKIT_EXTENSION_REGISTRY` is used when this setting is empty. Remote catalogs also require an Ed25519 key map in `MODKIT_EXTENSION_TRUSTED_PUBLIC_KEYS`; remote artifact origins stay blocked unless listed in `MODKIT_EXTENSION_ALLOWED_ORIGINS`.",
        "type": "string"
      },
      "modkit.extensions": {
        "default": [],
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          ]
        },
        "markdownDescription": "Extension directories to load beside the ones that ship with this build. Each item is either a path, or an object with `path`, an optional `id` the directory is expected to declare, and an optional `enabled` flag. Directories named here are loaded as installed artifacts and never run in the extension host process.",
        "type": "array"
      }
    }
  },
  "customEditors": [
    {
      "viewType": "modkit.genericAssetPreview",
      "displayName": "Modkit Asset Preview",
      "selector": [
        {
          "filenamePattern": "*"
        }
      ],
      "priority": "option"
    }
  ],
  "languages": [],
  "views": {
    "modkit": [
