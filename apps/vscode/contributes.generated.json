{
  "commands": [
    {
      "command": "modkit.addExtensionFolder",
      "title": "%command.addExtensionFolder%"
    },
    {
      "command": "modkit.browseContainer",
      "title": "%command.browseContainer%"
    },
    {
      "command": "modkit.explainResolution",
      "title": "%command.explainResolution%"
    },
    {
      "command": "modkit.exportDiagnostics",
      "title": "%command.exportDiagnostics%"
    },
    {
      "command": "modkit.extensions.completeGameSupport",
      "title": "%command.completeGameSupport%",
      "icon": "$(tools)"
    },
    {
      "command": "modkit.extensions.disable",
      "title": "%command.disableExtension%"
    },
    {
      "command": "modkit.extensions.disableAllCodecs",
      "title": "%command.disableAllCodecs%",
      "icon": "$(circle-slash)"
    },
    {
      "command": "modkit.extensions.disableContribution",
      "title": "%command.disableCodec%",
      "icon": "$(circle-slash)"
    },
    {
      "command": "modkit.extensions.enable",
      "title": "%command.enableExtension%"
    },
    {
      "command": "modkit.extensions.enableAllCodecs",
      "title": "%command.enableAllCodecs%",
      "icon": "$(check)"
    },
    {
      "command": "modkit.extensions.enableContribution",
      "title": "%command.enableCodec%",
      "icon": "$(check)"
    },
    {
      "command": "modkit.extensions.install",
      "title": "%command.installExtension%"
    },
    {
      "command": "modkit.extensions.installAll",
      "title": "%command.installAllExtensions%",
      "icon": "$(cloud-download)"
    },
    {
      "command": "modkit.extensions.installGameSupport",
      "title": "%command.installGameSupport%",
      "icon": "$(cloud-download)"
    },
    {
      "command": "modkit.extensions.openContribution",
      "title": "%command.openContributionCard%"
    },
    {
      "command": "modkit.extensions.openExtension",
      "title": "%command.openExtensionCard%"
    },
    {
      "command": "modkit.extensions.refresh",
      "title": "%command.refreshExtensionCatalog%"
    },
    {
      "command": "modkit.extensions.remove",
      "title": "%command.removeExtension%",
      "icon": "$(trash)"
    },
    {
      "command": "modkit.extensions.removeGameSupport",
      "title": "%command.removeGameSupport%",
      "icon": "$(trash)"
    },
    {
      "command": "modkit.extensions.update",
      "title": "%command.updateExtension%",
      "icon": "$(sync)"
    },
    {
      "command": "modkit.game.launchActiveMap",
      "title": "%command.launchActiveMap%"
    },
    {
      "command": "modkit.materializeContainerEntry",
      "title": "%command.materializeContainerMember%"
    },
    {
      "command": "modkit.navigateResource",
      "title": "%command.navigateResource%"
    },
    {
      "command": "modkit.openArchiveEntry",
      "title": "%command.openContainerMember%"
    },
    {
      "command": "modkit.openWith",
      "title": "%command.openActiveFile%"
    },
    {
      "command": "modkit.refreshContainer",
      "title": "%command.refreshContainer%"
    },
    {
      "command": "modkit.refreshRelations",
      "title": "%command.refreshRelations%"
    },
    {
      "command": "modkit.runCommand",
      "title": "%command.runCommand%"
    },
    {
      "command": "modkit.runtime.control",
      "title": "%command.controlRuntime%"
    },
    {
      "command": "modkit.searchContainer",
      "title": "%command.searchContainer%"
    },
    {
      "command": "modkit.selectGameInstallation",
      "title": "%command.selectGameInstallation%"
    },
    {
      "command": "modkit.showDiagnostics",
      "title": "%command.showDiagnostics%"
    },
    {
      "command": "modkit.showHostProfile",
      "title": "%command.openWorkbench%"
    },
    {
      "command": "modkit.unloadSource",
      "title": "%command.unloadContentSource%"
    }
  ],
  "configuration": {
    "title": "%configuration.title%",
    "properties": {
      "modkit.disabledContributions": {
        "default": [],
        "items": {
          "type": "string"
        },
        "markdownDescription": "%configuration.disabledContributions.description%",
        "type": "array"
      },
      "modkit.disabledExtensions": {
        "default": [],
        "items": {
          "type": "string"
        },
        "markdownDescription": "%configuration.disabledExtensions.description%",
        "type": "array"
      },
      "modkit.extensionRegistry": {
        "default": "",
        "markdownDescription": "%configuration.extensionRegistry.description%",
        "type": "string"
      },
      "modkit.extensions": {
        "default": [],
        "items": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          ]
        },
        "markdownDescription": "%configuration.extensions.description%",
        "type": "array"
      }
    }
  },
  "customEditors": [
    {
      "viewType": "modkit.genericAssetPreview",
      "displayName": "%customEditor.assetPreview%",
      "selector": [
        {
          "filenamePattern": "*"
        }
      ],
      "priority": "option"
    }
  ],
  "languages": [],
  "menus": {
    "view/item/context": [
      {
        "command": "modkit.extensions.completeGameSupport",
        "when": "view == modkit.extensions && viewItem == modkitExtensionComponent.game.partial",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.disableAllCodecs",
        "when": "view == modkit.extensions && viewItem =~ /^modkitExtension\\.installed\\..*\\.codecs\\.enabled$/",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.disableContribution",
        "when": "view == modkit.extensions && viewItem == modkitContribution.codec.enabled",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.enableAllCodecs",
        "when": "view == modkit.extensions && viewItem =~ /^modkitExtension\\.installed\\..*\\.codecs\\.disabled$/",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.enableContribution",
        "when": "view == modkit.extensions && viewItem == modkitContribution.codec.disabled",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.install",
        "when": "view == modkit.extensions && viewItem == modkitExtension.available",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.installAll",
        "when": "view == modkit.extensions && viewItem == modkitExtensionGroup.available",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.installGameSupport",
        "when": "view == modkit.extensions && viewItem == modkitExtensionComponent.game.available",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.remove",
        "when": "view == modkit.extensions && viewItem =~ /^modkitExtension\\.installed\\.mutable(?:\\.update)?(?:\\.codecs\\.(?:enabled|disabled))?$/",
        "group": "inline@2"
      },
      {
        "command": "modkit.extensions.removeGameSupport",
        "when": "view == modkit.extensions && viewItem == modkitExtensionComponent.game.installed.mutable",
        "group": "inline@1"
      },
      {
        "command": "modkit.extensions.update",
        "when": "view == modkit.extensions && viewItem =~ /^modkitExtension\\.installed\\.mutable\\.update(?:\\.|$)/",
        "group": "inline@1"
      }
    ]
  },
  "views": {
    "modkit": [
      {
        "id": "modkit.extensions",
        "name": "%view.extensions%"
      },
      {
        "id": "modkit.host",
        "name": "%view.host%"
      }
    ]
  },
  "viewsContainers": {
    "activitybar": [
      {
        "id": "modkit",
        "title": "%viewContainer.modkit%",
        "icon": "media/icon-128.png"
      }
    ]
  }
}
