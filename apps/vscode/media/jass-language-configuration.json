{
    "comments": {
        "lineComment": "//"
    },
    "brackets": [
        ["(", ")"],
        ["[", "]"]
    ],
    "autoClosingPairs": [
        { "open": "(", "close": ")" },
        { "open": "[", "close": "]" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["(", ")"],
        ["[", "]"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|-?\\d*\\.\\d+|-?\\d+",
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(globals|(constant\\s+)?function\\b.*|if\\b.*\\bthen|elseif\\b.*\\bthen|else|loop)\\s*(//.*)?$",
        "decreaseIndentPattern": "^\\s*(endglobals|endfunction|endif|elseif\\b|else\\b|endloop)\\b"
    },
    "folding": {
        "markers": {
            "start": "^\\s*(globals|(constant\\s+)?function\\b|if\\b|loop\\b)",
            "end": "^\\s*(endglobals|endfunction|endif|endloop)\\b"
        }
    }
}
