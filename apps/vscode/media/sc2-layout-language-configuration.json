{
    "comments": {
        "blockComment": ["<!--", "-->"]
    },
    "brackets": [
        ["<!--", "-->"],
        ["<", ">"],
        ["{", "}"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}"},
        { "open": "[", "close": "]"},
        { "open": "\"", "close": "\"", "notIn": [ "string" ] },
        { "open": "<!--", "close": "-->", "notIn": [ "comment", "string" ]}
    ],
    "surroundingPairs": [
        { "open": "<", "close": ">" },
        { "open": "\"", "close": "\"" },
        { "open": "{", "close": "}"},
        { "open": "[", "close": "]"}
    ],
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([#$]+[^~!@#$%^&*()\\-=+\\[{\\]}\\\\|;:'\",.<>/?\\s`]*)|([^~!@#$%^&*()\\-=+\\[{\\]}\\\\|;:'\",.<>/?\\s`]+)",
    "autoCloseBefore": ";:.,=}])>/\" \n\t",
    "indentationRules": {
        "increaseIndentPattern": "<(?!\\?|[^>]*\\/>)([-_\\.A-Za-z0-9]+)(?=\\s|>)\\b[^>]*>(?!.*<\\/\\1>)|<!--(?!.*-->)|\\{[^}\"']*$",
        "decreaseIndentPattern": "^\\s*(<\\/[-_\\.A-Za-z0-9]+\\b[^>]*>|-->|\\})"
    },
    "onEnterRules": [
        {
            "beforeText": { "pattern": "<([_:\\w][_:\\w-.\\d]*)([^>/]*(?!\\/>)(\\/[^>]|>))+[^</]*$", "flags": "i" },
            "afterText": { "pattern": "^<\\/([_:\\w][_:\\w-.\\d]*)\\s*>\\s*$", "flags": "i" },
            "action": { "indent": "indentOutdent" }
        }
    ],
    "folding": {
        "markers": {
            "start": "^\\s*<!--\\s*#region\\b.*-->",
            "end": "^\\s*<!--\\s*#endregion\\b.*-->"
        }
    }
}
