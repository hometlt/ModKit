{
    "comments": {
        "lineComment": "//"
    },
    "brackets": [
        ["{", "}"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" }
    ],
    "surroundingPairs": [
        ["{", "}"]
    ],
    "folding": {
        "markers": {
            "start": "^\\s*\\{\\s*$",
            "end": "^\\s*\\}\\s*$"
        }
    }
}
