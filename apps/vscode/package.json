{
  "name": "@modkitx-x3/modkit-vscode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "contributes.generated.json",
    "package.nls.json",
    "package.nls.ru.json",
    "dist",
    "dist-app",
    "generated",
    "media"
  ],
  "scripts": {
    "contributes:emit": "node scripts/generate-contributes.mjs",
    "contributes:check": "node scripts/generate-contributes.mjs --check",
    "ext:build": "node scripts/build-extension.mjs",
    "prepack": "pnpm ext:build",
    "vscode:prepublish": "pnpm ext:build",
    "smoke:vscode": "node test-e2e/run-smoke.mjs",
    "smoke:vscode:lifecycle": "node test-e2e/run-lifecycle-smoke.mjs",
    "dist-app:check": "node scripts/build-extension.mjs --check"
  },
  "dependencies": {
    "@modkitx/extension-manager": "workspace:*",
    "@modkitx-x3/core": "workspace:*",
    "@modkitx-x3/host": "workspace:*",
    "@modkitx-x3/sdk": "workspace:*",
    "@modkitx-x3/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0"
  },
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "publisher": "modkitx",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist-app/extension.cjs",
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "modkit.addExtensionFolder",
        "title": "%command.addExtensionFolder%"
      },
      {
        "command": "modkit.browseContainer",
        "title": "%command.browseContainer%"
      },
      {
        "command": "modkit.explainResolution",
        "title": "%command.explainResolution%"
      },
      {
        "command": "modkit.exportDiagnostics",
        "title": "%command.exportDiagnostics%"
      },
      {
        "command": "modkit.extensions.disable",
        "title": "%command.disableExtension%"
      },
      {
        "command": "modkit.extensions.enable",
        "title": "%command.enableExtension%"
      },
      {
        "command": "modkit.extensions.install",
        "title": "%command.installExtension%"
      },
      {
        "command": "modkit.extensions.openContribution",
        "title": "%command.openContributionCard%"
      },
      {
        "command": "modkit.extensions.openExtension",
        "title": "%command.openExtensionCard%"
      },
      {
        "command": "modkit.extensions.refresh",
        "title": "%command.refreshExtensionCatalog%"
      },
      {
        "command": "modkit.extensions.remove",
        "title": "%command.removeExtension%"
      },
      {
        "command": "modkit.extensions.update",
        "title": "%command.updateExtension%"
      },
      {
        "command": "modkit.game.launchActiveMap",
        "title": "%command.launchActiveMap%"
      },
      {
        "command": "modkit.materializeContainerEntry",
        "title": "%command.materializeContainerMember%"
      },
      {
        "command": "modkit.navigateResource",
        "title": "%command.navigateResource%"
      },
      {
        "command": "modkit.openArchiveEntry",
        "title": "%command.openContainerMember%"
      },
      {
        "command": "modkit.openWith",
        "title": "%command.openActiveFile%"
      },
      {
        "command": "modkit.refreshContainer",
        "title": "%command.refreshContainer%"
      },
      {
        "command": "modkit.refreshRelations",
        "title": "%command.refreshRelations%"
      },
      {
        "command": "modkit.runCommand",
        "title": "%command.runCommand%"
      },
      {
        "command": "modkit.runtime.control",
        "title": "%command.controlRuntime%"
      },
      {
        "command": "modkit.searchContainer",
        "title": "%command.searchContainer%"
      },
      {
        "command": "modkit.selectGameInstallation",
        "title": "%command.selectGameInstallation%"
      },
      {
        "command": "modkit.showDiagnostics",
        "title": "%command.showDiagnostics%"
      },
      {
        "command": "modkit.showHostProfile",
        "title": "%command.openWorkbench%"
      },
      {
        "command": "modkit.unloadSource",
        "title": "%command.unloadContentSource%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "modkit.disabledContributions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "%configuration.disabledContributions.description%",
          "type": "array"
        },
        "modkit.disabledExtensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "%configuration.disabledExtensions.description%",
          "type": "array"
        },
        "modkit.extensionRegistry": {
          "default": "",
          "markdownDescription": "%configuration.extensionRegistry.description%",
          "type": "string"
        },
        "modkit.extensions": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            ]
          },
          "markdownDescription": "%configuration.extensions.description%",
          "type": "array"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "modkit.genericAssetPreview",
        "displayName": "%customEditor.assetPreview%",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [],
    "views": {
      "modkit": [
        {
          "id": "modkit.extensions",
          "name": "%view.extensions%"
        },
        {
          "id": "modkit.host",
          "name": "%view.host%"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "modkit",
          "title": "%viewContainer.modkit%",
          "icon": "media/icon-128.png"
        }
      ]
    }
  },
  "activationEvents": [
    "onCommand:modkit.addExtensionFolder",
    "onCommand:modkit.browseContainer",
    "onCommand:modkit.explainResolution",
    "onCommand:modkit.exportDiagnostics",
    "onCommand:modkit.extensions.disable",
    "onCommand:modkit.extensions.enable",
    "onCommand:modkit.extensions.install",
    "onCommand:modkit.extensions.openContribution",
    "onCommand:modkit.extensions.openExtension",
    "onCommand:modkit.extensions.refresh",
    "onCommand:modkit.extensions.remove",
    "onCommand:modkit.extensions.update",
    "onCommand:modkit.game.launchActiveMap",
    "onCommand:modkit.materializeContainerEntry",
    "onCommand:modkit.navigateResource",
    "onCommand:modkit.openArchiveEntry",
    "onCommand:modkit.openWith",
    "onCommand:modkit.refreshContainer",
    "onCommand:modkit.refreshRelations",
    "onCommand:modkit.runCommand",
    "onCommand:modkit.runtime.control",
    "onCommand:modkit.searchContainer",
    "onCommand:modkit.selectGameInstallation",
    "onCommand:modkit.showDiagnostics",
    "onCommand:modkit.showHostProfile",
    "onCommand:modkit.unloadSource",
    "onCustomEditor:modkit.genericAssetPreview",
    "onView:modkit.extensions",
    "onView:modkit.host",
    "onFileSystem:modkit-container"
  ],
  "icon": "media/icon-128.png"
}
