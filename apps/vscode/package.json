{
  "name": "@modkitx-x3/modkit-vscode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "contributes.generated.json",
    "dist",
    "dist-app",
    "generated",
    "media"
  ],
  "scripts": {
    "contributes:emit": "node scripts/generate-contributes.mjs",
    "contributes:check": "node scripts/generate-contributes.mjs --check",
    "ext:build": "node scripts/build-extension.mjs",
    "prepack": "pnpm ext:build",
    "vscode:prepublish": "pnpm ext:build",
    "smoke:vscode": "node test-e2e/run-smoke.mjs",
    "smoke:vscode:lifecycle": "node test-e2e/run-lifecycle-smoke.mjs",
    "dist-app:check": "node scripts/build-extension.mjs --check"
  },
  "dependencies": {
    "@modkitx/extension-manager": "workspace:*",
    "@modkitx-x3/core": "workspace:*",
    "@modkitx-x3/host": "workspace:*",
    "@modkitx-x3/sdk": "workspace:*",
    "@modkitx-x3/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@vscode/test-electron": "^3.1.0"
  },
  "displayName": "Modkit MK3",
  "description": "Modkit MK3 host for game mod assets.",
  "publisher": "modkitx",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist-app/extension.cjs",
  "categories": [
    "Other"
  ],
  "contributes": {
    "commands": [
      {
        "command": "modkit.addExtensionFolder",
        "title": "Modkit: Add Extension Folder…"
      },
      {
        "command": "modkit.browseContainer",
        "title": "Modkit: Browse Container in Explorer"
      },
      {
        "command": "modkit.explainResolution",
        "title": "Modkit: Explain Resolution"
      },
      {
        "command": "modkit.exportDiagnostics",
        "title": "Modkit: Export Diagnostics…"
      },
      {
        "command": "modkit.extensions.disable",
        "title": "Modkit: Disable Extension…"
      },
      {
        "command": "modkit.extensions.enable",
        "title": "Modkit: Enable Extension…"
      },
      {
        "command": "modkit.extensions.install",
        "title": "Modkit: Install Extension…"
      },
      {
        "command": "modkit.extensions.refresh",
        "title": "Modkit: Refresh Extension Catalog"
      },
      {
        "command": "modkit.extensions.remove",
        "title": "Modkit: Remove Extension…"
      },
      {
        "command": "modkit.extensions.update",
        "title": "Modkit: Update Extension…"
      },
      {
        "command": "modkit.game.launchActiveMap",
        "title": "Modkit: Launch Active Map in Game…"
      },
      {
        "command": "modkit.materializeContainerEntry",
        "title": "Modkit: Materialize Container Member…"
      },
      {
        "command": "modkit.navigateResource",
        "title": "Modkit: Navigate to Resource"
      },
      {
        "command": "modkit.openArchiveEntry",
        "title": "Modkit: Open Container Member…"
      },
      {
        "command": "modkit.openWith",
        "title": "Modkit: Open Active File in Workbench"
      },
      {
        "command": "modkit.refreshContainer",
        "title": "Modkit: Refresh Container"
      },
      {
        "command": "modkit.refreshRelations",
        "title": "Modkit: Refresh Active Relations"
      },
      {
        "command": "modkit.runCommand",
        "title": "Modkit: Run Command…"
      },
      {
        "command": "modkit.runtime.control",
        "title": "Modkit: Control Runtime Session…"
      },
      {
        "command": "modkit.searchContainer",
        "title": "Modkit: Search Container…"
      },
      {
        "command": "modkit.selectGameInstallation",
        "title": "Modkit: Select Game Installation…"
      },
      {
        "command": "modkit.showDiagnostics",
        "title": "Modkit: Show Diagnostics"
      },
      {
        "command": "modkit.showHostProfile",
        "title": "Modkit: Open Workbench"
      },
      {
        "command": "modkit.unloadSource",
        "title": "Modkit: Unload Content Source…"
      }
    ],
    "configuration": {
      "title": "Modkit MK3",
      "properties": {
        "modkit.disabledContributions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "markdownDescription": "Contribution ids to switch off, one level below `modkit.extensions`: an extension may ship several codecs and you may want only some of them. A disabled contribution stays in the inventory and loses activation, so a file only it could read opens as raw bytes with the diagnostic `x3.host/contribution-disabled` — and the switch is still there to turn it back on. Takes effect when the window reloads.",
          "type": "array"
        },
        "modkit.extensionRegistry": {
          "default": "",
          "markdownDescription": "Catalog file or HTTPS URL used by the extension manager. Opening the Extensions view reads only its local cache; the registry is contacted only by `Modkit: Refresh Extension Catalog`. `MODKIT_EXTENSION_REGISTRY` is used when this setting is empty. Remote catalogs also require an Ed25519 key map in `MODKIT_EXTENSION_TRUSTED_PUBLIC_KEYS`; remote artifact origins stay blocked unless listed in `MODKIT_EXTENSION_ALLOWED_ORIGINS`.",
          "type": "string"
        },
        "modkit.extensions": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            ]
          },
          "markdownDescription": "Extension directories to load beside the ones that ship with this build. Each item is either a path, or an object with `path`, an optional `id` the directory is expected to declare, and an optional `enabled` flag. Directories named here are loaded as installed artifacts and never run in the extension host process.",
          "type": "array"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "modkit.genericAssetPreview",
        "displayName": "Modkit Asset Preview",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "languages": [
      {
        "id": "galaxy",
        "aliases": [
          "SC2 Galaxy Script",
          "galaxy"
        ],
        "extensions": [
          ".galaxy"
        ]
      },
      {
        "id": "ini",
        "aliases": [
          "SC2 Hotkeys",
          "ini"
        ],
        "extensions": [
          ".SC2Hotkeys",
          ".sc2hotkeys"
        ]
      },
      {
        "id": "sc2layout",
        "aliases": [
          "SC2 Layout",
          "sc2layout"
        ],
        "extensions": [
          ".SC2Layout",
          ".sc2layout"
        ]
      },
      {
        "id": "sc2strings",
        "aliases": [
          "SC2 Localized Strings",
          "sc2strings"
        ],
        "filenamePatterns": [
          "**/LocalizedData/**/*.txt",
          "**/localizeddata/**/*.txt"
        ]
      },
      {
        "id": "sc2style",
        "aliases": [
          "SC2 Style",
          "sc2style"
        ],
        "extensions": [
          ".SC2Style",
          ".sc2style"
        ]
      },
      {
        "id": "xml",
        "aliases": [
          "SC2 XML",
          "xml"
        ],
        "extensions": [
          ".SC2Lighting",
          ".sc2lighting"
        ],
        "filenames": [
          "Attributes",
          "Objects",
          "Regions"
        ]
      }
    ],
    "views": {
      "modkit": [
        {
          "id": "modkit.extensions",
          "name": "Extensions"
        },
        {
          "id": "modkit.host",
          "name": "Host"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "modkit",
          "title": "Modkit",
          "icon": "media/icon-128.png"
        }
      ]
    }
  },
  "activationEvents": [
    "onCommand:modkit.addExtensionFolder",
    "onCommand:modkit.browseContainer",
    "onCommand:modkit.explainResolution",
    "onCommand:modkit.exportDiagnostics",
    "onCommand:modkit.extensions.disable",
    "onCommand:modkit.extensions.enable",
    "onCommand:modkit.extensions.install",
    "onCommand:modkit.extensions.refresh",
    "onCommand:modkit.extensions.remove",
    "onCommand:modkit.extensions.update",
    "onCommand:modkit.game.launchActiveMap",
    "onCommand:modkit.materializeContainerEntry",
    "onCommand:modkit.navigateResource",
    "onCommand:modkit.openArchiveEntry",
    "onCommand:modkit.openWith",
    "onCommand:modkit.refreshContainer",
    "onCommand:modkit.refreshRelations",
    "onCommand:modkit.runCommand",
    "onCommand:modkit.runtime.control",
    "onCommand:modkit.searchContainer",
    "onCommand:modkit.selectGameInstallation",
    "onCommand:modkit.showDiagnostics",
    "onCommand:modkit.showHostProfile",
    "onCommand:modkit.unloadSource",
    "onCustomEditor:modkit.genericAssetPreview",
    "onView:modkit.extensions",
    "onView:modkit.host",
    "onFileSystem:modkit-container"
  ],
  "icon": "media/icon-128.png"
}
