{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "modkit/text-slk",
  "displayName": "SYLK spreadsheet",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/slk/codec.js",
      "target": {
        "environments": [
          "node"
        ]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": [
        "read-source"
      ]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/slk/codec.js",
      "target": {
        "environments": [
          "browser-worker",
          "node-worker"
        ]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": [
        "read-source"
      ]
    }
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "slk",
        "label": "SYLK"
      }
    ],
    "roles": [
      "semantic"
    ],
    "sourceTopology": "single",
    "artifactStages": [
      "authored"
    ],
    "openIntents": [
      "probe",
      "inspect",
      "full",
      "stream",
      "export"
    ],
    "match": {
      "extensions": [
        "slk"
      ]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 8192
        }
      ],
      "maxBytes": 8192
    },
    "requires": [
      {
        "contract": "common.text-data/slk-syntax",
        "major": 1,
        "range": "^1.0.0"
      }
    ],
    "representations": [
      {
        "id": "syntax-document",
        "contract": "common.text-data/slk-document",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/table-data-source",
        "major": 1
      },
      {
        "contract": "common.view/text-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "none"
        ]
      },
      {
        "id": "asset.search",
        "handlerId": "search",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "bytes"
        ]
      },
      {
        "id": "data.parse",
        "handlerId": "parse",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      },
      {
        "id": "data.serialize",
        "handlerId": "serialize",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "bytes"
        ]
      },
      {
        "id": "data.scan",
        "handlerId": "scan",
        "mutatesSource": false,
        "requiredPermissions": [
          "read-source"
        ],
        "outputKinds": [
          "json"
        ]
      }
    ],
    "traitDeclarations": [
      {
        "id": "table.cells",
        "representation": "source",
        "presence": "will-expose"
      },
      {
        "id": "content.text",
        "representation": "source",
        "presence": "will-expose"
      },
      {
        "id": "content.binary",
        "representation": "source",
        "presence": "will-expose"
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 256,
      "maxNodes": 1000000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 10000
    }
  }
}
