{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/warzone-wz",
  "displayName": "Warzone 2100 package",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/warzone-wz/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/warzone-wz/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Warzone packages use the common bounded ZIP reader; stored and Deflate entries can be extracted in node and worker runtimes.",
    "Within one archive, repeated normalized paths expose the last physical entry; shadowed entries stay counted in diagnostics but are not exposed as effective files.",
    "Load-order precedence across multiple .wz packages remains a named VFS-overlay remainder.",
    "Classification reads the package's effective root ruleset.json before path and filename fallbacks.",
    "The separate preserving Save As writer can replace one existing game.map in a canonical classic ZIP-backed .wz; general package writing and ZIP64 remain unavailable."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "warzone-wz", "label": "Warzone 2100 package" }],
    "roles": ["container"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "extensions": ["wz"],
      "signatures": [
        { "from": "start", "offset": 0, "bytesHex": "504b0304" },
        { "from": "start", "offset": 0, "bytesHex": "504b0506" }
      ]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4 }], "maxBytes": 4 },
    "representations": [
      {
        "id": "archive-namespace",
        "contract": "common.archive/entry-namespace",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/namespace-entry-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      },
      {
        "id": "container.extract",
        "handlerId": "extract-entry",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
