{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/warzone-pie",
  "displayName": "Warzone 2100 PIE model",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/warzone-pie/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/warzone-pie/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Decodes PIE levels, polygon geometry, UV coordinates, logical texture references and structurally valid ANIMOBJECT records.",
    "ANIMOBJECT channels are published only when frame records are present and valid; polygon texture animation and directive counts are not reported as skeletal animation.",
    "Connector, event, shadow and material semantics remain named losses in the projection receipt.",
    "Warzone 3DO models are a named remainder and are not claimed by this contribution.",
    "PIE writing is not implemented."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "warzone-pie", "label": "Warzone 2100 PIE model" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "extensions": ["pie"],
      "signatures": [{ "from": "start", "offset": 0, "bytesHex": "50494520" }]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "decoded-model",
        "contract": "common.model/geometry-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": true
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/model-scene-source", "major": 1 },
      { "contract": "common.view/model-resource-refs-source", "major": 1 },
      { "contract": "common.view/model-animation-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "traitDeclarations": [
      { "id": "model.geometry", "representation": "source", "presence": "will-expose" },
      { "id": "model.textures", "representation": "source", "presence": "may-expose" },
      { "id": "model.animations", "representation": "source", "presence": "may-expose" },
      { "id": "structure.hierarchy", "representation": "source", "presence": "will-expose" },
      { "id": "content.text", "representation": "source", "presence": "will-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
