      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["filesystem-read"]
    },
    {
      "variantId": "node-worker-windows",
      "entrypoint": "./src/provider.js",
      "target": {
        "environments": ["node-worker"],
        "operatingSystems": ["windows"]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["filesystem-read", "process-launch"]
