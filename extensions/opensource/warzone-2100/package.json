{
  "name": "modkit-extension-x3-opensource-warzone-2100",
  "version": "0.1.0",
  "license": "GPL-2.0-or-later",
  "private": true,
  "type": "module",
  "description": "Warzone 2100 format contributions for MK3.",
  "exports": {
    ".": "./src/provider.js",
    "./pie": "./src/warzone-pie/codec.js",
    "./wz": "./src/warzone-wz/codec.js",
    "./data": "./src/data-provider.js",
    "./maps": "./src/map-provider.js",
    "./linked": "./src/linked.js",
    "./package.json": "./package.json"
  },
  "modkit": {
    "schemaVersion": 1,
    "publisher": "org.modkitx.opensource",
    "id": "warzone-2100",
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "dependencies": {
    "@modkitx-x3/codec-kit": "workspace:*",
    "modkit-extension-x3-archives": "workspace:*"
  },
  "peerDependencies": {
    "@modkitx-x3/host": "workspace:*",
    "@modkitx-x3/sdk": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@modkitx-x3/host": {
      "optional": true
    }
  }
}
