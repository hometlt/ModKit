{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/spring-unit-definition",
  "displayName": "Spring/Recoil bound unit definition",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/formats/spring-unit/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/formats/spring-unit/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Parses Lua unit definitions, COB headers/name tables and BOS source as bounded inert data; it never evaluates Lua or executes COB/BOS control flow.",
    "The host must bind the exact objectName and script paths. The codec receives only the selected AssetInput bindings and has no rapid pool or filesystem authority.",
    "Animation metadata is published only for explicit BOS Frame markers whose function exists in COB and whose target name exists in the BOS, COB and stable S3O piece tables.",
    "Compiled COB motion bytecode and Lua unit-script motion remain named remainders because extracting them honestly would require execution or a separately proven static representation.",
    "Spring 3DO, S3O writing, material semantics and non-empty collision records remain unsupported."
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "spring-unit-definition",
        "label": "Spring/Recoil unit definition with external model and script bindings"
      }
    ],
    "roles": ["semantic", "media"],
    "sourceTopology": "bundle",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "extensions": ["lua"],
      "pathGlobs": ["units/**/*.lua", "**/units/**/*.lua"]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [{ "from": "start", "length": 65536 }],
      "maxBytes": 65536
    },
    "representations": [
      {
        "id": "bound-unit-model",
        "contract": "common.model/geometry-metadata",
        "major": 1,
        "stage": "compiled",
        "lossy": true
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/model-scene-source", "major": 1 },
      { "contract": "common.view/model-animation-source", "major": 1 },
      { "contract": "common.view/model-resource-refs-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/relation-graph-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "traitDeclarations": [
      { "id": "model.geometry", "representation": "source", "presence": "will-expose" },
      { "id": "model.animations", "representation": "source", "presence": "may-expose" },
      { "id": "model.textures", "representation": "source", "presence": "may-expose" },
      { "id": "structure.hierarchy", "representation": "source", "presence": "will-expose" },
      { "id": "content.binary", "representation": "source", "presence": "will-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
