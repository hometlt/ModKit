{
  "name": "modkit-extension-x3-galaxy-language",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Reference MK3 Galaxy language-analysis provider.",
  "exports": {
    ".": "./src/provider.js",
    "./linked": "./src/linked.js",
    "./package.json": "./package.json"
  },
  "files": [
    "contributions",
    "src",
    "README.md"
  ],
  "modkit": {
    "schemaVersion": 1,
    "publisher": "org.modkitx.blizzard",
    "id": "galaxy-language",
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "peerDependencies": {
    "@modkitx-x3/host": "workspace:*",
    "@modkitx-x3/sdk": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@modkitx-x3/host": {
      "optional": true
    },
    "@modkitx-x3/sdk": {
      "optional": true
    }
  }
}
