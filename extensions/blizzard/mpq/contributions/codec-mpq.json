{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/mpq",
  "displayName": "Blizzard MPQ archive",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/mpq/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/mpq/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "The current compatibility runtime reaches the Node buffer module through the eager reader and writer, so browser environments are not declared.",
    "The source-native reader covers MPQ v0/v1 stored, zlib, and bzip2 single-unit or multi-sector payloads; v2+, high-offset tables, encrypted, implode, patch, and stored-sector CRC layouts remain explicit gates.",
    "Recovery is available through the eager reader, while the writer creates new archives and does not preserve every layout or compression feature of an input archive.",
    "The MK3 reader covers classic MPQ v0-v3 hash/block tables and stored or zlib payloads. One export-only provider creates fresh MPQ v0 archives and fixed-slot native-preserving Save As replacements for v0/v1; unused changed-slot bytes are zero-filled in the new copy, opaque attributes/signatures are retained but marked invalidated, while native-preserving v2/v3, changed encrypted, implode, bzip2, patch, sector-CRC, high-offset, signing and launch paths remain explicit named remainders."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "mpq", "label": "Blizzard MPQ archive" }],
    "roles": ["container"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "extensions": [
        "sc2mod",
        "sc2map",
        "sc2replay",
        "sc2campaign",
        "mpq",
        "s2ma",
        "s2mv",
        "w3m",
        "w3x",
        "w3n"
      ],
      "signatures": [
        { "from": "start", "offset": 0, "bytesHex": "4d50511a" },
        { "from": "start", "offset": 0, "bytesHex": "4d50511b" }
      ]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "archive-namespace",
        "contract": "common.archive/entry-namespace",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/namespace-entry-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      },
      {
        "id": "container.extract",
        "handlerId": "extract-entry",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
