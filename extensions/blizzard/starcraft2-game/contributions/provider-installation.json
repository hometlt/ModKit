{
  "schemaVersion": 1,
  "contract": {
    "id": "org.modkitx/service-provider-contribution",
    "major": 1
  },
  "id": "org.modkitx.blizzard/starcraft2-installation",
  "displayName": "StarCraft II installation discovery",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node-windows",
      "entrypoint": "./src/provider.js",
      "target": {
        "environments": ["node"],
        "operatingSystems": ["windows"]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["filesystem-read", "process-launch"]
    },
    {
      "variantId": "trusted-node-portable",
      "entrypoint": "./src/provider.js",
      "target": {
        "environments": ["node"],
        "operatingSystems": ["darwin", "linux"]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["filesystem-read"]
    },
    {
      "variantId": "node-worker-windows",
      "entrypoint": "./src/provider.js",
      "target": {
        "environments": ["node-worker"],
        "operatingSystems": ["windows"]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["filesystem-read", "process-launch"]
    },
    {
      "variantId": "node-worker-portable",
      "entrypoint": "./src/provider.js",
      "target": {
        "environments": ["node-worker"],
        "operatingSystems": ["darwin", "linux"]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["filesystem-read"]
    }
  ],
  "spec": {
    "provides": [
      {
        "offerId": "starcraft2-installation-v1",
        "contract": "common.game/installation-discovery",
        "major": 1,
        "version": "1.0.0",
        "facet": {
          "gameIds": ["org.modkitx/starcraft-2"]
        }
      }
    ],
    "lifecycleScope": "session"
  },
  "limitations": [
    "Automatic discovery is bounded to verified platform defaults and Windows uninstall-registry entries; it never recursively scans a drive.",
    "Steam and Epic manifest enumeration, launching, installation provisioning and content mounting are outside this provider."
  ]
}
