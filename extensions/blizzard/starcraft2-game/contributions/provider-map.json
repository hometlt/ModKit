{
  "schemaVersion": 1,
  "contract": {
    "id": "org.modkitx/service-provider-contribution",
    "major": 1
  },
  "id": "org.modkitx.blizzard/starcraft2-map-semantic",
  "displayName": "StarCraft II semantic map analysis",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/map-provider.js",
      "target": {
        "environments": ["node"]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": []
    },
    {
      "variantId": "worker-portable",
      "entrypoint": "./src/map-provider.js",
      "target": {
        "environments": ["node-worker", "browser-worker"]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": []
    }
  ],
  "spec": {
    "provides": [
      {
        "offerId": "starcraft2-map-semantic-v1",
        "contract": "common.map/semantic-analysis",
        "major": 1,
        "version": "1.0.0",
        "facet": {
          "gameIds": ["org.modkitx/starcraft-2"]
        }
      }
    ],
    "lifecycleScope": "session"
  },
  "limitations": [
    "The bounded slice opens placed objects, regions and HMAP terrain summaries; other map internals remain raw and outside this contract.",
    "Container extraction, localization, trigger semantics, rendering, launch, writing and packing are intentionally excluded.",
    "Placed units bind only to resolved Unit catalog entities supplied by the caller; catalog discovery is explicit through catalogQueries."
  ]
}
