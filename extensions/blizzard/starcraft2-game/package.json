{
  "name": "modkit-extension-x3-starcraft2-game",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "StarCraft II installation, workspace, catalog and semantic map providers for MK3.",
  "exports": {
    ".": "./src/provider.js",
    "./workspace": "./src/workspace-provider.js",
    "./data": "./src/data-provider.js",
    "./maps": "./src/map-provider.js",
    "./map-preview": "./src/map-preview-provider.js",
    "./linked": "./src/linked.js",
    "./package.json": "./package.json"
  },
  "files": [
    "contributions",
    "src",
    "README.md"
  ],
  "modkit": {
    "schemaVersion": 1,
    "publisher": "org.modkitx.blizzard",
    "id": "starcraft2-game",
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "dependencies": {
    "@rgrove/parse-xml": "^4.2.3"
  },
  "peerDependencies": {
    "@modkitx-x3/host": "workspace:*",
    "@modkitx-x3/sdk": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@modkitx-x3/host": {
      "optional": true
    }
  }
}
