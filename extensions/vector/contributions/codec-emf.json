{
  "schemaVersion": 1,
  "contract": { "id": "modkit/codec-contribution", "major": 1 },
  "id": "modkit/emf",
  "displayName": "Windows Enhanced Metafile",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/emf/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/emf/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Parses bounded EMR_HEADER/EMR_RECTANGLE/EMR_EOF streams, validates declared sizes and record counts, and replays rectangles to a static script-free SVG vector scene.",
    "Other GDI records, fonts, paths, transforms, clipping, embedded bitmaps, rasterization, editing, and metafile writing are not implemented."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "emf", "label": "Windows Enhanced Metafile" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "extensions": ["emf"],
      "signatures": [{ "from": "start", "offset": 40, "bytesHex": "20454d46" }]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "vector-scene",
        "contract": "common.vector/scene-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/vector-scene-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
