{
  "name": "modkit-extension-images",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Isolated MK3 image codecs.",
  "exports": {
    ".": "./src/index.js",
    "./linked": "./src/linked.js",
    "./formats/png/codec": "./src/png/codec.js",
    "./formats/jpeg/codec": "./src/jpeg/codec.js",
    "./formats/*/codec": "./src/*/codec.js",
    "./formats/dds/compressed": "./src/dds/compressed.js",
    "./formats/dds/encode": "./src/dds/encode.js",
    "./writers/png-encoder": "./src/writers/png-encoder.js",
    "./writers/dds-encoder": "./src/writers/dds-encoder.js",
    "./package.json": "./package.json"
  },
  "files": [
    "contributions",
    "src",
    "vendor",
    "README.md"
  ],
  "modkit": {
    "schemaVersion": 1,
    "publisher": "modkit",
    "id": "images",
    "presentation": {
      "displayName": "Modkit Images",
      "description": "Isolated MK3 image codecs.",
      "vendor": {
        "id": "modkit",
        "displayName": "Modkit"
      }
    },
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "dependencies": {
    "@modkit/codec-kit": "workspace:*"
  },
  "peerDependencies": {
    "@modkit/host": "workspace:*",
    "@modkit/sdk": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@modkit/host": {
      "optional": true
    },
    "@modkit/sdk": {
      "optional": true
    }
  }
}
