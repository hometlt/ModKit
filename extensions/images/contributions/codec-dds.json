                "baseInput": {
                  "transform": "button-icon"
                },
                "fields": [
                  {
                    "key": "format",
                    "label": "Encoding",
                    "type": {
                      "kind": "enum",
                      "members": [
                        {
                          "id": "keep",
                          "label": "Keep the source encoding"
                        },
                        {
                          "id": "dxt1",
                          "label": "DXT1 / BC1 (binary alpha)"
                        },
                        {
                          "id": "dxt3",
                          "label": "DXT3 / BC2"
                        },
                        {
                          "id": "dxt5",
                          "label": "DXT5 / BC3"
                        },
                        {
                          "id": "rgba8",
                          "label": "Uncompressed RGBA8"
                        },
                        {
                          "id": "auto",
                          "label": "DXT5 if any texel is partially transparent, else DXT1"
                        }
                      ]
                    },
                    "inputPath": ["format"],
                    "initial": "dxt5"
                  },
                  {
                    "key": "framePercent",
                    "label": "Frame (fraction of the edge)",
                    "type": {
                      "kind": "number",
                      "min": 0,
                      "max": 0.45
                    },
                    "inputPath": ["options", "framePercent"],
                    "required": true,
                    "initial": 0.0390625
                  }
                ]
              },
              {
                "id": "dds-recompress",
                "label": "Change the DDS encoding",
                "summary": "Re-encodes the base surface; DXT1 is refused while any texel is partially transparent.",
                "baseInput": {
                  "transform": "recompress"
                },
                "fields": [
