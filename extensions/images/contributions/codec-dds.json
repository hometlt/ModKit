                "baseInput": {
                  "transform": "resize"
                },
                "fields": [
                  {
                    "key": "width",
                    "label": "Width",
                    "type": {
                      "kind": "number",
                      "integer": true,
                      "min": 1
                    },
                    "inputPath": ["width"],
                    "required": true,
                    "initial": 64
                  },
                  {
                    "key": "height",
                    "label": "Height",
                    "type": {
                      "kind": "number",
                      "integer": true,
                      "min": 1
                    },
                    "inputPath": ["height"],
                    "required": true,
                    "initial": 64
                  },
                  {
                    "key": "format",
                    "label": "Encoding",
                    "type": {
                      "kind": "enum",
                      "members": [
                        {
                          "id": "keep",
                          "label": "Keep the source encoding"
                        },
                        {
                          "id": "dxt1",
                          "label": "DXT1 / BC1 (binary alpha)"
                        },
                        {
                          "id": "dxt3",
                          "label": "DXT3 / BC2"
                        },
                        {
                          "id": "dxt5",
                          "label": "DXT5 / BC3"
                        },
                        {
                          "id": "rgba8",
                          "label": "Uncompressed RGBA8"
                        },
                        {
                          "id": "auto",
                          "label": "DXT5 if any texel is partially transparent, else DXT1"
                        }
                      ]
                    },
                    "inputPath": ["format"],
                    "initial": "keep"
                  }
                ]
              },
              {
