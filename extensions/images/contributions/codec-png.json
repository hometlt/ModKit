{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "modkit/image-png",
  "displayName": "PNG image",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/png/codec.js",
      "target": {
        "environments": ["node"]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source", "write-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/png/codec.js",
      "target": {
        "environments": ["browser-worker", "node-worker"]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source", "write-source"]
    }
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "png",
        "label": "PNG image",
        "mediaType": "image/png"
      }
    ],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "thumbnail", "full", "export"],
    "match": {
      "extensions": ["png"],
      "mediaTypes": ["image/png"],
      "signatures": [
        {
          "from": "start",
          "offset": 0,
          "bytesHex": "89504e470d0a1a0a"
        }
      ]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 32
        }
      ],
      "maxBytes": 32
    },
    "representations": [
      {
        "id": "raster-metadata",
        "contract": "common.image/raster-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/raster-image-source",
        "major": 1
      },
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      },
      {
        "id": "export.convert",
        "handlerId": "convert-rgba8",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      },
      {
        "id": "edit.field",
        "handlerId": "set-text",
        "mutatesSource": true,
        "requiredPermissions": ["read-source", "write-source"],
        "inputSchema": {
          "$ref": "modkit://image-png/edit-field.v1",
          "document": {
            "schemaVersion": 1,
            "forms": [
              {
                "id": "png-set-text",
                "label": "Set a PNG text field",
                "summary": "Sets or replaces one tEXt chunk; every other byte of the file is kept.",
                "binding": { "groupId": "png-text" },
                "fields": [
                  {
                    "key": "key",
                    "label": "Keyword",
                    "type": { "kind": "text", "pattern": "^[^\\u0000]{1,79}$" },
                    "inputPath": ["key"],
                    "required": true,
                    "initial": "Description",
                    "source": "entry-key",
                    "description": "1–79 Latin-1 characters, no NUL"
                  },
                  {
                    "key": "value",
                    "label": "Text",
                    "type": { "kind": "text" },
                    "inputPath": ["value"],
                    "initial": "set from the Modkit inspector",
                    "source": "entry-value",
                    "description": "Latin-1, no NUL"
                  }
                ]
              }
            ]
          }
        },
        "outputKinds": ["edit-plan"]
      }
    ],
    "traitDeclarations": [
      {
        "id": "image.raster",
        "representation": "source",
        "presence": "will-expose"
      },
      {
        "id": "image.channels",
        "representation": "source",
        "presence": "will-expose"
      },
      {
        "id": "image.palette",
        "representation": "source",
        "presence": "may-expose"
      },
      {
        "id": "image.frames",
        "representation": "source",
        "presence": "may-expose"
      },
      {
        "id": "content.binary",
        "representation": "source",
        "presence": "will-expose"
      }
    ],
    "implementationTier": {
      "claimed": 1
    },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
