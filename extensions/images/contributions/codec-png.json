{
  "schemaVersion": 1,
  "contract": {
    "id": "modkit/codec-contribution",
    "major": 1
  },
  "id": "modkit/image-png",
  "displayName": "PNG image",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/png/codec.js",
      "target": {
        "environments": ["node"]
      },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source", "write-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/png/codec.js",
      "target": {
        "environments": ["browser-worker", "node-worker"]
      },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source", "write-source"]
    }
  ],
  "spec": {
    "formatRefs": [
      {
        "formatId": "png",
        "label": "PNG image",
        "mediaType": "image/png"
      }
    ],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "thumbnail", "full", "export"],
    "match": {
      "extensions": ["png"],
      "mediaTypes": ["image/png"],
      "signatures": [
        {
          "from": "start",
          "offset": 0,
          "bytesHex": "89504e470d0a1a0a"
        }
      ]
    },
    "probe": {
      "kind": "bytes",
      "ranges": [
        {
          "from": "start",
          "length": 32
        }
      ],
      "maxBytes": 32
    },
    "representations": [
      {
        "id": "raster-metadata",
        "contract": "common.image/raster-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      {
        "contract": "common.view/raster-image-source",
        "major": 1
      },
      {
        "contract": "common.view/tree-data-source",
        "major": 1
      },
      {
        "contract": "common.view/byte-range-source",
        "major": 1
      }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      },
      {
        "id": "export.convert",
        "handlerId": "convert-rgba8",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"],
        "inputSchema": {
          "$ref": "modkit://images/png-export-convert.v1",
          "document": {
            "schemaVersion": 1,
            "forms": [
              {
                "id": "png",
                "label": "PNG",
                "summary": "Writes the base image as a PNG file.",
                "baseInput": {
                  "target": "png"
                },
                "fields": [],
                "writes": {
                  "format": {
                    "id": "png",
                    "label": "PNG"
                  },
                  "extension": ".png",
                  "mediaType": "image/png"
                }
              },
              {
                "id": "dds-dxt1",
                "label": "DDS · DXT1 / BC1 (binary alpha)",
                "summary": "Writes a DXT1 copy; refused while any texel is partially transparent.",
                "baseInput": {
                  "target": "dds",
                  "format": "dxt1"
                },
                "fields": [],
                "writes": {
                  "format": {
                    "id": "dds",
                    "label": "DDS"
                  },
                  "encoding": {
                    "id": "dxt1",
                    "label": "DXT1 / BC1 (binary alpha)"
                  },
                  "extension": ".dds",
                  "mediaType": "image/vnd-ms.dds"
                }
              },
              {
                "id": "dds-dxt3",
                "label": "DDS · DXT3 / BC2",
                "summary": "Writes a DXT3 copy.",
                "baseInput": {
                  "target": "dds",
                  "format": "dxt3"
                },
                "fields": [],
                "writes": {
                  "format": {
                    "id": "dds",
                    "label": "DDS"
                  },
                  "encoding": {
                    "id": "dxt3",
                    "label": "DXT3 / BC2"
                  },
                  "extension": ".dds",
                  "mediaType": "image/vnd-ms.dds"
                }
              },
              {
                "id": "dds-dxt5",
                "label": "DDS · DXT5 / BC3",
                "summary": "Writes a DXT5 copy.",
                "baseInput": {
                  "target": "dds",
                  "format": "dxt5"
                },
                "fields": [],
                "writes": {
                  "format": {
                    "id": "dds",
                    "label": "DDS"
                  },
                  "encoding": {
                    "id": "dxt5",
                    "label": "DXT5 / BC3"
                  },
                  "extension": ".dds",
                  "mediaType": "image/vnd-ms.dds"
                }
              },
              {
                "id": "dds-rgba8",
                "label": "DDS · Uncompressed RGBA8",
                "summary": "Writes an uncompressed copy.",
                "baseInput": {
                  "target": "dds",
                  "format": "rgba8"
                },
                "fields": [],
                "writes": {
                  "format": {
                    "id": "dds",
                    "label": "DDS"
                  },
                  "encoding": {
                    "id": "rgba8",
                    "label": "Uncompressed RGBA8"
                  },
                  "extension": ".dds",
                  "mediaType": "image/vnd-ms.dds"
                }
              },
              {
                "id": "dds-auto",
                "label": "DDS · Automatic",
                "summary": "DXT5 if any texel is partially transparent, else DXT1.",
                "baseInput": {
                  "target": "dds",
                  "format": "auto"
                },
                "fields": [],
                "writes": {
                  "format": {
                    "id": "dds",
                    "label": "DDS"
                  },
                  "encoding": {
                    "id": "auto",
                    "label": "Automatic"
                  },
                  "extension": ".dds",
                  "mediaType": "image/vnd-ms.dds"
                }
              },
              {
                "id": "dds-icon",
                "label": "DDS · Icon (DXT5)",
                "summary": "Writes a DXT5 DDS of a square icon smaller than 256 x 256.",
                "baseInput": {
                  "target": "dds",
                  "icon": true
                },
                "fields": [],
                "writes": {
                  "format": {
                    "id": "dds",
                    "label": "DDS"
                  },
                  "encoding": {
                    "id": "icon",
                    "label": "Icon (DXT5)"
                  },
                  "extension": ".dds",
                  "mediaType": "image/vnd-ms.dds"
                }
              }
            ]
          }
        }
      },
      {
        "id": "edit.field",
        "handlerId": "set-text",
        "mutatesSource": true,
        "requiredPermissions": ["read-source", "write-source"],
        "inputSchema": {
          "$ref": "modkit://image-png/edit-field.v1",
          "document": {
            "schemaVersion": 1,
            "forms": [
              {
                "id": "png-set-text",
                "label": "Set a PNG text field",
                "summary": "Sets or replaces one tEXt chunk; every other byte of the file is kept.",
                "binding": {
                  "groupId": "png-text"
                },
                "fields": [
                  {
                    "key": "key",
                    "label": "Keyword",
                    "type": {
                      "kind": "text",
                      "pattern": "^[^\\u0000]{1,79}$"
                    },
                    "inputPath": ["key"],
                    "required": true,
                    "initial": "Description",
                    "source": "entry-key",
                    "description": "1–79 Latin-1 characters, no NUL"
                  },
                  {
                    "key": "value",
                    "label": "Text",
                    "type": {
                      "kind": "text"
                    },
                    "inputPath": ["value"],
                    "initial": "set from the Modkit inspector",
                    "source": "entry-value",
                    "description": "Latin-1, no NUL"
                  }
                ]
              }
            ]
          }
        },
        "outputKinds": ["edit-plan"]
      },
      {
        "id": "edit.content",
        "handlerId": "transform",
        "mutatesSource": true,
        "requiredPermissions": ["read-source", "write-source"],
        "inputSchema": {
          "$ref": "modkit://images/raster-edit-content.v1",
          "document": {
            "schemaVersion": 1,
            "forms": [
              {
                "id": "raster-color-key",
                "label": "Make one colour transparent",
                "summary": "Every pixel within the tolerance of the colour becomes fully transparent.",
                "baseInput": {
                  "transform": "color-key"
                },
                "fields": [
                  {
                    "key": "r",
                    "label": "Red",
                    "type": {
                      "kind": "number",
                      "integer": true,
                      "min": 0,
                      "max": 255
                    },
                    "inputPath": ["target", "r"],
                    "required": true,
                    "initial": 255
                  },
                  {
                    "key": "g",
                    "label": "Green",
                    "type": {
                      "kind": "number",
                      "integer": true,
                      "min": 0,
                      "max": 255
                    },
                    "inputPath": ["target", "g"],
                    "required": true,
                    "initial": 0
                  },
                  {
                    "key": "b",
                    "label": "Blue",
                    "type": {
                      "kind": "number",
                      "integer": true,
                      "min": 0,
                      "max": 255
                    },
                    "inputPath": ["target", "b"],
                    "required": true,
                    "initial": 255
                  },
                  {
                    "key": "tolerance",
                    "label": "Tolerance",
                    "type": {
                      "kind": "number",
                      "integer": true,
                      "min": 0,
                      "max": 255
                    },
                    "inputPath": ["tolerance"],
                    "required": true,
                    "initial": 0
                  }
                ]
              },
              {
                "id": "raster-rounded-alpha",
                "label": "Round the alpha corners",
                "summary": "Cuts the corners to transparent.",
                "baseInput": {
                  "transform": "rounded-alpha"
                },
                "fields": [
                  {
                    "key": "radius",
                    "label": "Radius",
                    "type": {
                      "kind": "number",
                      "min": 0
                    },
                    "inputPath": ["radius"],
                    "required": true,
                    "initial": 8
                  }
                ]
              }
            ]
          }
        },
        "outputKinds": ["edit-plan"]
      }
    ],
    "traitDeclarations": [
      {
        "id": "image.raster",
        "representation": "source",
        "presence": "will-expose"
      },
      {
