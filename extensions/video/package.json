{
  "name": "modkit-extension-video",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Isolated MK3 MP4 and WebM inspection codecs.",
  "exports": {
    ".": "./src/index.js",
    "./linked": "./src/linked.js",
    "./formats/mp4/codec": "./src/mp4/codec.js",
    "./formats/webm/codec": "./src/webm/codec.js",
    "./formats/*/codec": "./src/*/codec.js",
    "./package.json": "./package.json",
    "./formats/ogv/encode": {
      "types": "./dist/ogv/encode.d.ts",
      "default": "./dist/ogv/encode.js"
    },
    "./media-encoders": {
      "types": "./dist/media-encoders.d.ts",
      "default": "./dist/media-encoders.js"
    }
  },
  "files": [
    "contributions",
    "src",
    "README.md",
    "dist"
  ],
  "modkit": {
    "schemaVersion": 1,
    "publisher": "modkit",
    "id": "video",
    "presentation": {
      "displayName": "Modkit Video",
      "description": "Isolated MK3 MP4 and WebM inspection codecs.",
      "vendor": {
        "id": "modkit",
        "displayName": "Modkit"
      }
    },
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "dependencies": {
    "@modkit/codec-kit": "workspace:*"
  },
  "peerDependencies": {
    "@modkit/host": "workspace:*",
    "@modkit/sdk": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@modkit/host": {
      "optional": true
    },
    "@modkit/sdk": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json"
  }
}
