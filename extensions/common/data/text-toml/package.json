{
  "name": "modkit-extension-x3-text-toml",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Independent MK3 TOML codec and syntax provider.",
  "exports": {
    ".": "./src/index.js",
    "./linked": "./src/linked.js",
    "./formats": "./src/formats/index.js",
    "./formats/toml/codec": "./src/formats/toml/codec.js",
    "./formats/toml/provider": "./src/formats/toml/provider.js",
    "./package.json": "./package.json"
  },
  "files": [
    "contributions",
    "src",
    "README.md"
  ],
  "modkit": {
    "schemaVersion": 1,
    "publisher": "org.modkitx",
    "id": "text-toml",
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "dependencies": {
    "@modkitx-x3/codec-kit": "workspace:*",
    "smol-toml": "^1.8.0"
  },
  "peerDependencies": {
    "@modkitx-x3/core": "workspace:*",
    "@modkitx-x3/host": "workspace:*",
    "@modkitx-x3/sdk": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@modkitx-x3/core": {
      "optional": true
    },
    "@modkitx-x3/host": {
      "optional": true
    },
    "@modkitx-x3/sdk": {
      "optional": true
    }
  }
}
