{
  "name": "modkit-extension-x3-text-json",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Independent MK3 JSON and JSONC codecs and syntax providers.",
  "exports": {
    ".": "./src/index.js",
    "./formats": "./src/formats/index.js",
    "./formats/json/codec": "./src/families/json/entrypoints/json-codec.js",
    "./formats/json/provider": "./src/families/json/entrypoints/json-provider.js",
    "./formats/jsonc/codec": "./src/families/json/entrypoints/jsonc-codec.js",
    "./formats/jsonc/provider": "./src/families/json/entrypoints/jsonc-provider.js",
    "./package.json": "./package.json"
  },
  "files": [
    "contributions",
    "src",
    "README.md"
  ],
  "modkit": {
    "schemaVersion": 1,
    "publisher": "org.modkitx",
    "id": "text-json",
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "dependencies": {
    "@modkitx-x3/codec-kit": "workspace:*",
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "@modkitx-x3/core": "workspace:*",
    "@modkitx-x3/host": "workspace:*",
    "@modkitx-x3/sdk": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@modkitx-x3/core": {
      "optional": true
    },
    "@modkitx-x3/host": {
      "optional": true
    },
    "@modkitx-x3/sdk": {
      "optional": true
    }
  }
}
