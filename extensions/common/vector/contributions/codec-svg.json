{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/vector-svg",
  "displayName": "SVG vector image",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/svg/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/svg/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "spec": {
    "formatRefs": [
      { "formatId": "svg", "label": "SVG vector image", "mediaType": "image/svg+xml" }
    ],
    "roles": ["media", "semantic"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": { "extensions": ["svg"], "mediaTypes": ["image/svg+xml"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "vector-scene",
        "contract": "common.vector/scene-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/vector-scene-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/text-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "traitDeclarations": [
      { "id": "vector.scene", "representation": "source", "presence": "will-expose" },
      { "id": "vector.paths", "representation": "source", "presence": "may-expose" },
      { "id": "vector.shapes", "representation": "source", "presence": "may-expose" },
      { "id": "vector.text", "representation": "source", "presence": "may-expose" },
      { "id": "vector.gradients", "representation": "source", "presence": "may-expose" },
      { "id": "structure.hierarchy", "representation": "source", "presence": "will-expose" },
      { "id": "content.text", "representation": "source", "presence": "will-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "268435456",
      "maxDepth": 256,
      "maxNodes": 1000000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 10000
    }
  }
}
