{
  "name": "modkit-extension-x3-text-data",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "External MK3 text-data codecs and replaceable syntax providers.",
  "exports": {
    ".": "./src/index.js",
    "./formats": "./src/formats/index.js",
    "./formats/*/codec": "./src/formats/*/codec.js",
    "./formats/*/provider": "./src/formats/*/provider.js",
    "./package.json": "./package.json"
  },
  "files": [
    "contributions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "modkit": {
    "schemaVersion": 1,
    "publisher": "org.modkitx",
    "id": "text-data",
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "dependencies": {
    "@rgrove/parse-xml": "^4.2.3",
    "jsonc-parser": "^3.3.1",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@modkitx-x3/core": "*",
    "@modkitx-x3/host": "*",
    "@modkitx-x3/sdk": "*"
  },
  "peerDependenciesMeta": {
    "@modkitx-x3/core": {
      "optional": true
    },
    "@modkitx-x3/host": {
      "optional": true
    },
    "@modkitx-x3/sdk": {
      "optional": true
    }
  }
}
