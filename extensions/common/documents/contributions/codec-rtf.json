{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/document-rtf",
  "displayName": "Rich Text Format",
  "runtimeVariants": [
    {
      "variantId": "portable",
      "entrypoint": "./src/formats/rtf/codec.js",
      "target": { "environments": ["browser-worker", "node", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "spec": {
    "formatRefs": [
      { "formatId": "rtf", "label": "Rich Text Format", "mediaType": "application/rtf" }
    ],
    "roles": ["semantic"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": { "extensions": ["rtf"], "mediaTypes": ["application/rtf", "text/rtf"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "flow-metadata",
        "contract": "common.document/flow-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "traitDeclarations": [
      { "id": "document.flow", "representation": "source", "presence": "will-expose" },
      { "id": "document.outline", "representation": "source", "presence": "may-expose" },
      { "id": "content.images", "representation": "source", "presence": "may-expose" },
      { "id": "structure.hierarchy", "representation": "source", "presence": "will-expose" },
      { "id": "content.binary", "representation": "source", "presence": "will-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "268435456",
      "maxDepth": 256,
      "maxNodes": 10000000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 10000
    }
  }
}
