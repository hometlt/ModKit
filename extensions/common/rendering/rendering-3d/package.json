{
  "name": "modkit-extension-x3-rendering-3d",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "description": "Optional headless and browser scene renderer providers for MK3.",
  "exports": {
    ".": "./src/headless.js",
    "./browser": "./src/browser.js",
    "./linked": "./src/linked.js",
    "./png": "./src/png.js",
    "./package.json": "./package.json"
  },
  "files": [
    "contributions",
    "src",
    "README.md"
  ],
  "modkit": {
    "schemaVersion": 1,
    "publisher": "org.modkitx",
    "id": "rendering-3d",
    "contributionManifests": [
      "./contributions/*.json"
    ]
  },
  "peerDependencies": {
    "@modkitx-x3/host": "workspace:*",
    "@modkitx-x3/sdk": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@modkitx-x3/host": {
      "optional": true
    },
    "@modkitx-x3/sdk": {
      "optional": true
    }
  }
}
