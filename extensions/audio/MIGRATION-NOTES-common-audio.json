{
  "$comment": "Historical migration notes for common audio formats. AAC, FLAC, M4A and WAV moved into the product audio package; MP3, Ogg and separate Opus routes are superseded by richer native MK3 contributions. This file is inert and outside the loader manifest glob.",
  "schemaVersion": 1,
  "source": {
    "repository": "modkit",
    "manifests": [
      "extensions/audio/codecs/aac/codec.manifest.json",
      "extensions/audio/codecs/flac/codec.manifest.json",
      "extensions/audio/codecs/m4a/codec.manifest.json",
      "extensions/audio/codecs/mp3/codec.manifest.json",
      "extensions/audio/codecs/ogg/codec.manifest.json",
      "extensions/audio/codecs/opus/codec.manifest.json",
      "extensions/audio/codecs/wav/codec.manifest.json"
    ]
  },
  "verdict": "mechanical",
  "codecs": {
    "modkit/aac": {
      "verdict": "mechanical",
      "lostPlanes": [],
      "contractGaps": [],
      "renames": [],
      "converterDefaults": [
        "operations:inspection-triple",
        "probe:bytes-4096",
        "representation:common.audio/stream-metadata",
        "variants:pair"
      ],
      "droppedOperations": ["audio.export", "audio.inspect"],
      "needsSignatures": false,
      "portState": "ported"
    },
    "modkit/flac": {
