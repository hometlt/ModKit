      "needsSignatures": false,
      "portState": "ported"
    },
    "modkit/m4a": {
      "verdict": "mechanical",
      "lostPlanes": [],
      "contractGaps": [],
      "renames": [],
      "converterDefaults": [
        "operations:inspection-triple",
        "probe:bytes-4096",
        "representation:common.audio/stream-metadata",
        "variants:pair"
