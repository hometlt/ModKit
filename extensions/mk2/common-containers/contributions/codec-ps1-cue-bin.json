{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/ps1-cue-bin",
  "displayName": "PlayStation CUE/BIN disc image",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/ps1-cue-bin/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["filesystem-read", "read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/ps1-cue-bin/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["filesystem-read", "read-source"]
    }
  ],
  "limitations": [
    "Opening a CUE requires every referenced disc payload as a sibling file; opening a BIN requires a sibling CUE.",
    "`.bin` is deliberately absent from match.extensions even though this codec opens BIN payloads. It is a generic extension — 7z, PE and xz payloads all ship as `.bin` — and as an extension match it shadows every other codec's content sniff. A BIN is claimed instead by the sibling-CUE check, which is a source-level detector rather than a header one.",
    "The v1 companions field names codec IDs rather than same-codec CUE/BIN sidecar path patterns, so these filesystem companions remain documented as runtime limitations.",
    "The current entrypoint resolves companions through a host filesystem path and delegates cooked data-track browsing to the ISO codec, so archive entries and browser hosts are not supported.",
    "Supported track modes are AUDIO, MODE1/2048, MODE1/2352, MODE2/2048, and MODE2/2352; the codec is read-only."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "ps1-cue-bin", "label": "PlayStation CUE/BIN disc image" }],
    "roles": ["container"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": { "extensions": ["cue"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "archive-namespace",
        "contract": "common.archive/entry-namespace",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/namespace-entry-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
