{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/warzone-wrf",
  "displayName": "Warzone 2100 resource list",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/warzone-wrf/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/warzone-wrf/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Read only. Writing a resource list back is not implemented.",
    "References are resolved to paths but not followed; whether the named file exists is the host's question.",
    "The resource type is reported exactly as written and is not interpreted. 29 types appear across the 77 lists in `base.wz` and `mp.wz`, led by `WAV` 474, `IMD` 354, `JAVASCRIPT` 107, `FLIC` 61, `PROX` 33, `TEXPAGE` 31, `STR_RES` 29; mapping each to a loader is the host's job.",
    "`directory` is resolved against a caller-supplied base, defaulting to empty. The engine's real base is whatever `resSetBaseDir` last set, which is VFS state this codec cannot see.",
    "A `/:`-prefixed directory replaces the base outright, matching `resParserSetDirectory`. Such a path is not present in any shipped list, so the branch is implemented from the source rather than confirmed against a file."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "warzone-wrf", "label": "Warzone 2100 resource list" }],
    "roles": ["semantic"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": { "extensions": ["wrf"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "flow-metadata",
        "contract": "common.document/flow-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/table-data-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
