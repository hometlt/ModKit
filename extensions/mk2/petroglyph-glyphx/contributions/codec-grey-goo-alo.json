{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/grey-goo-alo",
  "displayName": "Grey Goo Alamo ALO model",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/grey-goo-alo/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/grey-goo-alo/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "ALA animation clips and referenced DDS, TGA, and PNG textures are resolved as same-codec sidecars; the v1 companions field names codec IDs rather than same-codec path patterns.",
    "ALA is intentionally excluded from the manifest matcher because it is an animation sidecar rather than standalone preview geometry.",
    "Particle graphs are converted to deterministic textured preview emitters; exact game shader and particle-system execution is not implemented.",
    "The browser-main runtime uses the explicit fflate browser build through isolated detector and runtime leaves; browser-worker remains undeclared pending dedicated coverage."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "grey-goo-alo", "label": "Grey Goo Alamo ALO model" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "extensions": ["alo"],
      "signatures": [
        { "from": "start", "offset": 0, "bytesHex": "00150000" },
        { "from": "start", "offset": 0, "bytesHex": "00020000" },
        { "from": "start", "offset": 0, "bytesHex": "00040000" },
        { "from": "start", "offset": 0, "bytesHex": "00060000" }
      ]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "geometry-metadata",
        "contract": "common.model/geometry-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/model-scene-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
