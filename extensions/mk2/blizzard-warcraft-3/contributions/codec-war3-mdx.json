{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/war3-mdx",
  "displayName": "Warcraft III MDX/MDL",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/war3-mdx/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/war3-mdx/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Referenced BLP and DDS textures, including replaceable-texture paths, are preserved for higher-level asset resolution and image decoding rather than loaded by the model codec entrypoint.",
    "Native MDX and MDL generation helpers operate on the war3-model AST, but the registered ModelCodec has no RenderModel encoder; model.write and model.export are therefore not declared.",
    "The RenderModel conversion inventories attachments, events, collision shapes, cameras, and lights and previews particles and ribbons, but does not reproduce all Warcraft III engine event, sound, collision, and shader execution.",
    "The browser-main runtime uses the browser-safe war3-model ESM parser through isolated detector and runtime leaves; browser-worker remains undeclared pending dedicated coverage.",
    "The runtime entrypoint currently re-exports the historical war3 implementation path while package consumers migrate to folder-aligned ownership."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "war3-mdx", "label": "Warcraft III MDX/MDL" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": { "extensions": ["mdx", "mdl"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "geometry-metadata",
        "contract": "common.model/geometry-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/model-scene-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
