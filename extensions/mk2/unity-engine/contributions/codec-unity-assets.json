{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/unity-assets",
  "displayName": "Unity Serialized Assets",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/unity-assets/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/unity-assets/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Portable hosts can run the bounded serialized-header detector, but the current runtime reaches the Node-classified @modkitx/models-processing root while emitting virtual Unity mesh payloads.",
    "The Node byte codec parses Unity 5+ serialized layouts and emits virtual object payloads; unsupported classes remain available through metadata or raw fallbacks.",
    "External serialized dependencies and .resS/.ress/.resource ranges require host-provided companion resolution; the byte-only codec does not read the filesystem.",
    "Writing or repacking Unity serialized assets is not implemented."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "unity-assets", "label": "Unity Serialized Assets" }],
    "roles": ["container"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": { "extensions": ["assets", "asset"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "archive-namespace",
        "contract": "common.archive/entry-namespace",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/namespace-entry-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
