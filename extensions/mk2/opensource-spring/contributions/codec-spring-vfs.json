{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/spring-vfs",
  "displayName": "Spring archive VFS and load order",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/spring-vfs/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/spring-vfs/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "The portable MK3 port conservatively inventories core `modinfo.lua`/`mapinfo.lua` scalar and string-list fields; general Lua evaluation is not claimed.",
    "`.sd7` maps need the 7-Zip codec, whose WASM binary the host supplies; the node scanner reaches them through an `openers` hook and reports them as skipped when none is wired.",
    "`.sdd` directory packages are not scanned.",
    "A VFS read mode is an ordered list of sections. Spring's Lua mode-string letters are not mapped, because no source establishing which letter selects which section was available.",
    "The implicit base dependency is applied at resolution. The engine's own ArchiveCache22.lua records it for a menu package but not for a game or a map, so the point at which the engine injects it is not confirmed — only its effect is.",
    "VFS mounting, dependency resolution, archive scanning, and metadata writing remain outside this inspection codec."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "spring-vfs", "label": "Spring archive VFS and load order" }],
    "roles": ["container"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "pathGlobs": ["modinfo.lua", "mapinfo.lua", "**/modinfo.lua", "**/mapinfo.lua"]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "archive-namespace",
        "contract": "common.archive/entry-namespace",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/namespace-entry-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
