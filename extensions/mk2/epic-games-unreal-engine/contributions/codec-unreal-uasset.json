{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/unreal-uasset",
  "displayName": "Unreal Engine package model",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/unreal-uasset/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/unreal-uasset/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "The manifest matcher is extension-first so UEXP, UBULK, and USMAP sidecars remain discoverable; the runtime detector validates little-endian or byte-swapped Unreal package tags before root-package decoding.",
    "UEXP, UBULK, and USMAP dependencies are resolved as same-codec sidecars; the v1 companions field names codec IDs rather than same-codec path patterns.",
    "Raw/editor AnimSequence tracks are partially decoded; compressed animation and unversioned UE5 property mappings remain incomplete.",
    "UE5.1+ streamed geometry and Nanite/resource layouts remain diagnostic-only and are never guessed into render geometry."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "unreal-uasset", "label": "Unreal Engine package model" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": { "extensions": ["uasset", "uexp", "ubulk", "usmap"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "geometry-metadata",
        "contract": "common.model/geometry-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/model-scene-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
