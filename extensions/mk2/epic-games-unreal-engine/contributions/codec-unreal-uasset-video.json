{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/unreal-uasset-video",
  "displayName": "Unreal Engine Media Asset",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/unreal-uasset-video/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/unreal-uasset-video/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Reads little-endian versioned UE4 packages with inline BinkMediaPlayer or FileMediaSource exports and publishes embedded structurally valid RIFF/AVI bytes and stream metadata.",
    "External media paths plus embedded Bink, MP4, WebM, Ogg Theora, Smacker, ASF/WMV, FLV, MPEG, and SWF payloads are not implemented; frame decoding, remuxing, and transcoding remain out of scope.",
    "UEXP and UBULK sidecars, UE5 package-saved-hash and Zen layouts, unversioned properties, encryption, and package writing are not implemented.",
    "Runtime selection requires a supported media class name in the 4096-byte probe window, so unusually large package headers may require a future staged probe."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "unreal-uasset-video", "label": "Unreal Engine Media Asset" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "thumbnail", "full", "stream", "export"],
    "match": { "extensions": ["uasset"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "video-container",
        "contract": "common.video/container-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/video-media-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
