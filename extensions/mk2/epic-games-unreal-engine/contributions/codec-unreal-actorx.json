{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/unreal-actorx",
  "displayName": "Unreal ActorX",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/unreal-actorx/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/unreal-actorx/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "PSK and PSKX ACTRHEAD, PNTS0000, VTXW0000, FACE0000/FACE3200, MATT0000, REFSKELT and RAWWEIGHTS records are strictly framed and cross-references are validated.",
    "PSK geometry is expanded into a decoded triangle primitive with UVs and derived normals; material, skeleton and weight tables are inventoried without resolving texture sidecars.",
    "Standalone PSA BONENAMES, ANIMINFO and ANIMKEYS tables are structurally inspected, but animation tracks are not attached to a compatible mesh scene.",
    "Extended normals, vertex colors, morph targets, extra UV sets, CONFIG/PROPS/MAT/JSON sidecars and ActorX writing are not implemented."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "unreal-actorx", "label": "Unreal ActorX" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "extensions": ["psk", "pskx", "psa"],
      "signatures": [
        { "from": "start", "offset": 0, "bytesHex": "4143545248454144" },
        { "from": "start", "offset": 0, "bytesHex": "414e494d48454144" }
      ]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "geometry-metadata",
        "contract": "common.model/geometry-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/model-scene-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
