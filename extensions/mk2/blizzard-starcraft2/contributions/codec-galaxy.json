{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/galaxy",
  "displayName": "StarCraft II Galaxy Script",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/galaxy/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/galaxy/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "The dependency-free MK3 codec validates UTF-8 Galaxy source, balanced block structure, includes, and bounded function declarations while publishing the original text.",
    "Tokens, diagnostics, symbols, navigation, formatting, and refactoring belong to the separate language-provider contract; compilation and execution belong to the runtime contract."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "galaxy", "label": "StarCraft II Galaxy Script" }],
    "roles": ["semantic"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": { "extensions": ["galaxy"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "flow-metadata",
        "contract": "common.document/flow-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/text-data-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
