{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/emperor-rfh-rfd",
  "displayName": "Emperor RFH/RFD archive pair",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/emperor-rfh-rfd/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["filesystem-read", "read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/emperor-rfh-rfd/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["filesystem-read", "read-source"]
    }
  ],
  "limitations": [
    "Retail archives split the table and payload between sibling RFH and RFD files resolved from a host filesystem path.",
    "Declarative routing uses the .rfh/.rfd extensions because retail RFH tables begin with a variable name length rather than a fixed magic value.",
    "The byte-only embedded-RFD fixture layout is supported, but nested archive entries cannot resolve external sibling files.",
    "Only stored and the implemented deflate variants are decoded; writing is not implemented."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "emperor-rfh-rfd", "label": "Emperor RFH/RFD archive pair" }],
    "roles": ["container"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": { "extensions": ["rfh", "rfd"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "archive-namespace",
        "contract": "common.archive/entry-namespace",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/namespace-entry-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
