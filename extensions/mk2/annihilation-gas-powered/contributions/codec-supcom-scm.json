{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/supcom-scm",
  "displayName": "Supreme Commander SCM model",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/supcom-scm/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/supcom-scm/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "The dependency-free MK3 profile decodes SCM v5 positions, normals, primary UVs, triangle indices, bounds, names, INFO strings, and the authored bone hierarchy.",
    "Skin weights, secondary UVs, tangents, SCA animation sidecars, BP blueprint overrides, DDS texture resolution, rendering, and model writing remain unsupported."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "supcom-scm", "label": "Supreme Commander SCM model" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "extensions": ["scm"],
      "signatures": [{ "from": "start", "offset": 0, "bytesHex": "4d4f444c" }]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "geometry-metadata",
        "contract": "common.model/geometry-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": true
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/model-scene-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
