{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/cnc3-map",
  "displayName": "Command & Conquer 3 map",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/cnc3-map/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/cnc3-map/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Reads the `EAR\\u0000` wrapper, the chunk-name table, the chunk directory and `HeightMapData` dimensions. Chunk payloads other than `HeightMapData` are located but not decoded.",
    "The RefPack expander is injected by the caller so this codec stays free of the archive layer; `@modkitx/ext-ea-sage/big` supplies it.",
    "The `map.bin`/`map.manifest`/`map.relo`/`map.imp` compiled sidecars shipped beside every retail map are not read at all.",
    "Writing a map is not implemented."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "cnc3-map", "label": "Command & Conquer 3 map" }],
    "roles": ["semantic"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "extensions": ["map"],
      "signatures": [
        { "from": "start", "offset": 0, "bytesHex": "45415200" },
        { "from": "start", "offset": 0, "bytesHex": "436b4d70" }
      ]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "archive-namespace",
        "contract": "common.archive/entry-namespace",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/namespace-entry-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "traitDeclarations": [
      { "id": "container.entries", "representation": "source", "presence": "will-expose" },
      { "id": "game.map", "representation": "source", "presence": "may-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
