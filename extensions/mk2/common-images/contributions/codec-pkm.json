{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/pkm",
  "displayName": "PKM ETC Texture",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/pkm/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/pkm/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Read, compressed-block access, and RGBA8 software preview cover PKM 1.0 ETC1 plus Ericsson ETCPACK PKM 2.0 identifiers 0, 1, and 3-11; retired identifier 2 is rejected.",
    "Identifiers 9-11 are explicitly treated as Ericsson ETCPACK sRGB extensions; the standard PKM 2.0 table ends at identifier 8.",
    "The restrictive ETCPACK fixture license is not copied into this repository; deterministic family-wide RGBA hashes and container fuzzing are local evidence, while independent native-oracle certification remains external.",
    "Encoding and mip chains remain follow-up work; browser main-thread and module-worker software decode plus descriptor-driven WebGL/WebGPU upload are implemented."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "pkm", "label": "PKM ETC Texture" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "thumbnail", "full", "export"],
    "match": {
      "extensions": ["pkm"],
      "signatures": [
        { "from": "start", "offset": 0, "bytesHex": "504b4d203130" },
        { "from": "start", "offset": 0, "bytesHex": "504b4d203230" }
      ]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "raster-metadata",
        "contract": "common.image/raster-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/raster-image-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "traitDeclarations": [
      { "id": "image.compressed-blocks", "representation": "runtime", "presence": "will-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
