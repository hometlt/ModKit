{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/tiff",
  "displayName": "Tagged Image File Format",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/tiff/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/tiff/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "The local decoder supports selected stripped grayscale, RGB, RGBA, and palette images with no compression or PackBits; the portable tiff dependency provides a best-effort fallback for additional layouts.",
    "The runtime is conservatively exposed only to Node hosts because the external tiff fallback reaches Node code in the repository import graph; structural detection remains portable.",
    "Decode returns only the first page, and some planar, tiled, compressed, photometric, or uncommon sample layouts remain unsupported.",
    "Write emits a single-page, little-endian, uncompressed RGBA8 TIFF rather than preserving source tags or compression.",
    "Manifest v1 cannot express the legacy extension-or-either-endian-signature fallback without turning it into a conjunction; generated routing intentionally uses the extensions while the handwritten compatibility registry retains global structural sniffing."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "tiff", "label": "Tagged Image File Format" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "thumbnail", "full", "export"],
    "match": { "extensions": ["tif", "tiff"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "raster-metadata",
        "contract": "common.image/raster-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/raster-image-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
