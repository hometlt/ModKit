{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/gif",
  "displayName": "Graphics Interchange Format",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/gif/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/gif/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "The package codec inspects GIF frame metadata and writes a single-frame GIF but leaves pixel and animation decode to the host image pipeline.",
    "Full animation playback and timeline transport remain follow-up work.",
    "Manifest v1 cannot express the legacy extension-or-signature fallback without turning it into a conjunction; generated routing intentionally uses the extension while the handwritten compatibility registry retains global signature sniffing."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "gif", "label": "Graphics Interchange Format" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "thumbnail", "full", "export"],
    "match": {
      "extensions": ["gif"],
      "signatures": [{ "from": "start", "offset": 0, "bytesHex": "474946" }]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "raster-metadata",
        "contract": "common.image/raster-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/raster-image-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
