{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/figma",
  "displayName": "Figma file",
  "status": "partial",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/figma/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/figma/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Runtime detection recognizes the fig-kiwi signature and a conservative ZIP-container fallback; manifest prefiltering is extension-only because manifest v1 cannot express those alternatives.",
    "Kiwi records, pages, frames, components, constraints, text, paints, images, and prototypes are not decoded; rendering is a structural notice only.",
    "The codec does not call the Figma API, fetch remote resources, edit content, or write source files."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "figma", "label": "Figma file" }],
    "roles": ["semantic"],
    "sourceTopology": "single",
    "artifactStages": ["authored"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": { "extensions": ["fig"] },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "flow-metadata",
        "contract": "common.document/flow-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": false
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "traitDeclarations": [
      { "id": "content.binary", "representation": "source", "presence": "will-expose" },
      { "id": "content.metadata", "representation": "source", "presence": "will-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
