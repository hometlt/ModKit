{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/emperor-xbf",
  "displayName": "Emperor: Battle for Dune XBF model",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/emperor-xbf/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/emperor-xbf/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Decodes the recursive node hierarchy, local transforms, triangle geometry, normals and face UV coordinates from retail XBF version 1.",
    "Publishes native and FX material identities plus logical texture references; resolving them through paired RFH/RFD archives is not implemented, so every resource remains reference-only.",
    "Publishes the 25 native FX clip intervals and the nodes driven by transform or vertex-morph data, but does not expose the native key matrices or per-frame vertex samples.",
    "Particle texture sequences contribute named materials and resources; particle execution, FX events, prelight colours and smoothing groups have no admitted live facet and remain named losses in the projection receipt.",
    "Only XBF version 1 is accepted; other versions fail detection or parsing instead of being guessed.",
    "Model writing is not implemented."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "emperor-xbf", "label": "Emperor: Battle for Dune XBF model" }],
    "roles": ["media"],
    "sourceTopology": "single",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": {
      "extensions": ["xbf"],
      "signatures": [{ "from": "start", "offset": 0, "bytesHex": "01000000" }]
    },
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "geometry-metadata",
        "contract": "common.model/geometry-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": true
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/model-scene-source", "major": 1 },
      { "contract": "common.view/model-resource-refs-source", "major": 1 },
      { "contract": "common.view/model-animation-source", "major": 1 },
      { "contract": "common.view/model-material-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "traitDeclarations": [
      { "id": "model.geometry", "representation": "source", "presence": "will-expose" },
      { "id": "model.materials", "representation": "source", "presence": "may-expose" },
      { "id": "model.textures", "representation": "source", "presence": "may-expose" },
      { "id": "model.animations", "representation": "source", "presence": "may-expose" },
      { "id": "structure.hierarchy", "representation": "source", "presence": "will-expose" },
      { "id": "content.binary", "representation": "source", "presence": "will-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
