{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/sage-w3x",
  "displayName": "SAGE W3X XML model",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/sage-w3x/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/sage-w3x/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Decodes the supported MeshGeometry vertex, index, normal, and UV streams into bounded model-scene primitives while inventorying W3X containers, hierarchies, animations, textures, and includes.",
    "Animation tracks, hierarchy pivots, collision and FX semantics, includes, model parts, textures, and animation siblings are not resolved.",
    "W3X writing and game-specific FX shader execution are not implemented."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "sage-w3x", "label": "SAGE W3X XML model" }],
    "roles": ["media"],
    "sourceTopology": "bundle",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": { "extensions": ["w3x"] },
    "companions": [
      {
        "id": "hierarchy",
        "role": "skeleton",
        "required": false,
        "patterns": ["*.w3x"],
        "searchScopes": ["sibling-directory", "current-mount", "enclosing-container"]
      },
      {
        "id": "textures",
        "role": "texture",
        "required": false,
        "patterns": ["*.dds", "*.tga"],
        "searchScopes": ["sibling-directory", "current-mount", "enclosing-container"]
      }
    ],
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "geometry-metadata",
        "contract": "common.model/geometry-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": true
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/model-scene-source", "major": 1 },
      { "contract": "common.view/model-resource-refs-source", "major": 1 },
      { "contract": "common.view/model-skeleton-source", "major": 1 },
      { "contract": "common.view/model-collision-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "traitDeclarations": [
      { "id": "model.animations", "representation": "source", "presence": "may-expose" },
      { "id": "model.geometry", "representation": "source", "presence": "may-expose" },
      { "id": "model.materials", "representation": "source", "presence": "may-expose" },
      { "id": "model.skeleton", "representation": "source", "presence": "may-expose" },
      { "id": "model.textures", "representation": "source", "presence": "may-expose" },
      { "id": "structure.hierarchy", "representation": "source", "presence": "will-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
