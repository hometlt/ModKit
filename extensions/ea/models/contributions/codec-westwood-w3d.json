{
  "schemaVersion": 1,
  "contract": { "id": "org.modkitx/codec-contribution", "major": 1 },
  "id": "org.modkitx/westwood-w3d",
  "displayName": "Westwood W3D binary model",
  "status": "supported",
  "runtimeVariants": [
    {
      "variantId": "trusted-node",
      "entrypoint": "./src/westwood-w3d/codec.js",
      "target": { "environments": ["node"] },
      "executionProfile": "trusted-in-process",
      "requestedPermissionClasses": ["read-source"]
    },
    {
      "variantId": "portable",
      "entrypoint": "./src/westwood-w3d/codec.js",
      "target": { "environments": ["browser-worker", "node-worker"] },
      "executionProfile": "worker-brokered",
      "requestedPermissionClasses": ["read-source"]
    }
  ],
  "limitations": [
    "Decodes standard W3D mesh headers, vertices, normals, triangles, UV streams, material ids, and texture references into bounded model-scene primitives.",
    "Decodes the hierarchy pivot table into scene nodes, parenting each pivot by its own field, and reads the animation channels it understands into an animation count.",
    "Compressed animation chunks, particles, dazzles, and remaining geometry variants are not decoded; related W3D family files and DDS/TGA textures are not resolved.",
    "Protected or damaged payloads are not repaired; a bounded opaque tail after valid top-level chunks is reported but not interpreted.",
    "W3D writing is not implemented."
  ],
  "spec": {
    "formatRefs": [{ "formatId": "westwood-w3d", "label": "Westwood W3D binary model" }],
    "roles": ["media"],
    "sourceTopology": "bundle",
    "artifactStages": ["authored", "compiled", "runtime"],
    "openIntents": ["probe", "inspect", "full", "export"],
    "match": { "extensions": ["w3d"] },
    "companions": [
      {
        "id": "textures",
        "role": "texture",
        "required": false,
        "patterns": ["*.dds", "*.tga"],
        "searchScopes": ["sibling-directory", "current-mount", "enclosing-container"]
      }
    ],
    "probe": { "kind": "bytes", "ranges": [{ "from": "start", "length": 4096 }], "maxBytes": 4096 },
    "representations": [
      {
        "id": "geometry-metadata",
        "contract": "common.model/geometry-metadata",
        "major": 1,
        "stage": "authored",
        "lossy": true
      }
    ],
    "publishesDataSources": [
      { "contract": "common.view/model-scene-source", "major": 1 },
      { "contract": "common.view/model-resource-refs-source", "major": 1 },
      { "contract": "common.view/model-skeleton-source", "major": 1 },
      { "contract": "common.view/model-animation-source", "major": 1 },
      { "contract": "common.view/model-collision-source", "major": 1 },
      { "contract": "common.view/tree-data-source", "major": 1 },
      { "contract": "common.view/byte-range-source", "major": 1 }
    ],
    "operations": [
      {
        "id": "view.inspect",
        "handlerId": "inspect",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["json"]
      },
      {
        "id": "asset.validate",
        "handlerId": "validate",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["none"]
      },
      {
        "id": "export.raw",
        "handlerId": "export-raw",
        "mutatesSource": false,
        "requiredPermissions": ["read-source"],
        "outputKinds": ["bytes"]
      }
    ],
    "traitDeclarations": [
      { "id": "model.geometry", "representation": "source", "presence": "will-expose" },
      { "id": "model.textures", "representation": "source", "presence": "may-expose" },
      { "id": "model.skeleton", "representation": "source", "presence": "may-expose" },
      { "id": "model.animations", "representation": "source", "presence": "may-expose" },
      { "id": "structure.hierarchy", "representation": "source", "presence": "will-expose" },
      { "id": "content.binary", "representation": "source", "presence": "will-expose" }
    ],
    "implementationTier": { "claimed": 1 },
    "budgets": {
      "maxInputBytes": "1073741824",
      "maxDepth": 64,
      "maxNodes": 100000,
      "maxScalarBytes": 104857600,
      "maxDiagnostics": 1000
    }
  }
}
