{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Modkit Core: Build",
      "type": "shell",
      "command": "pnpm build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Modkit Core: PWA Server",
      "type": "shell",
      "command": "node scripts/debug/pwa-server.mjs --port 4173",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Modkit Core: Build",
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "modkit-pwa",
        "pattern": {
          "regexp": "^(debug-pwa: .*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^debug-pwa: starting",
          "endsPattern": "^debug-pwa: ready"
        }
      }
    },
    {
      "label": "Modkit Core: Build Electron Shell",
      "type": "shell",
      "command": "node apps/electron/scripts/build-app.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Modkit Core: Build",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Modkit Core: Build VS Code Extension",
      "type": "shell",
      "command": "node apps/vscode/scripts/build-extension.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "Modkit Core: Build",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Modkit Core: Application Matrix",
      "type": "shell",
      "command": "pnpm apps:check",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Modkit Core: Full Check",
      "type": "shell",
      "command": "pnpm check",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
