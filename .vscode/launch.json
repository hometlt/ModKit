{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Modkit Core: Automation Host Adapter",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug/app-runner.mjs",
      "args": ["--app", "automation", "--set", "${input:extensionSet}", "--stay-open"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Modkit Core: Build",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/**/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Modkit Core: Server Adapter",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug/app-runner.mjs",
      "args": ["--app", "server", "--set", "${input:extensionSet}", "--stay-open"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Modkit Core: Build",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/**/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Modkit Core: CLI",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/cli/dist/main.js",
      "args": ["${input:cliAction}", "--json"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Modkit Core: Build",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/cli/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Modkit Core: MCP Server (stdio)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/mcp/dist/main.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Modkit Core: Build",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/mcp/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"],
      "env": {
        "MODKIT_MCP_ROOTS": "${workspaceFolder}"
      }
    },
    {
      "name": "Modkit Core: PWA (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:4173/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Modkit Core: PWA Server",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///*": "${webRoot}/*",
        "../*": "${webRoot}/*"
      }
    },
    {
      "name": "Modkit Core: Electron App (real window)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/apps/electron/node_modules/electron/cli.js",
      "args": ["${workspaceFolder}/apps/electron/electron/main.cjs"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Modkit Core: Build Electron Shell",
      "console": "internalConsole",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/apps/electron/dist*/**/*.js"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Modkit Core: VS Code Extension (Extension Host)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--user-data-dir=${workspaceFolder}/../.vscode-modkit/user-data",
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"
      ],
      "preLaunchTask": "Modkit Core: Build VS Code Extension",
      "outFiles": ["${workspaceFolder}/apps/vscode/dist-app/**/*.cjs"]
    },
    {
      "name": "Modkit Core: VS Code Language Services Only",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extensions",
        "--user-data-dir=${workspaceFolder}/../.vscode-modkit/language-user-data",
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode"
      ],
      "env": {
        "MODKIT_VSCODE_LANGUAGE_ONLY": "1",
        "MODKIT_VSCODE_LANGUAGE_EXTENSIONS": "${workspaceFolder}/../modkit-extensions-blizzard|${workspaceFolder}/../modkit-extensions-warzone"
      },
      "preLaunchTask": "Modkit Core: Build VS Code Extension",
      "outFiles": ["${workspaceFolder}/apps/vscode/dist-app/**/*.cjs"]
    },
    {
      "name": "Modkit Core: Web Composition (Node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/debug/app-runner.mjs",
      "args": ["--app", "web", "--set", "${input:extensionSet}", "--stay-open"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Modkit Core: Build",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/**/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    }
  ],
  "inputs": [
    {
      "id": "cliAction",
      "type": "pickString",
      "description": "Side-effect-free CLI command to debug",
      "default": "host-profile",
      "options": ["host-profile", "commands"]
    },
    {
      "id": "extensionSet",
      "type": "pickString",
      "description": "Extension set to load",
      "default": "structured-text",
      "options": [
        "structured-text",
        "documents",
        "media",
        "models-and-archives",
        "editor-and-documents",
        "full-codecs"
      ]
    }
  ]
}
