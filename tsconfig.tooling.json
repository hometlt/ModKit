{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [
    "scripts/test/**/*.ts",
    "vitest.config.ts",
    "packages/*/test/**/*.ts",
    "apps/*/test/**/*.ts"
  ],
  "exclude": ["scripts/test/fixtures/**"]
}
