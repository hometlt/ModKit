{
  // Typechecks the tooling layer (gate regression tests, vitest config) without emitting.
  // Package sources get their own composite tsconfigs from X3-S0.2 on.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["scripts/test/**/*.ts", "vitest.config.ts"],
  "exclude": ["scripts/test/fixtures/**"]
}
