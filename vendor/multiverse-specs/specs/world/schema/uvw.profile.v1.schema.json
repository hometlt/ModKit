{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modkitx.dev/specs/world/uvw.profile.v1.schema.json",
  "title": "UVW profile, version 1",
  "$comment": "The graph envelope over the candidate: a world is spaces plus connections. Each space carries ONE primitive topology; the candidate document body (basis/bounds/layers) becomes the body of one heightfield space, so a candidate document is exactly a profile document with a single space and no connections. Connections are RESERVED at zero entries in this version: SC2 and Warzone need none, and minting connection schemas before a publisher exists is the lie the world-interchange registry note forbids. The connection amendment (portal/seam with affine mappings, scale, wrap, dynamic anchors) is designed in ../../design/DESIGN_UVW_TOPOLOGIES.md and lifts maxItems when the first consumer lands. Modkit migrates its UVW writer from the candidate to this profile in GA wave 4; until then both schemas are current, candidate marked superseded-by.",
  "type": "object",
  "additionalProperties": false,
  "required": ["uv", "spaces", "connections"],
  "properties": {
    "$comment": {
      "description": "Free commentary; never semantic.",
      "type": "string"
    },
    "uv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "version", "status"],
      "properties": {
        "format": { "const": "UVW" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "status": { "const": "profile" }
      }
    },
    "spaces": {
      "$comment": "At least one. Space ids must be unique — uniqueness across objects is a composition check, not expressible here. Ordering is canonical by id; the graph has no privileged first space, a viewer picks an entry space by convention (lowest id) unless a package says otherwise.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/space" }
    },
    "connections": {
      "$comment": "RESERVED: zero entries in profile v1. The amendment defines portal (point anchors, pass rules, affine mapping incl. scale) and seam (boundary gluing incl. self-seams for wrap) and lifts this cap.",
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection"],
      "description": "Optional authored game-view preset in the space's UVW frame. A preset is not a camera object, node transform, gameplay constraint or default lens inferred by the viewer.",
      "properties": {
        "projection": { "enum": ["orthographic", "perspective"] },
        "azimuthDegrees": { "type": "number", "description": "Eye direction from target, seen from above: +X toward +Z. Finite authored degrees are retained without wrapping." },
        "elevationDegrees": { "type": "number", "minimum": 0, "maximum": 90 },
        "fieldOfViewDegrees": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 },
        "drawDistance": { "type": "number", "exclusiveMinimum": 0, "description": "Distance in space basis units; metres when the space is metre-normalized. No physical scale is inferred for source-unit spaces." }
      },
      "allOf": [{ "if": { "required": ["fieldOfViewDegrees"] }, "then": { "properties": { "projection": { "const": "perspective" } } } }]
    },
    "playerSlot": {
      "type": "integer",
      "minimum": -2147483648,
      "maximum": 2147483647,
      "description": "Authored native slot, never a private Runtime handle. Zero and negative neutral slots are not rewritten."
    },
    "linearRgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "address"],
      "properties": {
        "slot": { "$ref": "#/$defs/playerSlot" },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "description": "Explicit global portable player identity; the canonical strref codec bounds UTF-8 bytes. No inferred namespace or numeric handle."
        },
        "name": { "type": "string", "minLength": 1 },
        "color": { "$ref": "#/$defs/linearRgb" },
        "ramp": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": { "$ref": "#/$defs/linearRgb" },
          "description": "Exact ordered linear RGB shades. A material override needs the complete material ramp length, never a generated gradient."
        }
      }
    },
    "playerTable": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/player" },
      "description": "Optional authoritative slot-to-address table. Slots and addresses are unique within a space; an empty table declares no players."
    },
    "startPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "position": { "$ref": "#/$defs/vec3" },
        "player": { "$ref": "#/$defs/playerSlot" }
      },
      "description": "Authored start in local coordinates. Optional player names a declared slot. No clipping, inferred height or automatic spawning."
    },
    "startPositions": {
      "type": "array",
      "maxItems": 65536,
      "items": { "$ref": "#/$defs/startPosition" },
      "description": "Start IDs are unique within the space; unassigned starts do not invent players."
    },
    "presentationTint": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "description": "Per-object RGB multiplication factors, default [1,1,1]. Not opacity or player color. Preserved through UVW conversion."
    },
    "presentationAnimation": {
      "type": "object",
      "required": [
        "name",
        "groups",
        "loop",
        "speed"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "loop": {
          "type": "boolean"
        },
        "speed": {
          "type": "number",
          "description": "Signed presentation-time multiplier; zero pauses."
        },
        "randomStart": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Explicit initial presentation clip request. Stable per-object visual phase does not consume gameplay RNG."
    },
    "space": {
      "$comment": "topology names the whole catalog so the day a publisher lands the name is already taken by the right thing (the candidate's own reservation pattern); only heightfield is admitted by this version — the oneOf below is the single gate to widen.",
      "type": "object",
      "required": ["id", "topology"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "topology": {
          "enum": ["heightfield", "tile-grid", "node-graph", "volume"]
        },
        "label": { "type": "string" }
      },
      "oneOf": [{ "$ref": "#/$defs/heightfieldSpace" }]
    },
    "heightfieldSpace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topology", "basis", "bounds", "layers"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "topology": { "const": "heightfield" },
        "label": { "type": "string" },
        "basis": { "$ref": "#/$defs/basis" },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "$ref": "#/$defs/vec3" },
            "max": { "$ref": "#/$defs/vec3" }
          }
        },
        "players": { "$ref": "#/$defs/playerTable" },
        "startPositions": { "$ref": "#/$defs/startPositions" },
        "camera": { "$ref": "#/$defs/camera" },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/layer" }
        }
      }
    },
    "basis": {
      "$comment": "Verbatim the candidate's ProjectionBasis: canonical frame pinned, only the unit story varies; source-unit forbids inventing a metre factor (SPEC_UV_COORDINATES section 2).",
      "type": "object",
      "additionalProperties": false,
      "required": ["handedness", "upAxis", "forwardAxis", "unit"],
      "properties": {
        "handedness": { "const": "right" },
        "upAxis": { "const": "y" },
        "forwardAxis": { "const": "+z" },
        "unit": { "enum": ["meter", "source-unit"] },
        "metersPerUnit": { "type": "number", "exclusiveMinimum": 0 },
        "sourceUnit": { "type": "string", "minLength": 1 },
        "unitsPerCell": { "type": "number", "exclusiveMinimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "unit": { "const": "source-unit" } },
            "required": ["unit"]
          },
          "then": {
            "required": ["sourceUnit"],
            "not": { "required": ["metersPerUnit"] }
          }
        }
      ]
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "layer": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "$comment": "Profile-v1 layer families. Every non-heightfield body carries schemaVersion 1.",
          "enum": [
            "heightfield",
            "terrain-materials",
            "cliffs",
            "water",
            "objects",
            "resources",
            "regions",
            "navigation",
            "traversal",
            "gateways",
            "lighting"
          ]
        },
        "label": { "type": "string" }
      },
      "oneOf": [
        { "$ref": "#/$defs/heightfieldLayer" },
        { "$ref": "#/$defs/terrainMaterialsLayer" },
        { "$ref": "#/$defs/cliffsLayer" },
        { "$ref": "#/$defs/waterLayer" },
        { "$ref": "#/$defs/objectsLayer" },
        { "$ref": "#/$defs/resourcesLayer" },
        { "$ref": "#/$defs/regionsLayer" },
        { "$ref": "#/$defs/navigationLayer" },
        { "$ref": "#/$defs/traversalLayer" },
        { "$ref": "#/$defs/gatewaysLayer" },
        { "$ref": "#/$defs/lightingLayer" }
      ]
    },
    "latticePolygons": {
      "description": "Absolute publisher polygons in parent-space horizontal coordinates: x is UVW X and y is UVW Z. Authored polygon/vertex order is retained; no object-local transform, clipping, bbox or collision inference. Omission means unknown; [] means known empty.",
      "type": "array",
      "maxItems": 1048576,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 1048576,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        }
      }
    },
    "objectLatticeCoverage": {
      "description": "Publisher-proven lattice annotations in the enclosing UVW space. Profile version 1.0 owns this wire vocabulary. This is not navigation or runtime collision State; omitted facts have no implied defaults.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {
          "description": "Neutral publisher classifications. Omitted is unknown; [] is a declared empty role set. Order is retained.",
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "resource",
              "destructible",
              "start"
            ]
          }
        },
        "resourceKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "description": "Exact source label, meaningful only within resourceKindScope. Never an implicit universal resource or lookup instruction."
        },
        "resourceKindScope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "description": "Exact gameId of the source resolved snapshot. The writer must receive this fact, never infer it from a map id, path or label. The standalone artifact preserves it; it grants no resource access."
        },
        "blocked": {
          "description": "Publisher-proven movement-blocking coverage; not an implicit Runtime navigation grant.",
          "$ref": "#/$defs/latticePolygons"
        },
        "noBuild": {
          "description": "Publisher-proven construction/placement exclusion coverage.",
          "$ref": "#/$defs/latticePolygons"
        },
        "vision": {
          "description": "Publisher-proven vision-blocking coverage.",
          "$ref": "#/$defs/latticePolygons"
        },
        "nearResources": {
          "description": "Publisher-proven resource-proximity coverage; no distance or radius is inferred.",
          "$ref": "#/$defs/latticePolygons"
        },
        "outline": {
          "description": "Publisher-proven display outline; never a substitute gameplay footprint.",
          "$ref": "#/$defs/latticePolygons"
        }
      },
      "dependentRequired": {
        "resourceKind": [
          "resourceKindScope"
        ],
        "resourceKindScope": [
          "resourceKind"
        ]
      }
    },
    "heightfieldCliffFaces": {
      "description": "Complete effective cliff-face classification of the parent heightfield quads. Listed cells are true and all other cells false; absence is unknown, [] is proven all-false. Unique canonical y-then-x cell order, x<columns-1, y<rows-1. No inference from native levels, slope or presentation meshes.",
      "type": "array",
      "maxItems": 1048576,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "heightfieldLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "columns",
        "rows",
        "cellSize",
        "origin",
        "samples"
      ],
      "properties": {
        "cliffFaces": { "$ref": "#/$defs/heightfieldCliffFaces" },
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "heightfield" },
        "label": { "type": "string" },
        "columns": { "type": "integer", "minimum": 2 },
        "rows": { "type": "integer", "minimum": 2 },
        "cellSize": { "type": "number", "exclusiveMinimum": 0 },
        "origin": { "$ref": "#/$defs/vec3" },
        "noDataValue": { "type": "number" },
        "samples": {
          "$comment": "row-major: `rows` arrays of `columns` numbers. Sample counts, not cell counts — the usual off-by-one.",
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "number" }
          }
        }
      }
    },
    "vec2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number" }
    },
    "vec4": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "uvScale": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "anyOf": [
          { "type": "number", "exclusiveMaximum": 0 },
          { "type": "number", "exclusiveMinimum": 0 }
        ]
      }
    },
    "localId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "numberGrid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "number" }
      }
    },
    "integerGrid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "integer", "minimum": 0 }
      }
    },
    "booleanGrid": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "boolean" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "kind": { "enum": ["uvm", "media"] },
        "uri": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "resourcesLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "kind", "resources"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/localId" },
        "kind": { "const": "resources" },
        "label": { "type": "string" },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },
    "uvTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "scale", "rotation"],
      "properties": {
        "offset": { "$ref": "#/$defs/vec2" },
        "scale": { "$ref": "#/$defs/uvScale" },
        "rotation": { "type": "number" }
      }
    },
    "terrainMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "label": { "type": "string" },
        "classification": { "type": "string" },
        "sourceIndex": { "type": "integer", "minimum": 0 },
        "atlas": { "$ref": "#/$defs/terrainAtlas" },
        "baseColorFactor": {
          "description": "glTF pbrMetallicRoughness.baseColorFactor semantics: linear, straight RGBA in [0,1]. Multiplies the linear base-color texture sample; without a base-color texture, this factor is the base color. Omission means [1,1,1,1]; this default is interpreted, never injected into canonical authored bytes. Alpha coverage is separate from terrain blend weights and does not itself select a transparency mode.",
          "$ref": "https://modkitx.org/gltf/2.0/material.profile.schema.json#/$defs/baseColorFactor"
        },
        "baseColorResourceId": { "$ref": "#/$defs/localId" },
        "normalResourceId": { "$ref": "#/$defs/localId" },
        "specularResourceId": { "$ref": "#/$defs/localId" },
        "uvTransform": { "$ref": "#/$defs/uvTransform" }
      }
    },
    "terrainAtlas": {
      "description": "Square base-colour tiles in this many rows. Image row/column zero is top left; columns = image width * rows / image height and must be integral. Pixel dimensions and tile columns are checked when the texture owner resolves the image, not guessed by composition.",
      "type": "object", "additionalProperties": false, "required": ["rows"],
      "properties": {
        "rows": { "type": "integer", "minimum": 1 },
        "tileTop": {
          "description": "The cell edge containing the selected tile's top image row: local-y-1 when absent, or local-y-0. These names match the common terrain SDK; local y is the space-local z coordinate. Omitted defaults are interpreted, never inserted into authored bytes.",
          "enum": ["local-y-1", "local-y-0"]
        }
      }
    },
    "terrainCornerUv": {
      "description": "Four finite cell-local UV pairs, at (0,0), (1,0), (1,1), (0,1). Replaces the sample uvTransform for presentation; any retained sample transform is inactive source data. Values may extend outside 0..1 for wrapping. The material transform applies afterward; glTF KHR_texture_transform remains material-local.",
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "$ref": "#/$defs/vec2" }
    },
    "terrainCornerAlpha": {
      "description": "Four linear coverage factors at cell corners (0,0), (1,0), (1,1), (0,1). Upper tile layers multiply their tile's own alpha by triangle-interpolated coverage. Absent means one at every corner. The first layer remains opaque; its authored factors are preserved inactive. No gameplay or traversal semantics.",
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "terrainTileLayer": {
      "type": "object", "additionalProperties": false, "required": ["materialId", "tile"],
      "properties": {
        "materialId": { "$ref": "#/$defs/localId" },
        "cornerAlpha": { "$ref": "#/$defs/terrainCornerAlpha" },
        "tile": {
          "type": "object", "additionalProperties": false, "required": ["column", "row"],
          "properties": {
            "column": { "type": "integer", "minimum": 0 },
            "row": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "materialWeight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materialId", "weight"],
      "properties": {
        "materialId": { "$ref": "#/$defs/localId" },
        "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "materialWeightGrid": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [{ "required": ["weights"] }, { "required": ["layers"] }],
          "properties": {
            "weights": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/materialWeight" }
            },
            "layers": {
              "description": "Authored bottom-to-top order: first tile opaque, subsequent tiles blend by their own alpha and optional cornerAlpha coverage. Replaces weights for drawing this sample; any retained weights remain source data, not additional blend passes. The material's atlas.tileTop selects the cell edge containing the tile's top row, local-y-1 when omitted. Do not sort or deduplicate this array.",
              "type": "array", "minItems": 1, "maxItems": 256,
              "items": { "$ref": "#/$defs/terrainTileLayer" }
            },
            "uvTransform": { "$ref": "#/$defs/uvTransform" },
            "cornerUv": { "$ref": "#/$defs/terrainCornerUv" }
          }
        }
      }
    },
    "terrainWeightRaster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "width",
        "height",
        "materialIds",
        "encoding",
        "normalization"
      ],
      "properties": {
        "resourceId": { "$ref": "#/$defs/localId" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "materialIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/localId" }
        },
        "encoding": { "const": "rgba8-unorm" },
        "normalization": { "const": "sum" }
      }
    },
    "terrainMaterialsLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "kind",
        "columns",
        "rows",
        "cellSize",
        "origin",
        "materials"
      ],
      "anyOf": [{ "required": ["samples"] }, { "required": ["weightRasters"] }],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/localId" },
        "kind": { "const": "terrain-materials" },
        "label": { "type": "string" },
        "columns": { "type": "integer", "minimum": 2 },
        "rows": { "type": "integer", "minimum": 2 },
        "cellSize": { "type": "number", "exclusiveMinimum": 0 },
        "origin": { "$ref": "#/$defs/vec3" },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/terrainMaterial" }
        },
        "samples": { "$ref": "#/$defs/materialWeightGrid" },
        "weightRasters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/terrainWeightRaster" }
        }
      }
    },
    "cliffsLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "kind",
        "columns",
        "rows",
        "cellSize",
        "origin",
        "levels",
        "authored"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/localId" },
        "kind": { "const": "cliffs" },
        "label": { "type": "string" },
        "columns": { "type": "integer", "minimum": 2 },
        "rows": { "type": "integer", "minimum": 2 },
        "cellSize": { "type": "number", "exclusiveMinimum": 0 },
        "origin": { "$ref": "#/$defs/vec3" },
        "levels": { "$ref": "#/$defs/integerGrid" },
        "authored": { "$ref": "#/$defs/booleanGrid" }
      }
    },
    "waterZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minimum", "maximum", "elevation"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "minimum": { "$ref": "#/$defs/vec2" },
        "maximum": { "$ref": "#/$defs/vec2" },
        "elevation": { "type": "number" },
        "materialId": { "$ref": "#/$defs/localId" }
      }
    },
    "waterMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "color"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "label": { "type": "string" },
        "classification": { "enum": ["water", "lava"] },
        "shorelineMode": { "enum": ["terrain-clipped", "zone"] },
        "color": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "baseColorResourceId": { "$ref": "#/$defs/localId" },
        "secondaryColorResourceId": { "$ref": "#/$defs/localId" },
        "uvScale": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "anyOf": [
              { "type": "number", "exclusiveMaximum": 0 },
              { "type": "number", "exclusiveMinimum": 0 }
            ]
          }
        },
        "scroll": { "$ref": "#/$defs/vec4" },
        "normalResourceId": { "$ref": "#/$defs/localId" },
        "colorFalloff": { "type": "number", "minimum": 0 },
        "specularity": { "type": "number", "minimum": 0 },
        "specularScale": { "type": "number", "minimum": 0 },
        "reflectivityPower": { "type": "number", "exclusiveMinimum": 0 },
        "causticsResourceId": { "$ref": "#/$defs/localId" },
        "causticsFrameResourceIds": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/localId" }
        },
        "causticsScale": { "$ref": "#/$defs/uvScale" },
        "causticsFramesPerSecond": { "type": "number", "minimum": 0 },
        "causticsFalloff": { "type": "number", "minimum": 0 },
        "receiveShadows": { "type": "boolean" }
      }
    },
    "waterLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "kind", "zones"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/localId" },
        "kind": { "const": "water" },
        "label": { "type": "string" },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/waterMaterial" }
        },
        "zones": { "type": "array", "items": { "$ref": "#/$defs/waterZone" } }
      }
    },
    "modelComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resourceId"],
      "dependentRequired": {
        "parentId": ["parentSocketId"],
        "parentSocketId": ["parentId"]
      },
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "resourceId": { "$ref": "#/$defs/localId" },
        "parentId": { "$ref": "#/$defs/localId" },
        "parentSocketId": { "$ref": "#/$defs/localId" },
        "rotation": { "$ref": "#/$defs/vec4" }
      }
    },
    "objectInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "objectKind",
        "position",
        "rotation",
        "scale",
        "resourceIds"
      ],
      "properties": {
        "latticeCoverage": { "$ref": "#/$defs/objectLatticeCoverage" },
        "id": {
          "$ref": "#/$defs/localId"
        },
        "objectKind": {
          "enum": [
            "unit",
            "structure",
            "feature",
            "doodad",
            "point",
            "camera"
          ]
        },
        "derivedFrom": {
          "description": "A presentation piece generated from the authored cliffs facet, not a second editable placement. A native map writer regenerates it from cliff data and must not also emit it as an authored doodad. Missing source cliff data is a conversion loss/refusal, never permission to invent it.",
          "const": "cliffs"
        },
        "position": {
          "$ref": "#/$defs/vec3"
        },
        "rotation": {
          "description": "Authored unit XYZW quaternion in the canonical space-local frame; presentationRotation never replaces it.",
          "$ref": "#/$defs/vec4"
        },
        "presentationRotation": {
          "description": "Optional absolute presentation unit XYZW quaternion in the same local frame as rotation. Draw, visual picking and culling use this quaternion when present, otherwise rotation; never multiply the two. Does not change authored facing, navigation or collision. Explicit identity/equal overrides remain authored data.",
          "$ref": "#/$defs/vec4"
        },
        "scale": {
          "$ref": "#/$defs/vec3"
        },
        "resourceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/localId"
          },
          "uniqueItems": true
        },
        "modelComponents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modelComponent"
          }
        },
        "typeId": {
          "type": "string"
        },
        "player": {
          "type": "integer"
        },
        "variation": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "presentationTint": {
          "$ref": "#/$defs/presentationTint"
        },
        "presentationAnimation": {
          "$ref": "#/$defs/presentationAnimation"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "derivedFrom"
            ]
          },
          "then": {
            "properties": {
              "objectKind": {
                "const": "doodad"
              }
            }
          }
        }
      ]
    },
    "objectsLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "kind", "instances"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/localId" },
        "kind": { "const": "objects" },
        "label": { "type": "string" },
        "instances": {
          "type": "array",
          "items": { "$ref": "#/$defs/objectInstance" }
        }
      }
    },
    "regionShape": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "center", "radius"],
          "properties": {
            "kind": { "const": "circle" },
            "center": { "$ref": "#/$defs/vec2" },
            "radius": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "minimum", "maximum"],
          "properties": {
            "kind": { "const": "rectangle" },
            "minimum": { "$ref": "#/$defs/vec2" },
            "maximum": { "$ref": "#/$defs/vec2" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "points"],
          "properties": {
            "kind": { "const": "polygon" },
            "points": {
              "type": "array",
              "minItems": 3,
              "items": { "$ref": "#/$defs/vec2" }
            }
          }
        }
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "shapes"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "name": { "type": "string" },
        "color": { "type": "string" },
        "shapes": {
          "type": "array",
          "items": { "$ref": "#/$defs/regionShape" }
        }
      }
    },
    "regionsLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "kind", "regions"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/localId" },
        "kind": { "const": "regions" },
        "label": { "type": "string" },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/region" } }
      }
    },
    "navigationLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "kind",
        "columns",
        "rows",
        "cellSize",
        "origin",
        "samples"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/localId" },
        "kind": { "const": "navigation" },
        "label": { "type": "string" },
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "cellSize": { "type": "number", "exclusiveMinimum": 0 },
        "origin": { "$ref": "#/$defs/vec3" },
        "samples": { "$ref": "#/$defs/integerGrid" }
      }
    },
    "traversalLayer": {
      "$comment": "Portable static cell traversal for one movement class. Each exits mask has bits 1=+x, 2=-x, 4=+z, 8=-z. One-way edges are valid; dynamic blockers are Runtime state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "kind", "classId", "columns", "rows", "cellSize", "origin", "walkable", "exits"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/localId" },
        "kind": { "const": "traversal" },
        "label": { "type": "string" },
        "classId": { "$ref": "#/$defs/localId" },
        "surfaceLayerId": { "$ref": "#/$defs/localId" },
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "cellSize": { "type": "number", "exclusiveMinimum": 0 },
        "origin": { "$ref": "#/$defs/vec3" },
        "walkable": { "$ref": "#/$defs/booleanGrid" },
        "exits": {
          "type": "array", "minItems": 1,
          "items": { "type": "array", "minItems": 1,
            "items": { "type": "integer", "minimum": 0, "maximum": 15 } }
        }
      }
    },
    "gatewaySegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "start": { "$ref": "#/$defs/vec2" },
        "end": { "$ref": "#/$defs/vec2" }
      }
    },
    "gatewaysLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "kind", "segments"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": { "$ref": "#/$defs/localId" },
        "kind": { "const": "gateways" },
        "label": { "type": "string" },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/gatewaySegment" }
        }
      }
    },
    "directionalLight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "direction",
        "color",
        "intensity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/localId"
        },
        "direction": {
          "$ref": "#/$defs/vec3"
        },
        "color": {
          "$ref": "#/$defs/vec3"
        },
        "intensity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "specularColor": {
          "$ref": "#/$defs/vec3"
        },
        "specularIntensity": {
          "type": "number"
        },
        "useAmbientOcclusion": {
          "type": "boolean"
        }
      }
    },
    "lightingLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "kind",
        "ambientColor",
        "ambientIntensity",
        "directional"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/localId"
        },
        "kind": {
          "const": "lighting"
        },
        "label": {
          "type": "string"
        },
        "model": {
          "enum": ["lit", "unlit"],
          "default": "lit",
          "description": "Initial presentation policy; unlit ignores ambient/directional light, shadows and highlights."
        },
        "unlitColor": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "number", "minimum": 0, "maximum": 1},
          "default": [1, 1, 1],
          "description": "Linear RGB multiplier in unlit, after texture color-space decoding. Omitted white is interpreted without rewriting bytes."
        },
        "ambientColor": {
          "$ref": "#/$defs/vec3"
        },
        "ambientIntensity": {
          "type": "number",
          "minimum": 0
        },
        "directional": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/directionalLight"
          }
        },
        "toneMapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "exposure",
            "whitePoint",
            "contrast"
          ],
          "properties": {
            "operator": {
              "enum": [
                "reinhard",
                "exponential",
                "logarithmic",
                "linear",
                "filmic"
              ]
            },
            "exposure": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "whitePoint": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "contrast": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "correctGamma": {
              "type": "boolean"
            },
            "colorization": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "inputLow",
                "inputHigh",
                "inputGamma",
                "outputLow",
                "outputHigh",
                "brightness",
                "contrast",
                "hue",
                "saturation",
                "lightness",
                "blend"
              ],
              "properties": {
                "inputLow": {
                  "type": "number"
                },
                "inputHigh": {
                  "type": "number"
                },
                "inputGamma": {
                  "type": "number"
                },
                "outputLow": {
                  "type": "number"
                },
                "outputHigh": {
                  "type": "number"
                },
                "brightness": {
                  "type": "number"
                },
                "contrast": {
                  "type": "number"
                },
                "hue": {
                  "type": "number"
                },
                "saturation": {
                  "type": "number"
                },
                "lightness": {
                  "type": "number"
                },
                "blend": {
                  "type": "number"
                }
              }
            },
            "ambientOcclusion": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "radius",
                "noOcclusion",
                "fullOcclusion",
                "power"
              ],
              "properties": {
                "radius": {
                  "type": "number"
                },
                "noOcclusion": {
                  "type": "number"
                },
                "fullOcclusion": {
                  "type": "number"
                },
                "power": {
                  "type": "number"
                }
              }
            }
          }
        },
        "terrain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "specularExponent",
            "diffuseMultiplier",
            "specularMultiplier"
          ],
          "properties": {
            "specularExponent": {
              "type": "number"
            },
            "diffuseMultiplier": {
              "type": "number"
            },
            "specularMultiplier": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
