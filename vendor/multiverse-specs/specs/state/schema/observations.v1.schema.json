{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modkitx.org/state/1.0/observations.schema.json",
  "title": "Imported observations",
  "description": "Native replay observations without a fabricated kernel, seed or executable command journal. Missing fields and missing subjects carry no deletion semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "source", "clock", "observations", "observationsDigest"],
  "properties": {
    "$comment": { "type": "string" },
    "kind": { "const": "uv.observations" },
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["game", "format", "artifactDigest"],
      "properties": {
        "game": { "$ref": "#/$defs/name" },
        "format": { "$ref": "#/$defs/name" },
        "artifactDigest": { "$ref": "#/$defs/digest" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "clock": {
      "type": "object", "additionalProperties": false,
      "required": ["domain"],
      "properties": {
        "domain": { "$ref": "#/$defs/name" },
        "ticksPerSecond": {
          "type": "object", "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": { "$ref": "#/$defs/positiveInteger" },
            "denominator": { "$ref": "#/$defs/positiveInteger" }
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["tick", "sequence", "sourceEventId", "coverage", "subject", "action"],
        "properties": {
          "tick": { "$ref": "#/$defs/nonnegativeInteger" },
          "sequence": { "type": "integer", "minimum": 0 },
          "sourceEventId": { "$ref": "#/$defs/name" },
          "coverage": { "enum": ["partial", "complete-subject"] },
          "subject": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": { "enum": ["entity", "player", "world"] },
              "id": { "$ref": "#/$defs/name" },
              "generation": { "$ref": "#/$defs/nonnegativeInteger" }
            },
            "allOf": [
              { "if": { "properties": { "kind": { "const": "entity" } }, "required": ["kind"] },
                "then": { "required": ["generation"] },
                "else": { "not": { "required": ["generation"] } } }
            ]
          },
          "action": { "enum": ["fields", "remove"] },
          "fields": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "value"],
              "properties": {
                "path": { "$ref": "#/$defs/name" },
                "value": {}
              }
            }
          }
        },
        "allOf": [
          { "if": { "properties": { "action": { "const": "fields" } }, "required": ["action"] },
            "then": { "required": ["fields"] },
            "else": { "not": { "required": ["fields"] } } },
          { "if": { "properties": { "action": { "const": "remove" } }, "required": ["action"] },
            "then": { "properties": { "subject": { "properties": { "kind": { "const": "entity" } } } } } }
        ]
      }
    },
    "observationsDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "nonnegativeInteger": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "positiveInteger": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
