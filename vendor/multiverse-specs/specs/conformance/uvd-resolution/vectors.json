      "note": "a typed reference to a definition nobody ships is refused by name"
    },
    {
      "id": "tombstone-inherited/accept",
      "expect": "accept",
      "layers": [
        {
          "id": "base",
          "documents": [
            "kindSchema",
            {
              "uv": {
                "format": "UVD",
                "version": "1.0"
              },
              "namespace": "v",
              "role": "definitions",
              "definitions": [
                {
                  "name": "trooper",
                  "kind": "unit",
                  "kindVersion": 1,
                  "fields": {
                    "health": 1,
                    "speed": 5
                  }
                },
                {
                  "name": "elite",
                  "kind": "unit",
                  "kindVersion": 1,
                  "parent": "v/unit/trooper",
                  "fields": {
                    "health": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "mod",
          "documents": [
            {
              "uv": {
                "format": "UVD",
                "version": "1.0"
              },
              "namespace": "m",
              "role": "overlay",
              "overlays": [
                {
                  "target": "v/unit/trooper",
                  "op": "remove",
                  "field": "speed"
                }
              ]
            }
          ]
        }
      ],
      "checks": [
        {
          "def": "v/unit/elite",
          "field": "health",
          "value": 2,
          "layer": "base"
        }
      ],
      "absent": [
        {
          "def": "v/unit/elite",
          "field": "speed"
        }
      ],
      "note": "an ancestor's tombstone is inherited as absence: the elite has no speed after the mod removed it from the trooper"
    },
    {
      "id": "append-after-inherited-remove/accept",
      "expect": "accept",
      "layers": [
        {
          "id": "base",
          "documents": [
            "kindSchema",
            {
              "uv": {
                "format": "UVD",
                "version": "1.0"
              },
              "namespace": "v",
              "role": "definitions",
              "definitions": [
                {
                  "name": "trooper",
                  "kind": "unit",
                  "kindVersion": 1,
                  "fields": {
                    "health": 1,
                    "tags": [
                      "a"
                    ]
                  }
                },
                {
                  "name": "elite",
                  "kind": "unit",
                  "kindVersion": 1,
                  "parent": "v/unit/trooper",
                  "fields": {
                    "health": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "mod",
          "documents": [
            {
              "uv": {
                "format": "UVD",
                "version": "1.0"
              },
              "namespace": "m",
              "role": "overlay",
              "overlays": [
                {
                  "target": "v/unit/trooper",
                  "op": "remove",
                  "field": "tags"
                },
                {
                  "target": "v/unit/elite",
                  "op": "append",
                  "field": "tags",
                  "value": "b"
                }
              ]
            }
          ]
        }
      ],
      "checks": [
        {
          "def": "v/unit/elite",
          "field": "tags",
          "value": [
            "b"
          ],
          "layer": "mod"
        }
      ],
      "note": "append on a definition whose inherited list was removed starts from an empty list — a typed rule, not a TypeError"
    },
    {
      "id": "kind-version-mismatch/reject",
      "expect": "reject",
      "rule": "kind-version-mismatch",
      "layers": [
        {
          "id": "base",
          "documents": [
            "kindSchema",
            {
              "uv": {
                "format": "UVD",
                "version": "1.0"
              },
              "namespace": "v",
              "role": "definitions",
              "definitions": [
                {
                  "name": "trooper",
                  "kind": "unit",
                  "kindVersion": 9,
                  "fields": {
                    "health": 1
                  }
                }
              ]
            }
          ]
        }
      ],
      "note": "kindVersion is checked against the kind-schema, not merely required"
    },
    {
      "id": "duplicate-kind/reject",
      "expect": "reject",
      "rule": "duplicate-kind",
      "layers": [
        {
          "id": "base",
          "documents": [
            "kindSchema"
          ]
        },
        {
          "id": "mod",
          "documents": [
            "kindSchema"
          ]
        }
      ],
      "note": "a later layer redefining a kind is refused by name; kind-schema extension by mods is a future amendment, not an accident"
    },
    {
      "id": "append-to-non-list/reject",
      "expect": "reject",
      "rule": "append-to-non-list",
      "layers": [
        {
          "id": "base",
          "documents": [
            "kindSchema",
            {
              "uv": {
                "format": "UVD",
                "version": "1.0"
              },
              "namespace": "v",
              "role": "definitions",
              "definitions": [
                {
                  "name": "trooper",
