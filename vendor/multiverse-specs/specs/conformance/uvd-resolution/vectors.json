      "checks": [
        {
          "def": "v/unit/rifleman",
          "field": "alias",
          "value": "rifleman-glossary",
          "layer": "base",
          "via": "parent v/unit/ground"
        },
        {
          "def": "v/unit/ground",
          "field": "alias",
          "value": "ground-glossary",
          "layer": "base"
        }
      ],
      "note": "${self} binds late to the leaf being resolved — the SC2 ##id## token; provenance still names the setter"
    },
    {
