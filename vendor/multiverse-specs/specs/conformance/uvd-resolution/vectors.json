          "layer": "base",
          "via": "parent v/unit/template"
        }
      ],
      "expectDiagnostics": 1,
      "note": "${self} binds inside ref lists too, so a template can declare effect = ${self}-damage as a TYPED reference; the template itself resolves to v/weapon/template-damage, which does not exist — one honest diagnostic under diagnose"
    },
