      ],
      "note": "a mod reshapes values, not the shape"
    },
    {
      "id": "missing-reference/reject",
      "expect": "reject",
      "rule": "missing-reference",
      "layers": [
        {
          "id": "base",
          "documents": [
            "kindSchema",
            {
              "uv": {
                "format": "UVD",
                "version": "1.0"
              },
              "namespace": "v",
              "role": "definitions",
              "definitions": [
