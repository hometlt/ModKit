{
  "$comment": "EXECUTABLE definition-resolution vectors: uv-conformance.mjs runs them through tools/uv-composition.mjs resolveDefinitions. Layers carry inline UVD documents; the checks pin effective values AND provenance, because 'which layer set this' is half the contract. These execute the rules conformance/uvd/vectors.json declares; the real-corpus admission vector stays declared there.",
  "schemaVersion": "uv-conformance-vectors-1",
  "suite": "uvd-resolution",
  "spec": "../../data/SPEC_UVD.md",
  "kindSchema": {
    "uv": {
      "format": "UVD",
      "version": "1.0"
    },
    "namespace": "v",
    "role": "kind-schema",
    "kinds": [
      {
        "kind": "unit",
        "version": 1,
        "fields": [
          {
            "name": "health",
            "type": "fixed64",
            "required": true
          },
          {
            "name": "speed",
            "type": "fixed64"
          },
          {
            "name": "stance",
            "type": "enum",
            "values": [
              "aggressive",
              "defensive"
            ]
          },
          {
            "name": "weapon",
            "type": "ref",
            "refKind": "weapon"
          },
          {
            "name": "tags",
            "type": "list",
            "itemType": "string"
          }
        ]
      },
      {
        "kind": "weapon",
        "version": 1,
        "fields": [
          {
            "name": "damage",
            "type": "fixed64",
            "required": true
          }
        ]
      }
    ]
  },
  "vectors": [
    {
      "id": "nearest-setter-wins/accept",
      "expect": "accept",
      "layers": [
        {
          "id": "base",
          "documents": [
            "kindSchema",
            {
              "uv": {
                "format": "UVD",
                "version": "1.0"
              },
              "namespace": "v",
              "role": "definitions",
              "definitions": [
                {
                  "name": "trooper",
                  "kind": "unit",
                  "kindVersion": 1,
                  "fields": {
                    "health": 100000,
                    "speed": 2500,
                    "stance": "aggressive",
                    "tags": [
                      "infantry"
                    ]
                  }
                },
                {
                  "name": "elite",
                  "kind": "unit",
                  "kindVersion": 1,
                  "parent": "v/unit/trooper",
                  "fields": {
                    "health": 150000
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "mod",
          "documents": [
            {
              "uv": {
                "format": "UVD",
                "version": "1.0"
              },
              "namespace": "m",
              "role": "overlay",
              "overlays": [
                {
                  "target": "v/unit/trooper",
                  "op": "set",
                  "field": "health",
                  "value": 120000
                },
                {
                  "target": "v/unit/trooper",
                  "op": "append",
                  "field": "tags",
                  "value": "buffed"
                }
              ]
            }
          ]
        }
      ],
      "checks": [
        {
          "def": "v/unit/trooper",
          "field": "health",
          "value": 120000,
          "layer": "mod"
        },
        {
          "def": "v/unit/trooper",
          "field": "tags",
          "value": [
            "infantry",
            "buffed"
          ],
          "layer": "mod"
        },
        {
          "def": "v/unit/elite",
          "field": "health",
          "value": 150000,
          "layer": "base"
        },
        {
          "def": "v/unit/elite",
          "field": "speed",
          "value": 2500,
          "layer": "base",
          "via": "parent v/unit/trooper"
        },
        {
          "def": "v/unit/elite",
          "field": "tags",
          "value": [
            "infantry",
            "buffed"
          ],
          "layer": "mod",
          "via": "parent v/unit/trooper"
        }
      ],
      "note": "effective value = nearest setting layer, else nearest ancestor; the elite inherits the MOD-buffed trooper tags because inheritance reads effective values, not base ones"
    },
    {
      "id": "no-parent-cycles/reject",
      "expect": "reject",
      "rule": "no-parent-cycles",
      "layers": [
        {
          "id": "base",
          "documents": [
            "kindSchema",
            {
              "uv": {
                "format": "UVD",
                "version": "1.0"
              },
              "namespace": "v",
              "role": "definitions",
              "definitions": [
                {
                  "name": "a",
                  "kind": "unit",
                  "kindVersion": 1,
                  "parent": "v/unit/b",
                  "fields": {
                    "health": 1
                  }
                },
                {
                  "name": "b",
                  "kind": "unit",
                  "kindVersion": 1,
                  "parent": "v/unit/a",
                  "fields": {
                    "health": 1
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "fields-match-kind-schema/reject",
      "expect": "reject",
      "rule": "fields-match-kind-schema",
      "layers": [
