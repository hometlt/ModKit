    {
      "id": "self-binding/accept",
      "expect": "accept",
      "layers": [
        {
          "id": "base",
          "documents": [
            "kindSchemaExt",
            {
              "uv": {
                "format": "UVD",
                "version": "1.0"
              },
              "namespace": "v",
              "role": "definitions",
              "definitions": [
                {
                  "name": "ground",
                  "kind": "unit",
                  "kindVersion": 1,
                  "fields": {
                    "health": 1,
