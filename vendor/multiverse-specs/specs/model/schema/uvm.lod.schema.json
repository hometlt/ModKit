{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modkitx.org/uvm/incubating/uvm.lod.schema.json",
  "title": "MODKITX_lod_selection (incubating)",
  "description": "Provisional selection/hysteresis policy layered beside the unchanged official MSFT_lod topology. Wire name is not stable.",
  "type": "object",
  "required": ["levels"],
  "properties": {
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["node"],
        "properties": {
          "node": { "type": "integer", "minimum": 0 },
          "screenCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
          "maxDistance": { "type": "number", "minimum": 0 },
          "extras": {}
        },
        "anyOf": [{ "required": ["screenCoverage"] }, { "required": ["maxDistance"] }],
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "string",
      "enum": ["screen-coverage", "distance", "manual"],
      "default": "screen-coverage"
    },
    "hysteresis": { "type": "number", "minimum": 0, "default": 0.1 },
    "extras": {}
  },
  "additionalProperties": false
}
