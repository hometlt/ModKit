{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modkitx.org/uvm/1.0/uvm.animation.schema.json",
  "title": "UVM animation extensions",
  "description": "UV_game_animation_clips and UV_game_animation_events attach to a glTF animation; KHR_animation_pointer attaches to an animation channel target. UV_animation_layers attaches to the document root.",
  "$defs": {
    "clips": {
      "$anchor": "clips",
      "title": "UV_game_animation_clips",
      "type": "object",
      "required": ["clip"],
      "properties": {
        "clip": {
          "type": "string",
          "description": "Canonical lower-case clip name.",
          "examples": ["stand", "walk", "run", "attack", "death", "birth", "work"]
        },
        "variant": {
          "type": "string"
        },
        "loop": {
          "type": "string",
          "enum": ["once", "loop", "ping-pong", "hold"],
          "default": "once"
        },
        "priority": {
          "type": "integer",
          "default": 0,
          "description": "Higher wins when several clips are eligible. StarCraft II selects sequences by priority."
        },
        "concurrent": {
          "type": "boolean",
          "default": false,
          "description": "May play simultaneously with other clips on disjoint bone sets."
        },
        "blendInSeconds": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "blendOutSeconds": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "speedScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "sourceFrameRate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sourceRange": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "sourceName": {
          "type": "string",
          "description": "Original sequence name verbatim, including spacing and zero-padding. Game data references this exact string."
        },
        "boneMask": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "extras": {}
      },
      "additionalProperties": false
    },
    "events": {
      "$anchor": "events",
      "title": "UV_game_animation_events",
      "type": "object",
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["t", "name"],
            "properties": {
              "t": {
                "type": "number",
                "minimum": 0,
                "description": "Seconds from clip start."
              },
              "name": {
                "type": "string",
                "anyOf": [
                  {
                    "enum": [
                      "fire_weapon",
                      "spawn_effect",
                      "sound",
                      "footstep",
                      "hit",
                      "damage_window_start",
                      "damage_window_end",
                      "spawn_object",
                      "detach_object",
                      "swap_variant",
                      "enable_collision",
                      "disable_collision",
                      "camera_shake",
                      "script"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "socket": {
                "type": "integer",
                "minimum": 0,
                "description": "Node index."
              },
              "payload": {
                "type": "object",
                "description": "Data only. Consumers MUST NOT evaluate payloads as code."
              },
              "duration": {
                "type": "number",
                "minimum": 0,
                "default": 0
              }
            },
            "additionalProperties": false
          }
        },
        "extras": {}
      },
      "additionalProperties": false
    },
    "layers": {
      "$anchor": "layers",
      "title": "UV_animation_layers",
      "type": "object",
      "required": ["layers"],
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": ["override", "additive"],
                "default": "override"
              },
              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 1
              },
              "boneMask": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "Joint node indices. Omitted means all joints."
              },
              "additiveReference": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "assignments": {
          "type": "object",
          "description": "Animation index (string key) to layer index. Unassigned animations use layer 0.",
          "patternProperties": {
            "^[0-9]+$": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "extras": {}
      },
      "additionalProperties": false
    },
    "uvAnimationMetadata": {
      "$anchor": "uvAnimationMetadata",
      "title": "UVM animation metadata",
      "description": "Private, lossless source-coordinate metadata stored at animation.extras.uv. Sequence animations carry sourceSequenceIndex. Absolute and global effect timelines carry effectTrackScope; a global timeline also carries globalSeqId.",
      "type": "object",
      "properties": {
        "sourceSequenceIndex": {
          "type": "integer",
          "minimum": 0
        },
        "sourceDurationSeconds": {
          "type": "number",
          "minimum": 0
        },
        "looping": {
          "type": "boolean"
        },
        "priority": {
          "type": "number"
        },
        "effectTrackScope": {
          "type": "string",
          "enum": ["global", "absolute"]
        },
        "globalSeqId": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effectTrackScope": {
                "const": "global"
              }
            },
            "required": ["effectTrackScope"]
          },
          "then": {
            "required": ["globalSeqId"]
          }
        },
        {
          "if": {
            "properties": {
              "effectTrackScope": {
                "const": "absolute"
              }
            },
            "required": ["effectTrackScope"]
          },
          "then": {
            "not": {
              "required": ["globalSeqId"]
            }
          }
        },
        {
          "if": {
            "required": ["globalSeqId"]
          },
          "then": {
            "properties": {
              "effectTrackScope": {
                "const": "global"
              }
            },
            "required": ["effectTrackScope"]
          }
        }
      ],
      "additionalProperties": false
    },
    "uvChannelMetadata": {
      "$anchor": "uvChannelMetadata",
      "title": "UVM animation channel metadata",
      "description": "Lossless source interpolation and independent-timeline metadata for TRS and pointer channels, stored at animation.channel.extras.uv. Values are 0=step, 1=linear, 2=Hermite and 3=Bezier. M3 concurrent STCs set concurrent=true and carry their positive wrap duration in seconds; global TRS channels carry globalSeqId.",
      "type": "object",
      "required": ["sourceLineType"],
      "properties": {
        "sourceLineType": {
          "type": "integer",
          "enum": [0, 1, 2, 3]
        },
        "concurrent": {
          "const": true
        },
        "wrapSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "globalSeqId": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["concurrent"]
          },
          "then": {
            "required": ["wrapSeconds"]
          }
        },
        {
          "if": {
            "required": ["wrapSeconds"]
          },
          "then": {
            "required": ["concurrent"]
          }
        }
      ],
      "additionalProperties": false
    },
    "properties": {
      "$anchor": "properties",
      "title": "KHR_animation_pointer",
      "description": "Official Khronos animation channel target payload. The containing target uses path `pointer`; this object supplies the RFC 6901 pointer.",
      "type": "object",
      "required": ["pointer"],
      "properties": {
        "pointer": {
          "type": "string",
          "pattern": "^/",
          "description": "JSON Pointer (RFC 6901). MUST resolve within the document and MUST NOT point into /buffers, /bufferViews, /accessors or /extensions/UV_source_blob.",
          "examples": [
            "/extensions/UV_game_effects/particles/0/emissionRate",
            "/materials/2/extensions/UV_game_material/layers/3/scroll"
          ]
        },
        "extras": {}
      },
      "additionalProperties": false
    }
  }
}
