{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modkitx.org/uvm/1.0/uvm.provenance.schema.json",
  "title": "UV_provenance",
  "description": "Source identity, conversion history, and explicit loss diagnostics. Native source bytes are never embedded in UVM.",
  "$defs": {
    "axes": {
      "type": "object",
      "required": [
        "up",
        "forward",
        "handedness"
      ],
      "properties": {
        "up": {
          "$ref": "#/$defs/axis"
        },
        "forward": {
          "$ref": "#/$defs/axis"
        },
        "handedness": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        }
      },
      "additionalProperties": false
    },
    "axis": {
      "type": "string",
      "enum": [
        "+x",
        "-x",
        "+y",
        "-y",
        "+z",
        "-z"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "type": "string",
          "examples": [
            "m3",
            "mdx",
            "w3d",
            "s3o",
            "scm",
            "psk",
            "fbx"
          ]
        },
        "formatVersion": {
          "type": [
            "integer",
            "string"
          ]
        },
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceAxes": {
          "$ref": "#/$defs/axes"
        },
        "sourceUnits": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "$anchor": "provenance",
      "title": "UV_provenance",
      "type": "object",
      "required": [
        "source",
        "importer"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "importer": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "chain": {
          "type": "array",
          "description": "Prior conversions, oldest first. A multi-hop conversion records every hop.",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "$ref": "#/$defs/source"
              },
              "importer": {
                "type": "object"
              },
              "generatedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "lost": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "severity",
              "feature"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z0-9]+_[A-Z0-9_]+$",
                "description": "Stable identifier, never localised text.",
                "examples": [
                  "M3_PHYSICS_JOINT",
                  "W3D_AABTREE_DROPPED"
                ]
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "error"
                ],
                "description": "Build pipelines SHOULD fail on `error`."
              },
              "feature": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "detail": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "extras": {}
      },
      "additionalProperties": false
    }
  }
}
