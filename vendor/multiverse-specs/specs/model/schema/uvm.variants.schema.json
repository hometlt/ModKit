{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modkitx.org/uvm/1.0/uvm.variants.schema.json",
  "title": "UV_game_variants",
  "description": "Geometry, visibility and whole-asset variants. Runtime packages additionally require assetSha256 for every external asset URI.",
  "type": "object",
  "required": ["variants"],
  "properties": {
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "default": { "type": "boolean", "default": false },
          "showNodes": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "hideNodes": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "materialVariant": { "type": "integer", "minimum": 0 },
          "asset": { "type": "string", "minLength": 1 },
          "assetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "alignSocket": { "type": "string", "minLength": 1 },
          "effects": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
          "extras": {}
        },
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "trigger"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "trigger": { "type": "string", "minLength": 1 },
          "extras": {}
        },
        "additionalProperties": false
      }
    },
    "extras": {}
  },
  "additionalProperties": false
}
