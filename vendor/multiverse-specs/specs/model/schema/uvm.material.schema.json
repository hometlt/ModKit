{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modkitx.org/uvm/1.0/uvm.material.schema.json",
  "title": "UVM material extensions",
  "description": "UV_game_material_team_color and UV_game_material. Both attach to a glTF material's `extensions`. A conforming material ALWAYS carries a usable pbrMetallicRoughness block regardless of these.",
  "$defs": {
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "textureRef": {
      "type": "object",
      "required": [
        "index"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "glTF texture index."
        },
        "texCoord": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "channel": {
          "type": "string",
          "enum": [
            "r",
            "g",
            "b",
            "a",
            "rgb"
          ],
          "default": "a"
        },
        "extensions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "KHR_texture_transform": {
              "$ref": "https://modkitx.org/gltf/2.0/material.profile.schema.json#/$defs/textureTransform"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "teamColor": {
      "$anchor": "teamColor",
      "title": "UV_game_material_team_color",
      "type": "object",
      "required": [
        "maskSource"
      ],
      "properties": {
        "maskSource": {
          "type": "string",
          "enum": [
            "texture",
            "vertexColor",
            "paletteRange",
            "whole",
            "channelKey"
          ]
        },
        "maskTexture": {
          "$ref": "#/$defs/textureRef"
        },
        "range": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Palette index range, inclusive."
        },
        "vertexChannel": {
          "type": "string",
          "enum": [
            "r",
            "g",
            "b",
            "a"
          ],
          "default": "a"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "baseColor",
              "emissive",
              "specular"
            ]
          },
          "default": [
            "baseColor"
          ]
        },
        "blend": {
          "type": "string",
          "enum": [
            "multiply",
            "add",
            "replace",
            "overlay",
            "lerp"
          ],
          "default": "multiply"
        },
        "strength": {
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "defaultColor": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4,
          "default": [
            1,
            1,
            1,
            1
          ]
        },
        "glow": {
          "type": "object",
          "description": "Secondary emissive team mask (Warcraft 3 replaceable ID 2).",
          "properties": {
            "maskTexture": {
              "$ref": "#/$defs/textureRef"
            },
            "blend": {
              "type": "string",
              "enum": [
                "add",
                "multiply",
                "replace"
              ],
              "default": "add"
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "default": 1
            }
          },
          "additionalProperties": false
        },
        "extras": {},
        "keyChannels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "r",
              "g",
              "b"
            ]
          },
          "default": [
            "r",
            "g"
          ]
        },
        "keyThreshold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255,
          "default": 0,
          "description": "Maximum stored 8-bit channel value that matches channelKey, before sRGB conversion, filtering or mipmaps."
        },
        "intensityChannel": {
          "enum": [
            "r",
            "g",
            "b",
            "a"
          ],
          "default": "b",
          "description": "Data channel multiplying the replacement color; independent of binary key coverage."
        },
        "colorSource": {
          "enum": [
            "team",
            "object-tint"
          ],
          "default": "team"
        },
        "tint": {
          "enum": [
            "none",
            "mask-rgb"
          ],
          "default": "none"
        },
        "secondaryMaskTexture": {
          "$ref": "#/$defs/textureRef",
          "description": "Additional scalar coverage factor with independent UV set and KHR_texture_transform. Not the emissive glow mask."
        },
        "ramp": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/rgb"
          },
          "description": "Exact ordered N shades for paletteRange. N must equal inclusive range size. No generated gradient."
        },
        "paletteIndexScale": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 255,
          "description": "Integer index = round(mask data channel * scale); samples use nearest filtering. This is index data, not decoded palette RGB."
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "maskSource": {
                "const": "texture"
              }
            },
            "required": [
              "maskSource"
            ]
          },
          "then": {
            "required": [
              "maskTexture"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "maskSource": {
                "const": "paletteRange"
              }
            },
            "required": [
              "maskSource"
            ]
          },
          "then": {
            "required": [
              "range"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "maskSource": {
                "const": "channelKey"
              }
            },
            "required": [
              "maskSource"
            ]
          },
          "then": {
            "required": [
              "blend"
            ],
            "properties": {
              "blend": {
                "const": "replace"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "ramp"
            ]
          },
          "then": {
            "required": [
              "range",
              "maskTexture",
              "blend"
            ],
            "properties": {
              "maskSource": {
                "const": "paletteRange"
              },
              "blend": {
                "const": "replace"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tint"
            ],
            "properties": {
              "tint": {
                "const": "mask-rgb"
              }
            }
          },
          "then": {
            "required": [
              "maskTexture"
            ]
          }
        },
        {
          "if": {
            "required": [
              "keyChannels"
            ]
          },
          "then": {
            "properties": {
              "maskSource": {
                "const": "channelKey"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "keyThreshold"
            ]
          },
          "then": {
            "properties": {
              "maskSource": {
                "const": "channelKey"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "intensityChannel"
            ]
          },
          "then": {
            "properties": {
              "maskSource": {
                "const": "channelKey"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "paletteIndexScale"
            ]
          },
          "then": {
            "required": [
              "ramp"
            ]
          }
        }
      ]
    },
    "layer": {
      "type": "object",
      "required": ["slot"],
      "properties": {
        "slot": {
          "type": "string",
          "anyOf": [
            {
              "enum": [
                "diffuse",
                "normal",
                "specular",
                "emissive",
                "alpha",
                "ao",
                "height",
                "env",
                "decal",
                "caustics"
              ]
            },
            {
              "pattern": "^layer[0-9]+$"
            }
          ]
        },
        "texture": {
          "type": "integer",
          "minimum": 0
        },
        "frames": {
          "type": "array", "minItems": 1, "maxItems": 256,
          "items": { "type": "integer", "minimum": 0 },
          "description": "Ordered texture indices for a presentation-clock flipbook."
        },
        "framesPerSecond": { "type": "number", "minimum": 0 },
        "timeDomain": { "const": "presentation-seconds" },
        "channelPacking": { "const": "rg-ba-xy" },
        "uv": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "op": {
          "type": "string",
          "enum": ["modulate", "add", "blend", "replace", "subtract", "modulate2x", "lerp"],
          "default": "modulate"
        },
        "tiling": {
          "$ref": "#/$defs/vec2",
          "default": [1, 1]
        },
        "offset": {
          "$ref": "#/$defs/vec2",
          "default": [0, 0]
        },
        "scroll": {
          "$ref": "#/$defs/vec2",
          "default": [0, 0],
          "description": "UV units per second."
        },
        "rotation": {
          "type": "number",
          "default": 0
        },
        "invert": {
          "type": "boolean",
          "default": false
        },
        "channel": {
          "type": "string",
          "enum": ["r", "g", "b", "a", "rgb"]
        },
        "exponent": {
          "type": "number"
        },
        "strength": {
          "type": "number",
          "default": 1
        },
        "wrap": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["repeat", "clamp", "mirror"]
          },
          "minItems": 2,
          "maxItems": 2,
          "default": ["repeat", "repeat"]
        }
      },
      "additionalProperties": false,
      "allOf": [{
        "if": { "required": ["frames"] },
        "then": { "required": ["framesPerSecond", "timeDomain"] }
      }]
    },
    "vec2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "vec4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "type": "number" }
    },
    "nonzeroVec4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "anyOf": [
          { "type": "number", "exclusiveMaximum": 0 },
          { "type": "number", "exclusiveMinimum": 0 }
        ]
      }
    },
    "waterSurfaceParams": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "inputs", "surfaceCoordinateSystem", "timeDomain"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "inputs": { "const": ["world-position", "water-depth", "shadow"] },
        "surfaceCoordinateSystem": { "const": "world-xz" },
        "timeDomain": { "const": "presentation-seconds" },
        "surfaceUvScale": { "$ref": "#/$defs/nonzeroVec4" },
        "surfaceScroll": { "$ref": "#/$defs/vec4" },
        "colorFalloff": { "type": "number", "minimum": 0 },
        "specularity": { "type": "number", "minimum": 0 },
        "specularScale": { "type": "number", "minimum": 0 },
        "reflectivityPower": { "type": "number", "exclusiveMinimum": 0 },
        "causticsFalloff": { "type": "number", "minimum": 0 },
        "receiveShadows": { "type": "boolean" }
      }
    },
    "waterSurfaceLayer": {
      "allOf": [
        { "$ref": "#/$defs/layer" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["slot", "texture"],
          "properties": {
            "slot": { "enum": ["diffuse", "layer1", "normal", "caustics"] },
            "texture": { "type": "integer", "minimum": 0 },
            "op": { "enum": ["blend", "modulate", "add"] },
            "channelPacking": { "const": "rg-ba-xy" },
            "frames": { "type": "array", "minItems": 1, "maxItems": 256,
              "items": { "type": "integer", "minimum": 0 } },
            "framesPerSecond": { "type": "number", "minimum": 0 },
            "timeDomain": { "const": "presentation-seconds" },
            "tiling": { "$ref": "#/$defs/vec2" }
          },
          "allOf": [
            { "if": { "properties": { "slot": { "const": "normal" } }, "required": ["slot"] },
              "then": { "required": ["channelPacking"] } },
            { "if": { "properties": { "slot": { "const": "caustics" } }, "required": ["slot"] },
              "then": { "required": ["frames", "framesPerSecond", "timeDomain"] } },
            { "if": { "properties": { "slot": { "const": "layer1" } }, "required": ["slot"] },
              "then": { "required": ["op"] } }
          ]
        }
      ]
    },
    "gameMaterial": {
      "$anchor": "gameMaterial",
      "title": "UV_game_material",
      "type": "object",
      "description": "Existing shader-bearing materials, or a nonempty state-only packet containing only blendMode/depthWrite/sortPriority. Shaderless omitted fields inherit the base glTF material state; no shader or default bytes are injected.",
      "oneOf": [
        {
          "required": [
            "shader"
          ]
        },
        {
          "not": {
            "required": [
              "shader"
            ]
          },
          "propertyNames": {
            "enum": [
              "blendMode",
              "depthWrite",
              "sortPriority"
            ]
          },
          "anyOf": [
            {
              "required": [
                "blendMode"
              ]
            },
            {
              "required": [
                "depthWrite"
              ]
            },
            {
              "required": [
                "sortPriority"
              ]
            }
          ]
        }
      ],
      "dependentRequired": { "params": ["shader"] },
      "properties": {
        "shader": {
          "type": "string",
          "minLength": 1,
          "description": "Namespaced shader identity; scopes the `params` vocabulary.",
          "examples": ["sc2.standard", "mdx.layer", "w3d.vertex-material"]
        },
        "blendMode": {
          "type": "string",
          "enum": [
            "opaque",
            "alpha-blend",
            "alpha-test",
            "additive",
            "add-alpha",
            "modulate",
            "modulate2x",
            "alpha-key",
            "screen",
            "subtract"
          ],
          "default": "opaque"
        },
        "alphaCutoff": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        },
        "cull": {
          "type": "string",
          "enum": ["back", "front", "none"],
          "default": "back"
        },
        "depthTest": {
          "type": "boolean",
          "default": true
        },
        "depthWrite": {
          "type": "boolean",
          "default": true
        },
        "castShadows": {
          "type": "boolean", "default": true,
          "description": "Whether this material participates in shadow casting. Omission means true without injecting default bytes. Presentation only."
        },
        "receiveShadows": {
          "type": "boolean", "default": true,
          "description": "Whether this material receives shadows. Omission means true without injecting default bytes. False gates any shader-specific shadow reception, including water. Presentation only."
        },
        "sortPriority": {
          "type": "integer",
          "default": 0
        },
        "unshaded": {
          "type": "boolean",
          "default": false
        },
        "twoSidedNormals": {
          "type": "boolean",
          "default": false
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          },
          "default": []
        },
        "passes": {
          "type": "array",
          "description": "Multi-pass composite. When present, `layers` MUST still describe pass 0.",
          "items": {
            "type": "object",
            "properties": {
              "blendMode": {
                "$ref": "#/$defs/gameMaterial/properties/blendMode"
              },
              "layers": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/layer"
                }
              },
              "depthWrite": {
                "type": "boolean"
              },
              "cull": {
                "type": "string",
                "enum": ["back", "front", "none"]
              }
            },
            "additionalProperties": false
          }
        },
        "params": {
          "type": "object",
          "default": {}
        },
        "extras": {}
      },
      "additionalProperties": false,
      "allOf": [{
        "if": { "properties": { "shader": { "const": "uv.water.surface@1" } }, "required": ["shader"] },
        "then": {
          "required": ["layers", "params"],
          "properties": {
            "shader": { "const": "uv.water.surface@1" },
            "layers": { "type": "array", "items": { "$ref": "#/$defs/waterSurfaceLayer" } },
            "params": { "$ref": "#/$defs/waterSurfaceParams" }
          },
          "additionalProperties": false
        }
      }]
    }
  },
  "oneOf": [
    {
      "$ref": "#teamColor"
    },
    {
      "$ref": "#gameMaterial"
    }
  ]
}
