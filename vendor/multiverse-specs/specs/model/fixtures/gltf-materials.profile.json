{
  "default": {},
  "pbr": {
    "name": "Tinted terrain",
    "pbrMetallicRoughness": {
      "baseColorFactor": [0, 0.25, 1, 0],
      "baseColorTexture": {
        "index": 0,
        "texCoord": 1,
        "extensions": {
          "KHR_texture_transform": { "offset": [-0.5, -0.5], "scale": [2, 2], "rotation": 0 }
        }
      },
      "metallicFactor": 0,
      "roughnessFactor": 1
    },
    "alphaMode": "MASK",
    "alphaCutoff": 0.4,
    "doubleSided": true
  },
  "normalOcclusion": {
    "normalTexture": { "index": 1, "scale": -2, "extensions": { "KHR_texture_transform": { "rotation": 0.5 } } },
    "occlusionTexture": { "index": 2, "strength": 0.75 }
  },
  "specularHdr": {
    "extensions": {
      "KHR_materials_specular": {
        "specularFactor": 0.5,
        "specularTexture": { "index": 3 },
        "specularColorFactor": [1.5, 2, 0.25],
        "specularColorTexture": { "index": 4 }
      }
    }
  },
  "zeroUvScale": {
    "emissiveTexture": { "index": 0, "extensions": { "KHR_texture_transform": { "scale": [0, 0], "texCoord": 1 } } }
  },
  "opaqueExtension": { "extensions": { "UV_vendor_example": { "value": 1 } } },
  "invalidColorLength": { "pbrMetallicRoughness": { "baseColorFactor": [1, 1, 1] } },
  "invalidColorRange": { "pbrMetallicRoughness": { "baseColorFactor": [1, 1.01, 1, 1] } },
  "invalidColorType": { "pbrMetallicRoughness": { "baseColorFactor": [1, "1", 1, 1] } },
  "invalidRoughness": { "pbrMetallicRoughness": { "roughnessFactor": 1.01 } },
  "invalidMetallic": { "pbrMetallicRoughness": { "metallicFactor": -0.1 } },
  "invalidTextureIndex": { "normalTexture": { "index": -1 } },
  "invalidTexCoord": { "normalTexture": { "index": 0, "texCoord": 0.5 } },
  "invalidTextureField": { "normalTexture": { "index": 0, "strength": 0.5 } },
  "invalidNormalScale": { "normalTexture": { "index": 0, "scale": "1" } },
  "invalidOcclusionStrength": { "occlusionTexture": { "index": 0, "strength": 2 } },
  "invalidTransform": { "normalTexture": { "index": 0, "extensions": { "KHR_texture_transform": { "offset": [0] } } } },
  "invalidTransformCoord": { "normalTexture": { "index": 0, "extensions": { "KHR_texture_transform": { "texCoord": -1 } } } },
  "invalidAlphaMode": { "alphaMode": "TRANSPARENT" },
  "invalidAlphaDependency": { "alphaCutoff": 0.5 },
  "invalidSpecularStrength": { "extensions": { "KHR_materials_specular": { "specularFactor": 2 } } },
  "invalidSpecularColor": { "extensions": { "KHR_materials_specular": { "specularColorFactor": [-1, 1, 1] } } },
  "invalidLegacyField": { "baseColorResourceId": "grass-image" }
}
